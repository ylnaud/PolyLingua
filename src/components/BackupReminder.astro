---
import DismissibleBar from './DismissibleBar.astro';

// La cáscara (markup y CSS) es de DismissibleBar; acá vive solo lo propio de
// este aviso: cuándo aparece. El texto es fijo, así que va como prop.
---

<DismissibleBar
  id="backup"
  emoji="💾"
  text="Tu progreso vive solo en este navegador — hacé una copia antes de perderlo."
  ctaLabel="Hacer copia"
  ctaHref="/logros#backup"
/>

<script>
  import { addDays, countCompletedLessons, read, today, write } from '../lib/storage';

  // No tiene sentido avisar con 0-2 lecciones — recién ahí hay progreso real
  // que valga la pena perder. Si ya exportó una vez no se le vuelve a
  // insistir (el propio botón de exportar guarda esa fecha). Si lo cierra
  // sin exportar, vuelve a aparecer a los 14 días — un recordatorio
  // insistente pero no diario, distinto del de racha que sí es diario.
  const MIN_LESSONS = 3;
  const SNOOZE_DAYS = 14;

  function alreadyExported(): boolean {
    return !!read('polylingua-backup-exported-at');
  }

  function dismissedRecently(): boolean {
    const dismissed = read('polylingua-backup-reminder-dismissed-at');
    if (!dismissed) return false;
    return today() < addDays(dismissed, SNOOZE_DAYS);
  }

  function shouldShow(): boolean {
    if (alreadyExported() || dismissedRecently()) return false;
    return countCompletedLessons() >= MIN_LESSONS;
  }

  function initBackupReminder() {
    const el = document.querySelector<HTMLElement>('[data-bar="backup"]');
    const dismissBtn = el?.querySelector<HTMLButtonElement>('[data-bar-dismiss]');
    if (!el || !dismissBtn) return;

    el.hidden = !shouldShow();

    if (!dismissBtn.dataset.initialized) {
      dismissBtn.dataset.initialized = 'true';
      dismissBtn.addEventListener('click', () => {
        write('polylingua-backup-reminder-dismissed-at', today());
        el.hidden = true;
      });
    }
  }

  initBackupReminder();
  document.addEventListener('astro:page-load', initBackupReminder);
</script>
