---
import InstallPrompt from './InstallPrompt.astro';
import SoundToggle from './SoundToggle.astro';
import ShadowingToggle from './ShadowingToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { getDictionary } from '../i18n';

const path = Astro.url.pathname;

const isActive = (route: string) =>
  route === '/' ? path === '/' : path === route || path.startsWith(`${route}/`);

const navLangMatch = path.match(/^\/(?:idiomas|[a-z]{2})\/(de|en|fr|it|pt)/);
const navLang = navLangMatch?.[1];
const defaultUserLangHref = `/${ACTIVE_USER_LANGUAGES[0].id}`;
const t = getDictionary(ACTIVE_USER_LANGUAGES[0].id);

const tabs = [
  { href: '/', icon: '🏠', label: t.bottomNav.tabs.inicio },
  { href: defaultUserLangHref, icon: '📚', label: t.bottomNav.tabs.idiomas },
  { href: '/repasar', icon: '🔁', label: t.bottomNav.tabs.repasar, reload: true },
  { href: '/logros', icon: '🏆', label: t.bottomNav.tabs.logros },
];
---

<nav class="bottom-nav" aria-label={t.bottomNav.navAria}>
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        class={isActive(tab.href) ? 'nav-item active' : 'nav-item'}
        aria-current={isActive(tab.href) ? 'page' : undefined}
        data-astro-reload={tab.reload ? true : undefined}
      >
        <span class="ico" aria-hidden="true">
          {tab.icon}
        </span>
        <span class="label">{tab.label}</span>
      </a>
    ))
  }
  <button
    type="button"
    class="nav-item more-btn"
    id="more-btn"
    aria-haspopup="dialog"
    aria-controls="more-sheet"
    aria-expanded="false"
  >
    <span class="ico" aria-hidden="true">☰</span>
    <span class="label">{t.bottomNav.tabs.mas}</span>
  </button>
</nav>

<dialog id="more-sheet" aria-label={t.bottomNav.sheetAria}>
  <div class="sheet-handle" aria-hidden="true"><span class="sheet-handle-bar"></span></div>

  <div class="sheet-body">
    <div class="sheet-group">
      <p class="sheet-group-label">{t.bottomNav.groups.practicar}</p>
      <div class="sheet-group-links">
        <a href="/buscar" class="sheet-link"><span class="sheet-icon" aria-hidden="true">🔎</span>{t.bottomNav.links.buscarLecciones}</a>
        <a href="/situaciones" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">🗺️</span>{t.bottomNav.links.situaciones}</a>
        <a href="/dialogos" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">💬</span>{t.bottomNav.links.dialogos}</a>
        <a href="/vocabulario" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">📖</span>{t.bottomNav.links.vocabulario}</a>
        <a href="/practica-libre" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">🎲</span>{t.bottomNav.links.practicaLibre}</a>
        <a href="/ahorcado" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">🔤</span>{t.bottomNav.links.ahorcado}</a>
        <a href="/pronunciacion" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">🗣️</span>{t.bottomNav.links.escucharRepetir}</a>
        <a href="/generador-frases" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">🧩</span>{t.bottomNav.links.generadorFrases}</a>
      </div>
    </div>

    <div class="sheet-group">
      <p class="sheet-group-label">{t.bottomNav.groups.tuProgreso}</p>
      <div class="sheet-group-links">
        <a href={navLang ? `/idiomas/${navLang}/mis-errores` : defaultUserLangHref} data-sheet-errors class="sheet-link sheet-lang-link" hidden={!navLang}><span class="sheet-icon" aria-hidden="true">❌</span>{t.bottomNav.links.misErrores}</a>
        <a href={navLang ? `/idiomas/${navLang}/gramatica` : defaultUserLangHref} data-sheet-grammar class="sheet-link sheet-lang-link" hidden={!navLang}><span class="sheet-icon" aria-hidden="true">📝</span>{t.bottomNav.links.gramatica}</a>
        <a href="/logros#backup" class="sheet-link"><span class="sheet-icon" aria-hidden="true">💾</span>{t.bottomNav.links.copiaSeguridad}</a>
      </div>
    </div>

    <div class="sheet-group">
      <p class="sheet-group-label">{t.bottomNav.groups.recursos}</p>
      <div class="sheet-group-links">
        <a href="/recursos" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">📻</span>{t.bottomNav.links.recursos}</a>
        <a href="/diario" data-astro-reload class="sheet-link"><span class="sheet-icon" aria-hidden="true">✍️</span>{t.bottomNav.links.diario}</a>
        <a href="/blog" class="sheet-link"><span class="sheet-icon" aria-hidden="true">📰</span>{t.bottomNav.links.blog}</a>
      </div>
    </div>

    <div class="sheet-group">
      <p class="sheet-group-label">{t.bottomNav.groups.sobrePolyLingua}</p>
      <div class="sheet-group-links">
        <a href="/#por-que" class="sheet-link"><span class="sheet-icon" aria-hidden="true">💡</span>{t.bottomNav.links.porQuePolyLingua}</a>
        <a href="/#faq" class="sheet-link"><span class="sheet-icon" aria-hidden="true">❓</span>{t.bottomNav.links.faq}</a>
      </div>
    </div>

    <div class="sheet-group">
      <p class="sheet-group-label">{t.bottomNav.groups.preferencias}</p>
      <div class="sheet-group-links">
        <InstallPrompt variant="sheet" />
        <ShadowingToggle variant="sheet" />
        <SoundToggle variant="sheet" />
        <ThemeToggle variant="sheet" />
      </div>
    </div>
  </div>

  <div class="sheet-footer">
    <a href={defaultUserLangHref} class="sheet-link cta">{t.bottomNav.ctaStart}</a>
  </div>
</dialog>

<style>
  .bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: calc(var(--bottom-nav-h) + var(--bottom-nav-gap));
    padding-bottom: var(--bottom-nav-gap);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border);
    align-items: stretch;
    justify-content: space-around;
  }

  @media (max-width: 720px) {
    .bottom-nav {
      display: flex;
    }
  }

  .nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-height: 44px;
    background: none;
    border: none;
    color: var(--text-muted);
    text-decoration: none;
    font-family: inherit;
    cursor: pointer;
  }

  .nav-item .ico {
    font-size: 1.2rem;
    line-height: 1;
  }

  .nav-item .label {
    font-size: 0.65rem;
    font-weight: 700;
  }

  .nav-item.active {
    color: var(--accent-text);
  }

  #more-sheet {
    margin: 0;
    inset: auto 0 calc(var(--bottom-nav-h) + var(--bottom-nav-gap)) 0;
    width: 100%;
    max-width: none;
    max-height: min(75vh, 620px);
    border: none;
    border-top: 1px solid var(--border);
    border-radius: var(--radius) var(--radius) 0 0;
    padding: 0;
    background: var(--bg-card);
    color: var(--text);
    overflow: hidden;
  }

  #more-sheet[open] {
    display: flex;
    flex-direction: column;
  }

  #more-sheet::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .sheet-handle {
    display: flex;
    justify-content: center;
    flex: 0 0 auto;
    padding: 0.55rem 0 0.35rem;
  }

  .sheet-handle-bar {
    width: 36px;
    height: 4px;
    border-radius: 999px;
    background: var(--border);
  }

  .sheet-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 0.1rem 0.75rem 0.5rem;
  }

  .sheet-group + .sheet-group {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .sheet-group-label {
    margin: 0 0 0.2rem;
    padding: 0 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }

  .sheet-group-links {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .sheet-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
  }

  .sheet-link:hover {
    background: var(--bg-elevated);
  }

  .sheet-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    margin-right: 0.65rem;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .sheet-footer {
    flex: 0 0 auto;
    padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--border);
    background: var(--bg-card);
  }

  .sheet-link.cta {
    justify-content: center;
    margin: 0;
    background: var(--accent);
    color: var(--de-black);
    font-weight: 700;
  }
</style>

<script>
  function initBottomNav() {
    const btn = document.getElementById('more-btn');
    const dialog = document.getElementById('more-sheet') as HTMLDialogElement | null;
    if (!btn || !dialog) return;

    if (!btn.dataset.initialized) {
      btn.dataset.initialized = 'true';
      btn.addEventListener('click', () => {
        dialog.showModal();
        btn.setAttribute('aria-expanded', 'true');
      });
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => {
        btn.setAttribute('aria-expanded', 'false');
      });
    }

    const langMatch = location.pathname.match(/^\/(?:idiomas|[a-z]{2})\/(de|en|fr|it|pt)/);
    const errLink = dialog.querySelector('[data-sheet-errors]') as HTMLAnchorElement | null;
    const gramLink = dialog.querySelector('[data-sheet-grammar]') as HTMLAnchorElement | null;
    if (langMatch) {
      const lang = langMatch[1];
      if (errLink) {
        errLink.href = `/idiomas/${lang}/mis-errores`;
        errLink.hidden = false;
      }
      if (gramLink) {
        gramLink.href = `/idiomas/${lang}/gramatica`;
        gramLink.hidden = false;
      }
    } else {
      if (errLink) errLink.hidden = true;
      if (gramLink) gramLink.hidden = true;
    }
  }

  initBottomNav();
  document.addEventListener('astro:page-load', initBottomNav);
</script>
