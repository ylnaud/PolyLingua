---
import SpeakButton from './SpeakButton.astro';

interface DialogueLine {
  speaker: string;
  text: string;
  es: string;
}

interface Props {
  dialogue: DialogueLine[];
  lang: string;
}

const { dialogue, lang } = Astro.props;
---

<div class="dialogue-card card" data-lang={lang}>
  <span class="eyebrow">🗣️ Diálogo</span>
  <ul class="dialogue-list">
    {
      dialogue.map((line, i) => (
        <li class={`dialogue-line ${i % 2 === 0 ? 'speaker-a' : 'speaker-b'}`}>
          <span class="speaker">{line.speaker}</span>
          <div class="line-content">
            <p class="line-text">{line.text}</p>
            <p class="line-es">{line.es}</p>
          </div>
          <SpeakButton text={line.text} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .dialogue-card {
    margin: 1.75rem 0;
    padding: 1.1rem 1.25rem;
  }

  .dialogue-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .dialogue-line {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--border);
  }

  .dialogue-line:first-child {
    padding-top: 0;
    border-top: none;
  }

  .speaker {
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    min-width: 5rem;
    text-align: center;
    margin-top: 0.15rem;
  }

  .speaker-a .speaker {
    background: var(--accent);
    color: var(--de-black, #000);
  }

  .speaker-b .speaker {
    background: var(--border);
    color: var(--text);
  }

  .line-content {
    flex: 1;
    min-width: 0;
  }

  .line-text {
    font-weight: 700;
    font-size: 1.05rem;
    margin: 0;
  }

  .line-es {
    color: var(--text-muted);
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
  }

  @media (max-width: 560px) {
    .speaker {
      min-width: auto;
      font-size: 0.7rem;
    }
  }
</style>
