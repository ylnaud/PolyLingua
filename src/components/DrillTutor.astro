---
// Casi todo el componente es comportamiento; el frontmatter existe solo para
// resolver sus dos textos en el idioma de la página. Se monta una vez en
// BaseLayout, junto a EngineTracker.
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { SPANISH_GLOSS_USER_LANG } from '../lib/courses';
import { getDictionary } from '../i18n';

interface Props {
  userLang?: string;
}

const { userLang } = Astro.props;
const pageLang = userLang ?? ACTIVE_USER_LANGUAGES[0].id;
const t = getDictionary(pageLang as never).widgets.refuerzo;

// El bucle de refuerzo solo se abre donde sus plantillas están escritas.
//
// REPAIR_TEMPLATES (src/lib/engine/exerciseGenerator.ts) guarda la
// `explanation` y la `translation` de cada variación en UN solo idioma, el
// español, indexadas por skillId —que lleva el idioma META, no el de
// interfaz—. Así que la misma plantilla sirve a es-de y a en-de, y en una
// lección inglesa el aviso salía en castellano: «💡 Presente regular: se quita
// el -en del infinitivo…». Y no tras fallar repetido, sino al PRIMER fallo,
// que es cuando se abre el bucle.
//
// Sin equivalente inglés no hay nada que mostrar, así que no se muestra nada:
// la lección se comporta como antes de etiquetar en-de. Es la misma decisión
// que toma tsaFor() en src/data/tsa.ts —devolver null en vez de caer al
// castellano— y por el mismo motivo: media página en otro idioma es peor que
// media función de menos. Cuando existan las plantillas inglesas, este flag se
// deriva de eso y el bucle vuelve solo.
const conPlantillas = pageLang === SPANISH_GLOSS_USER_LANG;
---

{
  /* Los avisos los escribe el <script> sobre el ítem fallado, así que sus
     textos viajan por data-* — el patrón del proyecto para pasarle datos del
     servidor al JS de cliente. Comentario de Astro, no HTML: uno de HTML se
     publicaría en las 1042 páginas. */
}
<span hidden data-drill-strings={JSON.stringify(t)} data-drill-enabled={String(conPlantillas)}
></span>

<style is:global>
  /* Estilos globales, no scoped: estos nodos los crea el JS y por eso nunca
     llevan el atributo [data-astro-cid-*] que Astro añade en el build. Con
     estilos scoped no les aplicaría ninguna regla. */
  .drill-tip {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: 0.9rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-sm, 8px);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    background: var(--bg-elevated);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .drill-tip-icon {
    flex: none;
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .drill-tip strong {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .drill-tip.is-done {
    border-left-color: var(--success, #2e7d32);
  }

  .drill-tip.is-paused {
    border-left-color: var(--text-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .drill-tip {
      animation: drill-tip-in 0.25s ease-out;
    }

    @keyframes drill-tip-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
    }
  }
</style>

<script>
  /** Los dos textos del tutor, puestos por el servidor en [data-drill-strings]. */
  function textos(): { pausado: string; otraVez: string } {
    const el = document.querySelector<HTMLElement>('[data-drill-strings]');
    try {
      return JSON.parse(el?.dataset.drillStrings ?? '{}');
    } catch {
      return { pausado: '', otraVez: '' };
    }
  }

  /**
   * El tutor: cuando fallás, insiste en el momento.
   *
   * Antes, fallar dentro de una lección solo dejaba una explicación y pasaba al
   * ejercicio siguiente; para volver sobre el tema había que ir a /practicar y
   * acumular cinco fallos del mismo patrón en sesiones distintas. Esto lo
   * arregla en el momento exacto en que el patrón está fresco.
   *
   * Cómo se engancha: escucha `practice-item-answered` y responde con
   * `practice-insert-items`. No toca `Practice.astro` por dentro —misma forma
   * que EngineTracker— así que una lección sin habilidades, o con una habilidad
   * sin plantilla, se comporta exactamente como antes.
   *
   * Los tres números, y por qué:
   *
   * - **3 aciertos seguidos** para salir. Uno solo puede ser suerte; tres
   *   seguidos en frases distintas ya no.
   * - **6 ejercicios insertados** como tope. Sin tope, un mal día te deja
   *   encerrado en un tema y la lección no termina nunca. Al llegar, el bucle
   *   se rinde y deja el tema para /practicar, donde el motor lo va a seguir
   *   priorizando: el fallo ya quedó registrado.
   * - **Por habilidad y por sesión**: fallar dos temas distintos abre dos
   *   bucles independientes, y ninguno se arrastra a la lección siguiente.
   */
  import { SKILL_MAP } from '../data/skills';
  import { repairTemplateFor, toRepairExercise } from '../lib/engine/exerciseGenerator';
  import { skillsForItem, declareItemSkills } from '../lib/itemSkills';

  const ACIERTOS_PARA_SALIR = 3;
  const MAX_INSERTADOS = 6;

  interface Bucle {
    /** Si el bucle está abierto ahora mismo. Cerrado no se borra: `insertados`
     *  tiene que sobrevivir, o al siguiente fallo el tope volvería a cero y el
     *  bucle se reabriría sin fin. */
    activo: boolean;
    racha: number;
    insertados: number;
    /** Índices de variación ya usados: se insiste con el patrón, no con la
     *  misma frase. */
    usados: number[];
  }

  const bucles = new Map<string, Bucle>();

  /**
   * La habilidad que se va a reforzar por este ítem.
   *
   * De todas las que ejercita, la primera que tenga plantilla de refuerzo: sin
   * plantilla no hay con qué insistir, y proponer un ejercicio de otro tema
   * sería peor que no hacer nada. Hoy tienen plantilla las de gramática y orden
   * de palabras de A1 alemán; el resto simplemente no abre bucle.
   */
  /** ¿Hay plantillas en el idioma de esta página? Lo decide el servidor. */
  function bucleDisponible(): boolean {
    const el = document.querySelector<HTMLElement>('[data-drill-enabled]');
    return el?.dataset.drillEnabled === 'true';
  }

  function habilidadReforzable(itemId: string): string | null {
    // Sin plantillas en el idioma de la página no se abre bucle: mostrar la
    // explicación española en una lección inglesa es peor que no reforzar.
    // Ver el comentario del frontmatter.
    if (!bucleDisponible()) return null;
    const conPlantilla = skillsForItem(itemId).filter(
      (id) => SKILL_MAP[id] && repairTemplateFor(id),
    );
    return conPlantilla[0] ?? null;
  }

  function tip(item: HTMLElement, texto: string, icono: string, variante = '') {
    // Se quita el anterior: durante un bucle el ítem cambia, pero si el mismo
    // ítem recibiera dos avisos se apilarían.
    item.querySelector('.drill-tip')?.remove();
    const caja = document.createElement('aside');
    caja.className = variante ? `drill-tip ${variante}` : 'drill-tip';
    const ico = document.createElement('span');
    ico.className = 'drill-tip-icon';
    ico.setAttribute('aria-hidden', 'true');
    ico.textContent = icono;
    const cuerpo = document.createElement('p');
    cuerpo.textContent = texto;
    caja.append(ico, cuerpo);
    // Antes del botón "Siguiente", para que se lea antes de avanzar.
    const next = item.querySelector('[data-next]');
    if (next) next.before(caja);
    else item.appendChild(caja);
  }

  /** Inserta UNA variación nueva del patrón. Devuelve si pudo. */
  function insertarRefuerzo(root: HTMLElement, skillId: string, bucle: Bucle): boolean {
    const skill = SKILL_MAP[skillId];
    const plantilla = repairTemplateFor(skillId);
    if (!skill || !plantilla) return false;

    const libres = plantilla.variations.map((_, i) => i).filter((i) => !bucle.usados.includes(i));
    if (libres.length === 0) return false;

    const indice = libres[Math.floor(Math.random() * libres.length)];
    bucle.usados.push(indice);
    const ejercicio = toRepairExercise(skill, plantilla, plantilla.variations[indice], indice);
    const id = `drill::${skillId}::${indice}::${bucle.insertados}`;

    // Se declara la habilidad del ítem para que EngineTracker cuente el
    // resultado en la que se está reforzando y no en todas las de la lección.
    declareItemSkills(id, [skillId]);

    root.dispatchEvent(
      new CustomEvent('practice-insert-items', {
        detail: {
          items: [
            { id, kind: ejercicio.render?.kind ?? 'fill-blank', data: ejercicio.render?.data },
          ],
        },
      }),
    );
    bucle.insertados += 1;
    return true;
  }

  function onAnswered(detail: any) {
    const root: HTMLElement | undefined = detail?.root;
    const itemId: string = detail?.itemId ?? '';
    if (!root) return;

    const skillId = habilidadReforzable(itemId);
    if (!skillId) return;

    const item = root.querySelector<HTMLElement>(`[data-item-id="${CSS.escape(itemId)}"]`);
    const bucle = bucles.get(skillId) ?? { activo: false, racha: 0, insertados: 0, usados: [] };
    bucles.set(skillId, bucle);

    if (detail.correct) {
      if (!bucle.activo) return;
      bucle.racha += 1;
      if (bucle.racha >= ACIERTOS_PARA_SALIR) {
        bucle.activo = false;
        if (item) {
          tip(
            item,
            `Tres seguidos con ${SKILL_MAP[skillId].name.toLowerCase()}. Tema dominado: seguimos con la lección.`,
            '✅',
            'is-done',
          );
        }
      }
      return;
    }

    // Fallo.
    const estabaAbierto = bucle.activo;
    bucle.racha = 0;

    // El tope es por habilidad y por sesión, no por bucle: si se reiniciara al
    // cerrar, fallar de nuevo abriría otro bucle y el tema no terminaría nunca.
    if (bucle.insertados >= MAX_INSERTADOS) {
      if (!estabaAbierto) return; // ya se avisó; no se repite el aviso
      // Se rinde, no se ensaña. El error ya quedó registrado por
      // EngineTracker, así que /practicar va a seguir priorizando el tema.
      bucle.activo = false;
      if (item) {
        tip(item, textos().pausado, '🌱', 'is-paused');
      }
      return;
    }

    if (!insertarRefuerzo(root, skillId, bucle)) {
      // Sin variaciones libres no hay con qué insistir: se cierra en silencio.
      bucle.activo = false;
      bucle.insertados = MAX_INSERTADOS;
      return;
    }
    bucle.activo = true;

    if (item) {
      const plantilla = repairTemplateFor(skillId);
      tip(
        item,
        estabaAbierto ? textos().otraVez : (plantilla?.explanation ?? ''),
        estabaAbierto ? '🔁' : '💡',
      );
    }
  }

  // Bandera de módulo, no de dataset del body: bajo navegación SPA el <body> se
  // reemplaza en cada navegación pero el listener de document persiste. Mismo
  // motivo que en EngineTracker y ProgressTracker.
  let started = false;

  function initDrillTutor() {
    if (!started) {
      started = true;
      document.addEventListener('practice-item-answered', ((e: CustomEvent) => {
        onAnswered(e.detail);
      }) as EventListener);
    }
    // Los bucles son por sesión de práctica: al cambiar de página se olvidan.
    bucles.clear();
  }

  initDrillTutor();
  document.addEventListener('astro:page-load', initDrillTutor);
</script>
