---
import { LANGUAGE_MAP } from '../data/languages';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { getTargetLangsFor } from '../lib/courses';
import { getDictionary } from '../i18n';

interface Props {
  userLang?: string;
}

// El footer se renderiza en TODAS las páginas, incluidas las de un silo
// con idioma de interfaz distinto al principal. Antes tenía los links
// hardcodeados a /es/<lang>, así que un usuario navegando en /de/... veía
// un footer que lo expulsaba al silo español. Ahora respeta su silo.
const { userLang = ACTIVE_USER_LANGUAGES[0].id } = Astro.props;

// Solo se listan los cursos que EXISTEN para este idioma de interfaz: no
// todos los userLang tienen los mismos targets (es-* tiene 5, en-* solo
// en-de). El cálculo vive en src/lib/courses.ts, que lo resuelve una vez
// por build — hacerlo acá lo repetiría en las ~1300 páginas del sitio.
const targetLangs = getTargetLangsFor(userLang);

const dict = getDictionary(userLang as never);
const t = dict.footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container foot-grid">
    <div>
      <p class="foot-logo">PolyLingua</p>
      <p class="foot-tagline">{t.tagline}</p>
    </div>
    <div>
      <h2>{t.idiomas}</h2>
      <ul>
        {
          targetLangs.map((id) => (
            <li>
              <a href={`/${userLang}/${id}`}>
                {LANGUAGE_MAP[id].flag} {dict.languageNames[id]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2>{t.proyecto}</h2>
      <ul>
        <li>
          <a href="https://github.com/ylnaud/polylingua" rel="noopener">{t.codigoGitHub}</a>
        </li>
        <li><a href="/blog">{t.blog}</a></li>
        <li><a href="/#faq">{t.faq}</a></li>
        <li><a href="/acerca">{t.acercaDe}</a></li>
        <li><a href="/terminos">{t.terminos}</a></li>
        <li><a href="/privacidad">{t.privacidad}</a></li>
      </ul>
    </div>
  </div>
  <div class="container foot-bottom">
    <p>© {year} PolyLingua. {t.hechoCon}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding-block: 3rem 1.5rem;
    background: var(--bg-elevated);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
  }

  .foot-logo {
    font-weight: 800;
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }

  .foot-tagline {
    color: var(--text-muted);
    max-width: 32ch;
    margin: 0;
  }

  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  ul a {
    text-decoration: none;
    color: var(--text);
    font-size: 0.95rem;
  }

  ul a:hover {
    color: var(--accent-text);
  }

  .foot-bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .foot-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
