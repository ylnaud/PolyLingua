---
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import InstallPrompt from './InstallPrompt.astro';
import DailyGoal from './DailyGoal.astro';
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="PolyLingua — inicio">
      <span class="logo-mark" aria-hidden="true">🌐</span>
      <span class="logo-text">PolyLingua</span>
    </a>
    <nav class="nav-desktop" aria-label="Navegación principal">
      <a href="/idiomas">Idiomas</a>
      <a href="/blog">Blog</a>
      <a href="/#por-que">Por qué PolyLingua</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <div class="actions">
      <DailyGoal />
      <a class="btn-pill" href="/repasar" data-astro-reload aria-label="Repasar palabras falladas">📚 Repasar</a>
      <a class="btn-pill" href="/practica-libre" data-astro-reload aria-label="Práctica libre aleatoria">🎲 Práctica libre</a>
      <a class="btn-pill" href="/logros" aria-label="Ver tus logros">🏆 Logros</a>
      <InstallPrompt />
      <SoundToggle />
      <ThemeToggle />
      <a class="btn btn-primary cta" href="/idiomas">Empezar gratis</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    gap: 1rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: linear-gradient(135deg, #2f8fce 0%, var(--de-red) 55%, var(--accent) 100%);
    font-size: 1.1rem;
  }

  .nav-desktop {
    display: flex;
    gap: 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  nav a {
    text-decoration: none;
    color: var(--text-muted);
  }

  nav a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.6rem;
    row-gap: 0.4rem;
  }

  .btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
    min-height: 44px;
  }

  .btn-pill:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .cta {
    padding: 0.55rem 1.1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .nav-desktop {
      display: none;
    }

    .cta {
      display: none;
    }

    .actions .btn-pill {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .actions :global(.install-btn) {
      display: none;
    }
  }
</style>

