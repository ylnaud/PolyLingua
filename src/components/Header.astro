---
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import InstallPrompt from './InstallPrompt.astro';
import DailyGoal from './DailyGoal.astro';
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="PolyLingua — inicio">
      <span class="logo-mark" aria-hidden="true">🌐</span>
      <span class="logo-text">PolyLingua</span>
    </a>
    <nav class="nav-desktop" aria-label="Navegación principal">
      <a href="/idiomas">Idiomas</a>
      <a href="/blog">Blog</a>
      <a href="/#por-que">Por qué PolyLingua</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <div class="actions">
      <DailyGoal />
      <a class="btn-pill" href="/repasar" aria-label="Repasar palabras falladas">📚 Repasar</a>
      <a class="btn-pill" href="/practica-libre" aria-label="Práctica libre aleatoria">🎲 Práctica libre</a>
      <a class="btn-pill" href="/logros" aria-label="Ver tus logros">🏆 Logros</a>
      <InstallPrompt />
      <SoundToggle />
      <ThemeToggle />
      <a class="btn btn-primary cta" href="/idiomas">Empezar gratis</a>
      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú de navegación"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="nav-mobile" aria-label="Navegación móvil" hidden>
    <a href="/idiomas">Idiomas</a>
    <a href="/blog">Blog</a>
    <a href="/#por-que">Por qué PolyLingua</a>
    <a href="/#faq">FAQ</a>
    <a href="/repasar">📚 Repasar</a>
    <a href="/practica-libre">🎲 Práctica libre</a>
    <a href="/logros">🏆 Logros</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    gap: 1rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: linear-gradient(135deg, #2f8fce 0%, var(--de-red) 55%, var(--accent) 100%);
    font-size: 1.1rem;
  }

  .nav-desktop {
    display: flex;
    gap: 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  nav a {
    text-decoration: none;
    color: var(--text-muted);
  }

  nav a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
    min-height: 44px;
  }

  .btn-pill:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .cta {
    padding: 0.55rem 1.1rem;
    font-size: 0.9rem;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1.2rem;
    cursor: pointer;
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 1.25rem 1rem;
    border-top: 1px solid var(--border);
  }

  .nav-mobile a {
    padding: 0.7rem 0.25rem;
    font-weight: 600;
  }

  .nav-mobile:not([hidden]) {
    display: flex;
  }

  @media (max-width: 720px) {
    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: grid;
      place-items: center;
    }

    .cta {
      display: none;
    }

    .actions .btn-pill {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .actions :global(.install-btn) {
      display: none;
    }
  }
</style>

<script>
  function initMenuToggle() {
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav || btn.dataset.initialized) return;
    btn.dataset.initialized = 'true';

    btn.addEventListener('click', () => {
      const isOpen = !nav.hidden;
      nav.hidden = isOpen;
      btn.setAttribute('aria-expanded', String(!isOpen));
      btn.setAttribute(
        'aria-label',
        isOpen ? 'Abrir menú de navegación' : 'Cerrar menú de navegación'
      );
    });
  }

  initMenuToggle();
  document.addEventListener('astro:page-load', initMenuToggle);
</script>
