---
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import ShadowingToggle from './ShadowingToggle.astro';
import InstallPrompt from './InstallPrompt.astro';
import DailyGoal from './DailyGoal.astro';
import LanguageSelector from './LanguageSelector.astro';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { getDictionary } from '../i18n';
import { parseSiloPath } from '../lib/siloPath';

const headerLang = parseSiloPath(Astro.url.pathname).targetLang;
interface Props {
  userLang?: string;
}

// Recibe el userLang de la página en vez de forzar el idioma principal: si
// no, un usuario navegando en /de/... veía la navegación en español.
const { userLang = ACTIVE_USER_LANGUAGES[0].id } = Astro.props;
const t = getDictionary(userLang as never);
// Las herramientas viven dentro del silo del usuario, no en la raíz: un
// usuario navegando en /de/… tiene que ir a /de/repasar, no a /es/repasar.
const siloHref = `/${userLang}`;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label={t.header.logoAria}>
      <span class="logo-mark" aria-hidden="true">🌐</span>
      <span class="logo-text">PolyLingua</span>
    </a>
    <nav class="nav-desktop" aria-label={t.header.navAria}>
      <a href={siloHref}>{t.header.nav.idiomas}</a>
      <a href="/buscar">{t.header.nav.buscar}</a>
      <a href="/blog">{t.header.nav.blog}</a>
      <a href="/#por-que">{t.header.nav.porQue}</a>
      <a href="/#faq">{t.header.nav.faq}</a>
    </nav>
    <div class="actions">
      <LanguageSelector />
      <DailyGoal />
      <details class="tools-menu">
        <summary class="tools-trigger" aria-label={t.header.toolsAria}>
          <span aria-hidden="true">🧰</span>
        </summary>
        <div class="tools-panel">
          <a
            class="tools-link"
            href={`${siloHref}/repasar`}
            data-astro-reload
            aria-label={t.header.tools.repasarAria}>📚 {t.header.tools.repasar}</a
          >
          <a
            class="tools-link"
            href={`${siloHref}/vocabulario`}
            data-astro-reload
            aria-label={t.header.tools.vocabularioAria}>📖 {t.header.tools.vocabulario}</a
          >
          <a
            class="tools-link"
            href={`${siloHref}/practica-libre`}
            data-astro-reload
            aria-label={t.header.tools.practicaLibreAria}>🎲 {t.header.tools.practicaLibre}</a
          >
          <a
            class="tools-link"
            href={`${siloHref}/ahorcado`}
            data-astro-reload
            aria-label={t.header.tools.ahorcadoAria}>🔤 {t.header.tools.ahorcado}</a
          >
          <a class="tools-link" href="/logros" aria-label={t.header.tools.logrosAria}
            >🏆 {t.header.tools.logros}</a
          >
          <a
            class="tools-link"
            href={headerLang ? `${siloHref}/${headerLang}/mis-errores` : siloHref}
            data-header-errors
            hidden={!headerLang}
            aria-label={t.header.tools.misErroresAria}>❌ {t.header.tools.misErrores}</a
          >
          <ShadowingToggle variant="sheet" />
          <InstallPrompt variant="sheet" />
        </div>
      </details>
      <SoundToggle />
      <ThemeToggle />
      <a class="btn btn-primary cta" href={siloHref}>{t.header.ctaStart}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    gap: 1rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: linear-gradient(135deg, #2f8fce 0%, var(--de-red) 55%, var(--accent) 100%);
    font-size: 1.1rem;
  }

  .nav-desktop {
    display: flex;
    gap: 1rem;
    font-weight: 600;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  nav a {
    text-decoration: none;
    color: var(--text-muted);
  }

  nav a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    row-gap: 0.4rem;
  }

  .btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
    min-height: 44px;
  }

  .btn-pill:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .cta {
    padding: 0.55rem 1.1rem;
    font-size: 0.9rem;
  }

  .tools-menu {
    position: relative;
  }

  .tools-trigger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    list-style: none;
  }

  .tools-trigger::-webkit-details-marker {
    display: none;
  }

  .tools-trigger::marker {
    content: '';
  }

  .tools-trigger:hover {
    border-color: var(--accent);
  }

  .tools-menu[open] .tools-trigger {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .tools-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 220px;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow-card-hover);
  }

  .tools-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .tools-link:hover {
    background: var(--bg-elevated);
  }

  @media (max-width: 720px) {
    .nav-desktop {
      display: none;
    }

    .cta {
      display: none;
    }

    .actions .tools-menu {
      display: none;
    }

    .actions :global(.sound-toggle),
    .actions :global(.theme-toggle) {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .actions :global(.install-btn),
    .actions :global(.install-fallback) {
      display: none;
    }
  }
</style>

<script>
  import { parseSiloPath } from '../lib/siloPath';

  function initHeaderLangLinks() {
    const errLink = document.querySelector('[data-header-errors]') as HTMLAnchorElement | null;
    if (!errLink) return;
    const { userLang, targetLang } = parseSiloPath(location.pathname);
    if (userLang && targetLang) {
      errLink.href = `/${userLang}/${targetLang}/mis-errores`;
      errLink.hidden = false;
    } else {
      errLink.hidden = true;
    }
  }
  initHeaderLangLinks();
  document.addEventListener('astro:page-load', initHeaderLangLinks);

  function initToolsMenu() {
    const menu = document.querySelector('.tools-menu') as HTMLDetailsElement | null;
    if (!menu || menu.dataset.initialized) return;
    menu.dataset.initialized = 'true';

    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
  initToolsMenu();
  document.addEventListener('astro:page-load', initToolsMenu);
</script>
