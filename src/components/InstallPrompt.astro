---
<button
  type="button"
  class="install-btn"
  id="install-btn"
  hidden
  aria-label="Instalar PolyLingua como aplicación"
>
  📲 Instalar app
</button>

<style>
  .install-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }

  .install-btn:hover {
    border-color: var(--accent);
  }
</style>

<script>
  // Bandera de módulo para los listeners de window, que persisten entre
  // navegaciones — ver comentario equivalente en ProgressTracker.astro. El
  // botón en sí se recrea en cada navegación, así que su propio listener de
  // click sigue enganchándose por nav con el guard local de siempre.
  let installPromptStarted = false;
  let deferredPrompt: any = null;

  function initInstallPrompt() {
    const btn = document.getElementById('install-btn') as HTMLButtonElement | null;
    if (!btn) return;

    if (!installPromptStarted) {
      installPromptStarted = true;

      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        deferredPrompt = event;
        document.getElementById('install-btn')?.removeAttribute('hidden');
      });

      window.addEventListener('appinstalled', () => {
        const current = document.getElementById('install-btn') as HTMLButtonElement | null;
        if (current) current.hidden = true;
        deferredPrompt = null;
      });
    }

    if (btn.dataset.initialized) return;
    btn.dataset.initialized = 'true';
    btn.hidden = !deferredPrompt;

    btn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      await deferredPrompt.userChoice;
      deferredPrompt = null;
      btn.hidden = true;
    });
  }

  initInstallPrompt();
  document.addEventListener('astro:page-load', initInstallPrompt);
</script>
