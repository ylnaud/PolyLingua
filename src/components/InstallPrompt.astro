---
interface Props {
  // 'pill' es el botón compacto del header (desktop/landscape); 'sheet' es la
  // variante de fila completa para el menú "Más" del bottom nav (portrait) —
  // ambas comparten el mismo comportamiento vía la clase .install-btn, así
  // que en cualquier página con las dos instancias montadas (header + sheet)
  // se muestran/ocultan en simultáneo.
  variant?: 'pill' | 'sheet';
}

const { variant = 'pill' } = Astro.props;
---
<button
  type="button"
  class:list={['install-btn', { 'install-btn-sheet': variant === 'sheet' }]}
  hidden
  aria-label="Instalar PolyLingua como aplicación"
>
  📲 Instalar app
</button>
<span
  class:list={['install-fallback', { 'install-fallback-sheet': variant === 'sheet' }]}
  hidden
></span>

<style>
  .install-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }

  .install-btn:hover {
    border-color: var(--accent);
  }

  .install-btn-sheet {
    width: 100%;
    justify-content: flex-start;
    border: none;
    border-radius: 10px;
    background: none;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    font-size: 1rem;
  }

  .install-btn-sheet:hover {
    border-color: transparent;
    background: var(--bg-elevated);
  }

  .install-fallback {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    border-radius: 999px;
    border: 1px dashed var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    cursor: help;
  }

  .install-fallback-sheet {
    display: flex;
    width: 100%;
    align-items: center;
    border: none;
    border-radius: 10px;
    background: none;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.35;
    cursor: default;
  }

  .install-btn[hidden],
  .install-fallback[hidden] {
    display: none;
  }
</style>

<script>
  // Bandera de módulo para los listeners de window, que persisten entre
  // navegaciones — ver comentario equivalente en ProgressTracker.astro. Puede
  // haber más de un botón .install-btn montado a la vez (el del header y el
  // del menú "Más"), así que todo lo que toca visibilidad/estado opera sobre
  // querySelectorAll en vez de un único id, para que ambas instancias queden
  // siempre sincronizadas.
  let installPromptStarted = false;
  let deferredPrompt: any = null;
  let appInstalled = false;
  // beforeinstallprompt es exclusivo de navegadores Chromium y no siempre
  // dispara (nunca en Safari/iOS, y en Android viejo/heurísticas de
  // "engagement" no cumplidas tampoco) — si no aparece a los pocos segundos,
  // se reemplaza el botón por instrucciones manuales en vez de dejarlo
  // oculto para siempre sin ninguna alternativa.
  let fallbackReady = false;

  function allButtons(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>('.install-btn'));
  }

  function isStandalone(): boolean {
    return (
      window.matchMedia('(display-mode: standalone)').matches ||
      (navigator as any).standalone === true
    );
  }

  function fallbackCopy(): { full: string; short: string } {
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
    return isIOS
      ? {
          full: 'Tocá Compartir (□↑) y elegí "Agregar a pantalla de inicio".',
          short: '❓ Cómo instalar',
        }
      : {
          full: 'Tocá el menú (⋮) de tu navegador y elegí "Agregar a pantalla de inicio" o "Instalar aplicación".',
          short: '❓ Cómo instalar',
        };
  }

  function populateFallback(el: HTMLElement) {
    if (el.dataset.populated) return;
    el.dataset.populated = 'true';
    const { full, short } = fallbackCopy();
    if (el.classList.contains('install-fallback-sheet')) {
      el.textContent = full;
    } else {
      el.textContent = short;
      el.title = full;
      el.setAttribute('aria-label', full);
    }
  }

  function syncVisibility() {
    const suppressed = appInstalled || isStandalone();
    const showFallback = !suppressed && fallbackReady && !deferredPrompt;

    allButtons().forEach((btn) => {
      btn.hidden = suppressed || !deferredPrompt;

      const fallback = btn.nextElementSibling as HTMLElement | null;
      if (!fallback || !fallback.classList.contains('install-fallback')) return;

      if (showFallback) populateFallback(fallback);
      fallback.hidden = !showFallback;
    });
  }

  function initInstallPrompt() {
    const btns = allButtons();
    if (btns.length === 0) return;

    if (!installPromptStarted) {
      installPromptStarted = true;

      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        deferredPrompt = event;
        syncVisibility();
      });

      window.addEventListener('appinstalled', () => {
        appInstalled = true;
        deferredPrompt = null;
        syncVisibility();
      });

      if (!isStandalone()) {
        setTimeout(() => {
          fallbackReady = true;
          syncVisibility();
        }, 2500);
      }
    }

    btns.forEach((btn) => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
        syncVisibility();
      });
    });

    syncVisibility();
  }

  initInstallPrompt();
  document.addEventListener('astro:page-load', initInstallPrompt);
</script>
