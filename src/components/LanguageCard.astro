---
import type { LanguageMeta } from '../data/languages';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';

interface Props {
  language: LanguageMeta;
  lessonCount: number;
  basePath?: string;
}

const { language, lessonCount, basePath = `/${ACTIVE_USER_LANGUAGES[0].id}` } = Astro.props;
---

<a
  class="lang-card card card-glow"
  href={`${basePath}/${language.id}`}
  style={`--accent-c: ${language.color}`}
>
  <div class="top">
    <span class="flag" aria-hidden="true">{language.flag}</span>
    {
      /* La palabra entera, no la raíz más un sufijo: el plural de «lección» es
        «lecciones», sin tilde. Pegarle «es» a «lección» daba «lecciónes», que
        estuvo cinco veces en la portada —una por idioma— hasta que la
        auditoría de contenido lo encontró. */
    }
    <span class="badge">{lessonCount} {lessonCount === 1 ? 'lección' : 'lecciones'}</span>
  </div>
  <h3>{language.name}</h3>
  <p class="tagline underline-draw">{language.tagline}</p>
  <p class="desc">{language.description}</p>
  <span class="link">Ver niveles →</span>
</a>

<style>
  .lang-card {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--text);
    border-top: 3px solid var(--accent-c);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .flag {
    font-size: 1.9rem;
  }

  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }

  .tagline {
    color: var(--accent-c);
    font-weight: 700;
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }

  .link {
    font-weight: 700;
    font-size: 0.9rem;
  }
</style>
