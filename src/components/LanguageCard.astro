---
import type { LanguageMeta } from '../data/languages';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { getDictionary } from '../i18n';

interface Props {
  language: LanguageMeta;
  lessonCount: number;
  basePath?: string;
  userLang?: string;
}

const {
  language,
  lessonCount,
  userLang = ACTIVE_USER_LANGUAGES[0].id,
  basePath = `/${userLang}`,
} = Astro.props;

// El nombre, el eslogan y la descripción salen del DICCIONARIO, no de
// src/data/languages.ts. Ese archivo guarda una sola versión de cada uno, en
// español, así que la portada del silo inglés anunciaba «Alemán · Precisión,
// casos y palabras larguísimas». El diccionario los tiene por idioma de
// interfaz justamente para esto.
const dict = getDictionary(userLang as never);
const id = language.id as keyof typeof dict.languageNames;
const t = dict.silo;
---

<a
  class="lang-card card card-glow"
  href={`${basePath}/${language.id}`}
  style={`--accent-c: ${language.color}`}
>
  <div class="top">
    <span class="flag" aria-hidden="true">{language.flag}</span>
    {
      /* La palabra entera, no la raíz más un sufijo: el plural de «lección» es
        «lecciones», sin tilde. Pegarle «es» a «lección» daba «lecciónes», que
        estuvo cinco veces en la portada —una por idioma— hasta que la
        auditoría de contenido lo encontró. */
    }
    <span class="badge">{lessonCount} {lessonCount === 1 ? t.leccion : t.lecciones}</span>
  </div>
  <h3>{dict.languageNames[id]}</h3>
  <p class="tagline underline-draw">{dict.languageTaglines[id]}</p>
  <p class="desc">{dict.languageDescriptions[id]}</p>
  <span class="link">{t.verNiveles}</span>
</a>

<style>
  .lang-card {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--text);
    border-top: 3px solid var(--accent-c);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .flag {
    font-size: 1.9rem;
  }

  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }

  .tagline {
    color: var(--accent-c);
    font-weight: 700;
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }

  .link {
    font-weight: 700;
    font-size: 0.9rem;
  }
</style>
