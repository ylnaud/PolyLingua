---
// Selector de idioma de INTERFAZ (userLang), no de idioma a aprender.
// Vive en el header, en cualquier página. Si la URL actual pertenece al
// silo /[userLang]/[targetLang]/..., arma el link equivalente en cada
// idioma de interfaz activo (mismo targetLang y resto de la ruta); si no,
// linkea al catálogo de esa interfaz. Los idiomas todavía sin contenido
// (`active: false`) se muestran deshabilitados como "Próximamente" — la
// arquitectura ya los soporta, solo falta traducir la interfaz.
import { USER_LANGUAGES, type UserLanguageId } from '../data/userLanguages';
import {
  courseHasLesson,
  getTargetLangsFor,
  SPANISH_GLOSS_TOOLS,
  SPANISH_GLOSS_USER_LANG,
} from '../lib/courses';
import { LEVELS } from '../data/levels';

const knownUserLangIds = USER_LANGUAGES.map((l) => l.id);
const siloMatch = Astro.url.pathname.match(/^\/([a-z]{2})\/([a-z]{2})(\/.*)?$/);
const currentUserLang =
  siloMatch && knownUserLangIds.includes(siloMatch[1] as UserLanguageId)
    ? (siloMatch[1] as UserLanguageId)
    : 'es';
const targetLang = siloMatch ? siloMatch[2] : null;
const restPath = siloMatch?.[3] ?? '';

// Cambiar de interfaz solo puede conservar el curso si ese curso EXISTE. No
// todos los pares (interfaz, meta) existen: nadie estudia su propio idioma,
// así que no hay de-de ni es-es. Sin este chequeo, un alemán mirando una
// lección de /es/de/a1/... veía "Deutsch" enlazando a /de/de/a1/..., que no
// se genera — un 404. Cuando el curso no existe se cae al catálogo de esa
// interfaz, que siempre está.
// Diálogos, recursos y generador de frases solo se generan en el silo español
// (su contenido está glosado solo en español), así que tampoco se pueden
// conservar al cambiar de interfaz.
const restSegments = restPath.split('/').filter(Boolean);
const restTool = restSegments[0] ?? '';
const restIsSpanishOnly = SPANISH_GLOSS_TOOLS.includes(restTool);

// Si la ruta apunta a una lección concreta (/a1/<slug>), hay que comprobar que
// ese slug exista en el curso destino: los cursos no comparten slugs.
const lessonLevel = LEVELS.some((l) => l.id === restTool) ? restTool : null;
const lessonSlug = lessonLevel && restSegments.length === 2 ? restSegments[1] : null;

function hrefFor(langId: UserLanguageId): string {
  const courseExists = !!targetLang && getTargetLangsFor(langId).includes(targetLang as never);
  const toolExists = !restIsSpanishOnly || langId === SPANISH_GLOSS_USER_LANG;
  const lessonExists =
    !lessonSlug || (!!targetLang && courseHasLesson(langId, targetLang, lessonLevel!, lessonSlug));
  if (courseExists && toolExists && lessonExists) return `/${langId}/${targetLang}${restPath}`;
  // Sin equivalente exacto: se cae al nivel si la ruta lo tenía, y si no al
  // catálogo. Mejor la página más cercana que existe que un 404.
  if (courseExists && lessonLevel) return `/${langId}/${targetLang}/${lessonLevel}`;
  return `/${langId}`;
}
---

<details class="lang-selector">
  <summary class="lang-selector-trigger" aria-label="Cambiar idioma de la interfaz">
    <span aria-hidden="true">{USER_LANGUAGES.find((l) => l.id === currentUserLang)?.flag}</span>
  </summary>
  <div class="lang-selector-panel">
    {
      USER_LANGUAGES.map((lang) =>
        lang.active ? (
          <a
            class={lang.id === currentUserLang ? 'lang-option current' : 'lang-option'}
            href={hrefFor(lang.id)}
          >
            <span aria-hidden="true">{lang.flag}</span> {lang.name}
          </a>
        ) : (
          <span class="lang-option disabled" aria-disabled="true">
            <span aria-hidden="true">{lang.flag}</span> {lang.name}
            <em>Próximamente</em>
          </span>
        ),
      )
    }
  </div>
</details>

<style>
  .lang-selector {
    position: relative;
  }

  .lang-selector-trigger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    cursor: pointer;
    font-size: 1.2rem;
    list-style: none;
  }

  .lang-selector-trigger::-webkit-details-marker {
    display: none;
  }

  .lang-selector-trigger::marker {
    content: '';
  }

  .lang-selector[open] .lang-selector-trigger {
    border-color: var(--accent);
  }

  .lang-selector-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 180px;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow-card-hover);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  a.lang-option:hover {
    background: var(--bg-elevated);
  }

  .lang-option.current {
    color: var(--accent-text);
  }

  .lang-option.disabled {
    color: var(--text-muted);
    cursor: default;
  }

  .lang-option.disabled em {
    margin-left: auto;
    font-style: normal;
    font-size: 0.7rem;
    opacity: 0.75;
  }
</style>

<script>
  function initLangSelector() {
    document.querySelectorAll<HTMLDetailsElement>('.lang-selector').forEach((menu) => {
      if (menu.dataset.initialized) return;
      menu.dataset.initialized = 'true';
      document.addEventListener('click', (e) => {
        if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
      });
    });
  }
  initLangSelector();
  document.addEventListener('astro:page-load', initLangSelector);
</script>
