---
import SpeakButton from './SpeakButton.astro';
import { getDictionary } from '../i18n';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';

interface Phrase {
  text: string;
  es: string;
  say?: string;
  note?: string;
}

interface Props {
  phrases: Phrase[];
  lang?: string;
  userLang?: string;
}

const { phrases, lang = '', userLang } = Astro.props;
const t = getDictionary((userLang ?? ACTIVE_USER_LANGUAGES[0].id) as never).lesson;
---

<div class="phrase-bank card" data-lang={lang}>
  <span class="eyebrow">{t.frasesTitulo}</span>
  <p class="phrase-intro">{t.frasesIntro}</p>
  <ul class="phrase-list">
    {
      phrases.map((phrase) => (
        <li class="phrase-item">
          <div class="phrase-main">
            <p class="phrase-de">{phrase.text}</p>
            {phrase.say && <p class="phrase-say">{phrase.say}</p>}
            <p class="phrase-es">{phrase.es}</p>
            {phrase.note && <p class="phrase-note">{phrase.note}</p>}
          </div>
          <SpeakButton text={phrase.text} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .phrase-bank {
    margin: 1.75rem 0;
    padding: 1.1rem 1.25rem;
  }

  .phrase-intro {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0.35rem 0 1rem;
  }

  .phrase-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .phrase-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
  }

  .phrase-item:first-child {
    padding-top: 0;
    border-top: none;
  }

  .phrase-main {
    min-width: 0;
  }

  .phrase-de {
    font-weight: 700;
    font-size: 1.05rem;
    margin: 0;
  }

  .phrase-say {
    color: var(--accent-text);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0.2rem 0 0;
  }

  .phrase-es {
    color: var(--text-muted);
    margin: 0.15rem 0 0;
  }

  .phrase-note {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: italic;
    margin: 0.3rem 0 0;
  }
</style>
