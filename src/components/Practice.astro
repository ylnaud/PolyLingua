---
import { getDictionary } from '../i18n';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';

interface QuizQuestion {
  question: string;
  options: string[];
  answerIndex: number;
  explanation: string;
}

interface FillBlankExercise {
  type: 'fill-blank';
  sentence: string;
  answer: string;
  accepted?: string[];
  hint?: string;
  translation?: string;
  placeholder?: string;
}

interface MatchExercise {
  type: 'match';
  instructions?: string;
  pairs: { left: string; right: string }[];
}

interface WriteExercise {
  type: 'write';
  prompt: string;
  answer: string;
  accepted?: string[];
  hint?: string;
  spokenOnly?: boolean;
  placeholder?: string;
}

interface OrderExercise {
  type: 'order';
  sentence: string;
  translation?: string;
}

type Exercise = FillBlankExercise | MatchExercise | WriteExercise | OrderExercise;

interface Props {
  userLang?: string;
  quiz: QuizQuestion[];
  exercises?: Exercise[];
  minutes?: number;
  lessonId?: string;
  sessionType?: 'lesson' | 'exam' | 'review' | 'practice-libre' | 'vocab' | 'errors';
  itemIds?: string[];
  dynamic?: boolean;
  lang?: string;
}

const {
  userLang,
  quiz,
  exercises = [],
  minutes = 8,
  lessonId = '',
  sessionType = 'lesson',
  itemIds,
  dynamic = false,
  lang = '',
} = Astro.props;

const dict = getDictionary((userLang ?? ACTIVE_USER_LANGUAGES[0].id) as never);
const t = dict.practice;

// Los 4 strings que necesita el <script> del navegador. Se pasan por
// data-* (patrón ya usado en el resto del proyecto) porque el script se
// ejecuta en el cliente y no ve las variables del frontmatter de Astro.
const scriptStrings = JSON.stringify({
  correcto: t.correcto,
  incorrecto: t.incorrecto,
  respuestaCorrecta: t.respuestaCorrecta,
  resultado: t.resultado,
});

type Item =
  | { kind: 'choice'; data: QuizQuestion }
  | { kind: 'fill-blank'; data: FillBlankExercise }
  | { kind: 'match'; data: MatchExercise }
  | { kind: 'write'; data: WriteExercise }
  | { kind: 'order'; data: OrderExercise };

const items: Item[] = [
  ...quiz.map((data): Item => ({ kind: 'choice', data })),
  ...exercises.map((ex): Item => {
    if (ex.type === 'fill-blank') return { kind: 'fill-blank', data: ex };
    if (ex.type === 'match') return { kind: 'match', data: ex };
    if (ex.type === 'write') return { kind: 'write', data: ex };
    return { kind: 'order', data: ex };
  }),
];

const kindLabels: Record<Item['kind'], string> = {
  choice: t.kinds.choice,
  'fill-blank': t.kinds.fillBlank,
  match: t.kinds.match,
  write: t.kinds.write,
  order: t.kinds.order,
};

function splitSentence(sentence: string): { before: string; after: string } {
  const idx = sentence.indexOf('___');
  if (idx === -1) return { before: sentence, after: '' };
  return { before: sentence.slice(0, idx), after: sentence.slice(idx + 3) };
}
---

{
  (items.length > 0 || dynamic) && (
    <section
      class="practice"
      data-practice
      data-i18n={scriptStrings}
      data-lesson-minutes={minutes}
      data-session-type={sessionType}
      data-lesson-id={lessonId}
      data-dynamic={dynamic ? 'true' : 'false'}
      data-lang={lang}
      aria-label={t.aria}
    >
      <div class="practice-head">
        <span class="eyebrow">{t.tituloSeccion}</span>
        <span class="streak-badge" data-streak-badge hidden>
          🔥 x2
        </span>
        <span class="practice-progress" data-practice-progress role="status" aria-live="polite">
          1 / {items.length}
        </span>
      </div>
      <div class="progress-bar" data-progress-bar>
        <div class="progress-bar-fill" data-progress-bar-fill />
      </div>

      <div class="practice-items" data-items-container>
        {items.map((item, i) => (
          <fieldset
            class="practice-item"
            data-practice-item
            data-kind={item.kind}
            data-index={i}
            data-item-id={itemIds ? itemIds[i] : `${lessonId}#${item.kind}-${i}`}
            data-item-json={JSON.stringify(item.data)}
            data-spoken-only={item.kind === 'write' && item.data.spokenOnly ? 'true' : 'false'}
            hidden={i !== 0}
          >
            <span class="kind-tag">{kindLabels[item.kind]}</span>

            {item.kind === 'choice' && (
              <>
                <legend tabindex="-1">{item.data.question}</legend>
                <div class="options">
                  {item.data.options.map((opt, oi) => (
                    <button
                      type="button"
                      class="option"
                      data-option
                      data-option-key={oi + 1}
                      data-correct={oi === item.data.answerIndex ? 'true' : 'false'}
                    >
                      {opt}
                    </button>
                  ))}
                </div>
              </>
            )}

            {item.kind === 'fill-blank' && (
              <>
                <legend tabindex="-1">{t.completaLaFrase}</legend>
                <p class="prompt-sentence">
                  {splitSentence(item.data.sentence).before}
                  <span class="blank-marker" aria-hidden="true">
                    ___
                  </span>
                  {splitSentence(item.data.sentence).after}
                </p>
                {item.data.translation && <p class="prompt-translation">{item.data.translation}</p>}
                <label class="visually-hidden" for={`input-${i}`}>
                  Tu respuesta
                </label>
                <div class="answer-row">
                  <input
                    type="text"
                    id={`input-${i}`}
                    class="answer-input"
                    data-answer-input
                    data-answer={item.data.answer}
                    data-accepted={(item.data.accepted ?? []).join('|')}
                    placeholder={item.data.placeholder}
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                  />
                  <button type="button" class="btn btn-primary check" data-check>
                    Comprobar
                  </button>
                </div>
                {item.data.hint && (
                  <details class="hint">
                    <summary>{t.pista}</summary>
                    <p>{item.data.hint}</p>
                  </details>
                )}
              </>
            )}

            {item.kind === 'write' && (
              <>
                <legend tabindex="-1">
                  {item.data.spokenOnly ? '🔊 Escucha y escribe lo que oís' : item.data.prompt}
                </legend>
                {item.data.spokenOnly && (
                  <button
                    type="button"
                    class="speak-btn spoken-only-speak"
                    data-speak
                    data-speak-text={item.data.answer}
                    aria-label={t.escucharDeNuevo}
                  >
                    🔊 {dict.lesson.escuchar}
                  </button>
                )}
                <label class="visually-hidden" for={`input-${i}`}>
                  Tu respuesta
                </label>
                <div class="answer-row">
                  <input
                    type="text"
                    id={`input-${i}`}
                    class="answer-input"
                    data-answer-input
                    data-answer={item.data.answer}
                    data-accepted={(item.data.accepted ?? []).join('|')}
                    placeholder={item.data.placeholder}
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                  />
                  <button type="button" class="btn btn-primary check" data-check>
                    Comprobar
                  </button>
                </div>
                {item.data.hint && (
                  <details class="hint">
                    <summary>{t.pista}</summary>
                    <p>{item.data.hint}</p>
                  </details>
                )}
              </>
            )}

            {item.kind === 'match' && (
              <>
                <legend tabindex="-1">
                  {item.data.instructions ?? t.emparejaElementos}
                </legend>
                <div class="match-board" data-match-board data-remaining={item.data.pairs.length}>
                  <div class="match-col" data-match-col="left">
                    {item.data.pairs.map((pair, pi) => (
                      <div class="option-row">
                        <button
                          type="button"
                          class="match-item"
                          data-match-item
                          data-side="left"
                          data-pair={pi}
                          data-value={pair.right}
                        >
                          {pair.left}
                        </button>
                        <button
                          type="button"
                          class="speak-btn match-speak"
                          data-speak
                          data-speak-text={pair.left}
                          aria-label={`${dict.lesson.escuchar} «${pair.left}»`}
                        >
                          🔊
                        </button>
                      </div>
                    ))}
                  </div>
                  <div class="match-col" data-match-col="right">
                    {item.data.pairs.map((_, pi) => (
                      <button
                        type="button"
                        class="match-item"
                        data-match-item
                        data-side="right"
                        data-pair={pi}
                        data-value={item.data.pairs[pi].right}
                      >
                        {item.data.pairs[pi].right}
                      </button>
                    ))}
                  </div>
                </div>
              </>
            )}

            {item.kind === 'order' && (
              <>
                <legend tabindex="-1">{t.ordenaPalabras}</legend>
                {item.data.translation && <p class="prompt-translation">{item.data.translation}</p>}
                <div
                  class="order-assembled"
                  data-order-assembled
                  data-answer={item.data.sentence}
                  aria-label={t.fraseConstruyendo}
                />
                <div class="order-bank" data-order-bank>
                  {item.data.sentence.split(' ').map((_, wi) => (
                    <button type="button" class="word-chip" data-word-chip data-word-index={wi}>
                      {item.data.sentence.split(' ')[wi]}
                    </button>
                  ))}
                </div>
                <button type="button" class="btn btn-primary check" data-check hidden>
                  Comprobar
                </button>
              </>
            )}

            <p class="feedback" data-feedback role="status" aria-live="polite" />
            <p class="explanation" data-explanation hidden>
              {item.kind === 'choice' ? item.data.explanation : ''}
            </p>
            {(item.kind === 'fill-blank' || item.kind === 'write' || item.kind === 'order') && (
              <>
                <button
                  type="button"
                  class="speak-btn reveal-speak"
                  data-speak
                  data-reveal-speak
                  hidden
                >
                  🔊 {dict.lesson.escuchar}
                </button>
                <button
                  type="button"
                  class="btn btn-primary shadow-confirm"
                  data-shadow-confirm
                  hidden
                >
                  🎤 Ya lo dije en voz alta
                </button>
              </>
            )}
            <button type="button" class="btn btn-primary next" data-next hidden>
              {dict.lesson.siguiente}
            </button>
          </fieldset>
        ))}
      </div>

      <div class="practice-done" data-practice-done hidden>
        <p class="score-emoji" data-score-emoji>
          🎉
        </p>
        <h3>{t.completado}</h3>
        <p data-score-text>{t.resultado} 0 / {items.length}</p>
        <button type="button" class="btn btn-ghost" data-restart>
          Repetir
        </button>
      </div>
    </section>
  )
}

<style is:global>
  .practice {
    margin-block: 2rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .practice-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .practice-progress {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 700;
  }

  .progress-bar {
    height: 6px;
    border-radius: 999px;
    background: var(--bg-elevated);
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  .streak-badge {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--de-red);
    background: rgba(216, 0, 39, 0.12);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    animation: streak-pop 0.35s ease;
  }

  @keyframes streak-pop {
    0% {
      transform: scale(0.8);
      opacity: 0;
    }
    60% {
      transform: scale(1.12);
      opacity: 1;
    }
    100% {
      transform: scale(1);
    }
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .kind-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  legend:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  legend {
    font-weight: 700;
    font-size: 1.05rem;
    padding: 0;
    margin-bottom: 1rem;
  }

  .options {
    display: grid;
    gap: 0.6rem;
  }

  .option-row {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
  }

  .option-row .option,
  .option-row .match-item {
    flex: 1;
  }

  .speak-btn {
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1.05rem;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s ease;
  }

  .speak-btn:hover {
    border-color: var(--accent);
  }

  .speak-btn.match-speak {
    border-color: transparent;
    background: transparent;
    font-size: 0.95rem;
    border-radius: 999px;
  }

  .speak-btn.match-speak:hover,
  .speak-btn.match-speak:focus-visible {
    border-color: var(--border);
    background: var(--bg-elevated);
  }

  .speak-btn.reveal-speak,
  .speak-btn.spoken-only-speak {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: auto;
    min-width: 0;
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 700;
    margin-block: 0.75rem 0;
  }

  .option,
  .match-item,
  .word-chip {
    text-align: left;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 0.98rem;
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  /* Pista visual del atajo de teclado (1-9) para elegir una opción sin
     mouse/tap — solo hasta el 9 tiene sentido mostrarlo, y las preguntas de
     opción múltiple del contenido nunca pasan de unas pocas alternativas. */
  .option[data-option-key]::before {
    content: attr(data-option-key) '. ';
    color: var(--text-muted);
    font-weight: 700;
  }

  .option:hover,
  .match-item:hover,
  .word-chip:hover {
    border-color: var(--accent);
  }

  .option.correct,
  .match-item.correct {
    border-color: #2f9e6e;
    background: rgba(47, 158, 110, 0.15);
  }

  .option.incorrect,
  .match-item.incorrect {
    border-color: var(--de-red);
    background: rgba(216, 0, 39, 0.12);
  }

  .option:disabled,
  .match-item:disabled {
    cursor: default;
  }

  .match-item.selected {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .match-item {
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    font-weight: 600;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .match-item:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .match-item:active:not(:disabled) {
    transform: translateY(0);
  }

  .match-item.selected {
    box-shadow: var(--shadow-card-hover);
  }

  .option.correct,
  .match-item.correct,
  .answer-input.correct,
  .order-assembled.correct {
    animation: match-pop 0.35s ease;
  }

  .option.incorrect,
  .match-item.incorrect,
  .answer-input.incorrect,
  .order-assembled.incorrect {
    animation: match-shake 0.4s ease;
  }

  @keyframes match-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes match-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-6px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(4px);
    }
  }

  .prompt-sentence {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .blank-marker {
    display: inline-block;
    min-width: 3.5rem;
    border-bottom: 2px solid var(--accent);
    text-align: center;
  }

  .prompt-translation {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }

  .answer-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .answer-input {
    flex: 1 1 200px;
    padding: 0.65rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1rem;
    font-family: inherit;
  }

  .answer-input:focus-visible {
    border-color: var(--accent);
  }

  .answer-input.correct,
  .order-assembled.correct {
    border-color: #2f9e6e;
  }

  .answer-input.incorrect,
  .order-assembled.incorrect {
    border-color: var(--de-red);
  }

  .hint {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .hint summary {
    cursor: pointer;
    font-weight: 600;
  }

  .match-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1rem;
  }

  .match-col {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .order-assembled {
    min-height: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.6rem;
    border: 1px dashed var(--border);
    border-radius: 10px;
    margin-bottom: 0.85rem;
  }

  .order-bank {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .word-chip {
    border-radius: 999px;
  }

  .word-chip[data-placed='true'] {
    display: none;
  }

  .order-assembled .word-chip {
    animation: chip-in 0.2s ease;
  }

  @keyframes chip-in {
    0% {
      transform: scale(0.85) translateY(4px);
      opacity: 0;
    }
    100% {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  .feedback {
    min-height: 1.4rem;
    font-weight: 700;
    margin: 0.85rem 0 0;
  }

  .explanation {
    color: var(--text-muted);
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
  }

  .explanation:empty {
    display: none;
  }

  .next,
  .check,
  .shadow-confirm {
    margin-top: 1rem;
  }

  .practice-done {
    text-align: center;
    padding: 1rem 0;
  }

  .score-emoji {
    font-size: 2.5rem;
    margin: 0;
    animation: score-emoji-in 0.4s ease;
  }

  @keyframes score-emoji-in {
    0% {
      transform: scale(0.4);
      opacity: 0;
    }
    60% {
      transform: scale(1.15);
      opacity: 1;
    }
    100% {
      transform: scale(1);
    }
  }

  @media (max-width: 480px) {
    .match-board {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { playCorrect, playIncorrect, playCombo, speak, isMuted } from '../lib/sound';
  import { shuffle } from '../lib/shuffle';
  import { read } from '../lib/storage';

  function isShadowingEnabled(): boolean {
    return read('polylingua-shadowing-mode') === 'true';
  }

  // Atajo de teclado: elegir una opción de "choice" con las teclas 1-9, sin
  // mouse/tap. Enganchado a document (no al root de cada sesión) porque
  // nada dentro del root recibe foco al cargar la página — showItem() solo
  // enfoca el <legend> al AVANZAR (goNext()), nunca en el ítem inicial — así
  // que un listener scoped al root nunca vería el keydown si el usuario no
  // clickeó nada todavía. Enganchado una sola vez por sesión (flag de
  // módulo, no una vez por cada [data-practice] que aparece bajo
  // navegación SPA) y resuelto en cada pulsación contra el root/ítem
  // vigentes en el DOM, para no acumular listeners duplicados que
  // contarían una misma tecla varias veces.
  let practiceKeyboardStarted = false;

  function initPracticeKeyboardShortcut() {
    if (practiceKeyboardStarted) return;
    practiceKeyboardStarted = true;

    document.addEventListener('keydown', (e) => {
      if (!/^[1-9]$/.test(e.key)) return;
      const item = document.querySelector<HTMLElement>(
        '[data-practice] [data-practice-item]:not([hidden])',
      );
      if (!item || item.dataset.kind !== 'choice' || item.dataset.answered) return;
      const options = item.querySelectorAll<HTMLButtonElement>('[data-option]');
      options[Number(e.key) - 1]?.click();
    });
  }

  function shuffleChildren(container: Element | null) {
    if (!container) return;
    const shuffled = shuffle(Array.from(container.children));
    const frag = document.createDocumentFragment();
    shuffled.forEach((el) => frag.appendChild(el));
    container.appendChild(frag);
  }

  function showCorrection(afterEl: Element, answerText: string, label: string) {
    const p = document.createElement('p');
    p.className = 'prompt-translation';
    p.textContent = `${label} ${answerText}`;
    afterEl.after(p);
  }

  function normalize(value: string): string {
    return value.trim().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  function initPractice() {
    document.querySelectorAll<HTMLElement>('[data-practice]').forEach((root) => {
      // Strings de interfaz inyectados desde el frontmatter vía data-i18n
      // (el script corre en el cliente y no ve las variables de Astro). Los
      // valores por defecto son el español, para que un [data-practice]
      // renderizado sin el atributo siga funcionando.
      const i18n = ((): Record<string, string> => {
        try {
          return JSON.parse(root.dataset.i18n ?? '{}');
        } catch {
          return {};
        }
      })();
      const txtCorrecto = i18n.correcto ?? '✅ ¡Correcto!';
      const txtIncorrecto = i18n.incorrecto ?? '❌ No del todo.';
      const txtRespuesta = i18n.respuestaCorrecta ?? 'Correcto:';
      const txtResultado = i18n.resultado ?? 'Acertaste';
      if (root.dataset.initialized) return;

      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-practice-item]'));
      if (items.length === 0 && root.dataset.dynamic === 'true') return;
      root.dataset.initialized = 'true';
      const startedAt = Date.now();
      const progressEl = root.querySelector<HTMLElement>('[data-practice-progress]');
      const doneEl = root.querySelector<HTMLElement>('[data-practice-done]');
      const scoreText = root.querySelector<HTMLElement>('[data-score-text]');
      const scoreEmoji = root.querySelector<HTMLElement>('[data-score-emoji]');
      const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart]');
      const streakBadge = root.querySelector<HTMLElement>('[data-streak-badge]');
      const progressBarFill = root.querySelector<HTMLElement>('[data-progress-bar-fill]');
      const progressBar = root.querySelector<HTMLElement>('[data-progress-bar]');
      let current = 0;
      let score = 0;
      let streak = 0;
      let maxStreak = 0;
      const results: {
        id: string;
        kind: string;
        data: unknown;
        correct: boolean;
        userAnswer?: string;
        correctAnswer?: string;
      }[] = [];

      function updateStreak(correct: boolean) {
        if (correct) {
          streak += 1;
          maxStreak = Math.max(maxStreak, streak);
        } else {
          streak = 0;
        }
        if (!streakBadge) return;
        if (streak >= 2) {
          streakBadge.textContent = `🔥 x${streak}`;
          streakBadge.hidden = false;
          streakBadge.style.animation = 'none';
          // reflow para poder relanzar la animación en cada acierto consecutivo
          void streakBadge.offsetWidth;
          streakBadge.style.animation = '';
        } else {
          streakBadge.hidden = true;
        }
      }

      if (!('speechSynthesis' in window)) {
        root.querySelectorAll<HTMLElement>('[data-speak]').forEach((btn) => {
          btn.hidden = true;
        });
        // Sin TTS, el legend genérico de spokenOnly deja el ítem sin forma de
        // saber qué escribir — se restaura el prompt real, ya disponible en
        // data-item-json sin plumbing nuevo.
        root
          .querySelectorAll<HTMLElement>('[data-practice-item][data-spoken-only="true"]')
          .forEach((item) => {
            const legend = item.querySelector('legend');
            if (!legend) return;
            try {
              const data = JSON.parse(item.dataset.itemJson ?? 'null');
              if (data?.prompt) legend.textContent = data.prompt;
            } catch {
              /* deja el texto genérico si el parseo falla */
            }
          });
      }

      root.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement)?.closest<HTMLElement>('[data-speak]');
        if (!btn || btn.hidden) return;
        speak(btn.dataset.speakText ?? '', root.dataset.lang ?? '');
      });

      initPracticeKeyboardShortcut();

      function maybeAutoSpeak(index: number) {
        const item = items[index];
        if (!item || item.dataset.kind !== 'write' || item.dataset.spokenOnly !== 'true') return;
        if (isMuted()) return;
        const input = item.querySelector<HTMLInputElement>('[data-answer-input]');
        const answer = input?.dataset.answer ?? '';
        if (answer) speak(answer, root.dataset.lang ?? '');
      }

      function showItem(index: number) {
        items.forEach((it, i) => {
          it.hidden = i !== index;
        });
        if (progressEl) progressEl.textContent = `${index + 1} / ${items.length}`;
        if (progressBarFill) progressBarFill.style.width = `${(index / items.length) * 100}%`;
        maybeAutoSpeak(index);
        // showItem() solo se llama al avanzar (goNext), nunca en la carga
        // inicial, así que este foco nunca se roba al entrar a la página.
        items[index]?.querySelector<HTMLElement>('legend')?.focus();
      }

      function finish() {
        items.forEach((it) => (it.hidden = true));
        if (doneEl) doneEl.hidden = false;
        if (progressEl) progressEl.hidden = true;
        if (progressBar) progressBar.hidden = true;
        if (progressBarFill) progressBarFill.style.width = '100%';
        const pct = score / items.length;
        if (scoreEmoji) scoreEmoji.textContent = pct === 1 ? '🏆' : pct >= 0.5 ? '🎉' : '💪';
        if (scoreText) scoreText.textContent = `${txtResultado} ${score} / ${items.length}`;
        const estimatedMinutes = Number(root.dataset.lessonMinutes ?? 8);
        const elapsedMinutes = Math.round((Date.now() - startedAt) / 60000);
        const minutes = Math.min(Math.max(elapsedMinutes, 1), Math.max(estimatedMinutes * 4, 10));
        root.dispatchEvent(
          new CustomEvent('practice-complete', {
            detail: {
              score,
              total: items.length,
              minutes,
              sessionType: root.dataset.sessionType ?? 'lesson',
              lessonId: root.dataset.lessonId ?? '',
              results,
              maxStreak,
            },
            bubbles: true,
          }),
        );
      }

      function goNext() {
        current += 1;
        if (current < items.length) showItem(current);
        else finish();
      }

      items.forEach((item) => {
        const kind = item.dataset.kind;
        const feedback = item.querySelector<HTMLElement>('[data-feedback]');
        const explanation = item.querySelector<HTMLElement>('[data-explanation]');
        const nextBtn = item.querySelector<HTMLButtonElement>('[data-next]');
        const revealSpeak = item.querySelector<HTMLButtonElement>('[data-reveal-speak]');
        const shadowConfirm = item.querySelector<HTMLButtonElement>('[data-shadow-confirm]');

        // El markup (estático o inyectado por practiceItemMarkup.ts) llega en
        // orden canónico; el reshuffle real pasa acá, una sola vez por ítem al
        // iniciar, para que también se re-mezcle en cada visita en vez de
        // quedar fijo en el HTML del build. El matching/chequeo de "emparejar"
        // y "ordenar" usa data-pair/data-word-index, no la posición en el DOM,
        // así que reordenar acá es seguro.
        if (kind === 'match') shuffleChildren(item.querySelector('[data-match-col="right"]'));
        if (kind === 'order') shuffleChildren(item.querySelector('[data-order-bank]'));

        function reveal(correct: boolean, userAnswer = '', correctAnswer = '') {
          if (feedback) feedback.textContent = correct ? txtCorrecto : txtIncorrecto;
          if (correct) playCorrect();
          else playIncorrect();
          updateStreak(correct);
          if (correct && streak >= 2) playCombo(streak);
          if (explanation && explanation.textContent) explanation.hidden = false;

          // Modo shadowing: en vez de destapar "Siguiente" de una, se pide
          // repetir la respuesta en voz alta primero. El gate se basa en que
          // el usuario clickee confirmar, no en detectar que el audio
          // terminó de sonar — speak() no tiene callback de fin, y esperar
          // audio real dejaría trabada la lección para quien tiene el sonido
          // muteado (maybeAutoSpeak no suena nada en ese caso). shadowConfirm
          // solo existe para fill-blank/write/order (donde revealSpeak
          // también existe); choice/match nunca gatean.
          const shouldGateWithShadowing =
            !!shadowConfirm &&
            isShadowingEnabled() &&
            'speechSynthesis' in window &&
            !!revealSpeak?.dataset.speakText;
          if (shouldGateWithShadowing && shadowConfirm) {
            shadowConfirm.dataset.speakText = revealSpeak?.dataset.speakText ?? '';
            shadowConfirm.hidden = false;
          } else if (nextBtn) {
            nextBtn.hidden = false;
          }

          if (correct) score += 1;
          let data: unknown = null;
          try {
            data = JSON.parse(item.dataset.itemJson ?? 'null');
          } catch {
            data = null;
          }
          results.push({
            id: item.dataset.itemId ?? '',
            kind: kind ?? '',
            data,
            correct,
            userAnswer,
            correctAnswer,
          });
          // Responder deshabilita el botón/input enfocado, lo que por spec
          // manda el foco a <body> — lo movemos al botón recién revelado
          // (confirmar shadowing, o directo "Siguiente") para no perder la
          // posición en el teclado.
          if (shouldGateWithShadowing) shadowConfirm?.focus();
          else nextBtn?.focus();
        }

        shadowConfirm?.addEventListener('click', () => {
          speak(shadowConfirm.dataset.speakText ?? '', root.dataset.lang ?? '');
          shadowConfirm.hidden = true;
          if (nextBtn) nextBtn.hidden = false;
          nextBtn?.focus();
        });

        if (kind === 'choice') {
          const options = Array.from(item.querySelectorAll<HTMLButtonElement>('[data-option]'));
          options.forEach((opt) => {
            opt.addEventListener('click', () => {
              if (item.dataset.answered) return;
              item.dataset.answered = 'true';
              const isCorrect = opt.dataset.correct === 'true';
              options.forEach((o) => {
                o.disabled = true;
                if (o.dataset.correct === 'true') o.classList.add('correct');
              });
              if (!isCorrect) opt.classList.add('incorrect');
              const correctOpt = options.find((o) => o.dataset.correct === 'true');
              reveal(
                isCorrect,
                opt.textContent?.trim() ?? '',
                correctOpt?.textContent?.trim() ?? '',
              );
            });
          });
        }

        if (kind === 'fill-blank' || kind === 'write') {
          const input = item.querySelector<HTMLInputElement>('[data-answer-input]');
          const checkBtn = item.querySelector<HTMLButtonElement>('[data-check]');
          const submit = () => {
            if (!input || item.dataset.answered) return;
            item.dataset.answered = 'true';
            const answer = input.dataset.answer ?? '';
            const accepted = (input.dataset.accepted ?? '').split('|').filter(Boolean);
            const candidates = [answer, ...accepted].map(normalize);
            const isCorrect = candidates.includes(normalize(input.value));
            input.disabled = true;
            input.classList.add(isCorrect ? 'correct' : 'incorrect');
            if (!isCorrect) {
              const row = input.closest('.answer-row') ?? input;
              showCorrection(row, answer, txtRespuesta);
            }
            if (checkBtn) checkBtn.hidden = true;
            if (revealSpeak && answer) {
              revealSpeak.dataset.speakText = answer;
              revealSpeak.hidden = false;
            }
            // Auto-play must stay synchronous with the click that triggered submit() —
            // inserting an await/setTimeout before this line can make Safari drop the
            // user-gesture standing required for speechSynthesis.speak() to fire.
            if (kind === 'fill-blank' && isCorrect && !isMuted() && answer) {
              speak(answer, root.dataset.lang ?? '');
            }
            reveal(isCorrect, input?.value ?? '', answer);
          };
          checkBtn?.addEventListener('click', submit);
          input?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
              e.preventDefault();
              submit();
            }
          });
        }

        if (kind === 'match') {
          const board = item.querySelector<HTMLElement>('[data-match-board]');
          const matchItems = Array.from(
            item.querySelectorAll<HTMLButtonElement>('[data-match-item]'),
          );
          // Sin lado fijo: el primer toque puede ser de cualquier columna
          // (en mobile el tablero se apila en una sola columna, así que
          // exigir que el primer toque sea siempre el izquierdo rompía el
          // juego para quien empieza a tocar de abajo hacia arriba).
          let selected: HTMLButtonElement | null = null;
          let mistakes = 0;
          let remaining = Number(board?.dataset.remaining ?? matchItems.length / 2);

          matchItems.forEach((btn) => {
            btn.addEventListener('click', () => {
              if (btn.disabled || btn === selected) return;
              if (!selected || selected.dataset.side === btn.dataset.side) {
                selected?.classList.remove('selected');
                selected = btn;
                btn.classList.add('selected');
                return;
              }
              const isMatch = selected.dataset.value === btn.dataset.value;
              if (isMatch) {
                selected.disabled = true;
                btn.disabled = true;
                selected.classList.remove('selected');
                selected.classList.add('correct');
                btn.classList.add('correct');
                selected = null;
                remaining -= 1;
                if (remaining <= 0 && !item.dataset.answered) {
                  item.dataset.answered = 'true';
                  reveal(mistakes === 0, `${mistakes} error(es)`, '0 errores');
                }
              } else {
                mistakes += 1;
                playIncorrect();
                btn.classList.add('incorrect');
                selected.classList.add('incorrect');
                window.setTimeout(() => {
                  btn.classList.remove('incorrect');
                  selected?.classList.remove('incorrect', 'selected');
                  selected = null;
                }, 500);
              }
            });
          });
        }

        if (kind === 'order') {
          const assembled = item.querySelector<HTMLElement>('[data-order-assembled]');
          const chips = Array.from(item.querySelectorAll<HTMLButtonElement>('[data-word-chip]'));
          const checkBtn = item.querySelector<HTMLButtonElement>('[data-check]');
          const correctSentence = assembled?.dataset.answer ?? '';
          const placedOrder: number[] = [];

          function renderAssembled() {
            if (!assembled) return;
            assembled.textContent = '';
            placedOrder.forEach((wordIndex) => {
              const chip = chips.find((c) => Number(c.dataset.wordIndex) === wordIndex);
              if (!chip) return;
              const span = document.createElement('button');
              span.type = 'button';
              span.className = 'word-chip';
              span.textContent = (chip.textContent ?? '').trim();
              span.addEventListener('click', () => {
                const pos = placedOrder.indexOf(wordIndex);
                if (pos !== -1) placedOrder.splice(pos, 1);
                chip.dataset.placed = 'false';
                renderAssembled();
              });
              assembled.appendChild(span);
            });
            if (checkBtn) checkBtn.hidden = placedOrder.length !== chips.length;
          }

          chips.forEach((chip) => {
            chip.addEventListener('click', () => {
              if (item.dataset.answered || chip.dataset.placed === 'true') return;
              chip.dataset.placed = 'true';
              placedOrder.push(Number(chip.dataset.wordIndex));
              renderAssembled();
            });
          });

          checkBtn?.addEventListener('click', () => {
            if (item.dataset.answered) return;
            item.dataset.answered = 'true';
            const built = placedOrder
              .map((wi) =>
                (chips.find((c) => Number(c.dataset.wordIndex) === wi)?.textContent ?? '').trim(),
              )
              .join(' ');
            const isCorrect = normalize(built) === normalize(correctSentence);
            checkBtn.hidden = true;
            if (assembled) {
              assembled.classList.add(isCorrect ? 'correct' : 'incorrect');
              if (!isCorrect) showCorrection(assembled, correctSentence, txtRespuesta);
            }
            if (revealSpeak && correctSentence) {
              revealSpeak.dataset.speakText = correctSentence;
              revealSpeak.hidden = false;
            }
            // Auto-play must stay synchronous with this click handler — see the
            // fill-blank submit() comment above for why.
            if (isCorrect && !isMuted() && correctSentence) {
              speak(correctSentence, root.dataset.lang ?? '');
            }
            reveal(isCorrect, built, correctSentence);
          });
        }

        nextBtn?.addEventListener('click', goNext);
      });

      maybeAutoSpeak(current);

      restartBtn?.addEventListener('click', () => {
        window.location.reload();
      });
    });
  }

  initPractice();
  document.addEventListener('astro:page-load', initPractice);
</script>
