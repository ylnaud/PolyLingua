---
interface QuizQuestion {
  question: string;
  options: string[];
  answerIndex: number;
  explanation: string;
}

interface FillBlankExercise {
  type: 'fill-blank';
  sentence: string;
  answer: string;
  accepted?: string[];
  hint?: string;
  translation?: string;
}

interface MatchExercise {
  type: 'match';
  instructions?: string;
  pairs: { left: string; right: string }[];
}

interface WriteExercise {
  type: 'write';
  prompt: string;
  answer: string;
  accepted?: string[];
  hint?: string;
}

interface OrderExercise {
  type: 'order';
  sentence: string;
  translation?: string;
}

type Exercise = FillBlankExercise | MatchExercise | WriteExercise | OrderExercise;

interface Props {
  quiz: QuizQuestion[];
  exercises?: Exercise[];
  minutes?: number;
  lessonId?: string;
  sessionType?: 'lesson' | 'exam' | 'review';
  itemIds?: string[];
  dynamic?: boolean;
  lang?: string;
}

const {
  quiz,
  exercises = [],
  minutes = 8,
  lessonId = '',
  sessionType = 'lesson',
  itemIds,
  dynamic = false,
  lang = '',
} = Astro.props;

type Item =
  | { kind: 'choice'; data: QuizQuestion }
  | { kind: 'fill-blank'; data: FillBlankExercise }
  | { kind: 'match'; data: MatchExercise }
  | { kind: 'write'; data: WriteExercise }
  | { kind: 'order'; data: OrderExercise };

const items: Item[] = [
  ...quiz.map((data): Item => ({ kind: 'choice', data })),
  ...exercises.map((ex): Item => {
    if (ex.type === 'fill-blank') return { kind: 'fill-blank', data: ex };
    if (ex.type === 'match') return { kind: 'match', data: ex };
    if (ex.type === 'write') return { kind: 'write', data: ex };
    return { kind: 'order', data: ex };
  }),
];

const kindLabels: Record<Item['kind'], string> = {
  choice: '🔘 Opción múltiple',
  'fill-blank': '✏️ Completa el hueco',
  match: '🔗 Empareja',
  write: '⌨️ Escribe la respuesta',
  order: '🧩 Ordena la frase',
};

function splitSentence(sentence: string): { before: string; after: string } {
  const idx = sentence.indexOf('___');
  if (idx === -1) return { before: sentence, after: '' };
  return { before: sentence.slice(0, idx), after: sentence.slice(idx + 3) };
}

function shuffledIndices(n: number): number[] {
  const arr = Array.from({ length: n }, (_, i) => i);
  for (let i = arr.length - 1; i > 0; i -= 1) {
    const j = Math.floor(((i + 1) * 9301 + 49297) % 233280 / 233280 * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}
---

{(items.length > 0 || dynamic) && (
  <section
    class="practice"
    data-practice
    data-lesson-minutes={minutes}
    data-session-type={sessionType}
    data-lesson-id={lessonId}
    data-dynamic={dynamic ? 'true' : 'false'}
    data-lang={lang}
    aria-label="Práctica interactiva"
  >
    <div class="practice-head">
      <span class="eyebrow">🎮 Ponte a prueba</span>
      <span class="practice-progress" data-practice-progress>1 / {items.length}</span>
    </div>

    <div class="practice-items" data-items-container>
    {items.map((item, i) => (
      <fieldset
        class="practice-item"
        data-practice-item
        data-kind={item.kind}
        data-index={i}
        data-item-id={itemIds ? itemIds[i] : `${lessonId}#${item.kind}-${i}`}
        data-item-json={JSON.stringify(item.data)}
        hidden={i !== 0}
      >
        <span class="kind-tag">{kindLabels[item.kind]}</span>

        {item.kind === 'choice' && (
          <>
            <legend>{item.data.question}</legend>
            <div class="options">
              {item.data.options.map((opt, oi) => (
                <button
                  type="button"
                  class="option"
                  data-option
                  data-correct={oi === item.data.answerIndex ? 'true' : 'false'}
                >
                  {opt}
                </button>
              ))}
            </div>
          </>
        )}

        {item.kind === 'fill-blank' && (
          <>
            <legend>Completa la frase</legend>
            <p class="prompt-sentence">
              {splitSentence(item.data.sentence).before}
              <span class="blank-marker" aria-hidden="true">___</span>
              {splitSentence(item.data.sentence).after}
            </p>
            {item.data.translation && <p class="prompt-translation">{item.data.translation}</p>}
            <label class="visually-hidden" for={`input-${i}`}>Tu respuesta</label>
            <div class="answer-row">
              <input
                type="text"
                id={`input-${i}`}
                class="answer-input"
                data-answer-input
                data-answer={item.data.answer}
                data-accepted={(item.data.accepted ?? []).join('|')}
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              />
              <button type="button" class="btn btn-primary check" data-check>Comprobar</button>
            </div>
            {item.data.hint && (
              <details class="hint">
                <summary>💡 Pista</summary>
                <p>{item.data.hint}</p>
              </details>
            )}
          </>
        )}

        {item.kind === 'write' && (
          <>
            <legend>{item.data.prompt}</legend>
            <label class="visually-hidden" for={`input-${i}`}>Tu respuesta</label>
            <div class="answer-row">
              <input
                type="text"
                id={`input-${i}`}
                class="answer-input"
                data-answer-input
                data-answer={item.data.answer}
                data-accepted={(item.data.accepted ?? []).join('|')}
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              />
              <button type="button" class="btn btn-primary check" data-check>Comprobar</button>
            </div>
            {item.data.hint && (
              <details class="hint">
                <summary>💡 Pista</summary>
                <p>{item.data.hint}</p>
              </details>
            )}
          </>
        )}

        {item.kind === 'match' && (
          <>
            <legend>{item.data.instructions ?? 'Empareja cada elemento con su pareja correcta'}</legend>
            <div class="match-board" data-match-board data-remaining={item.data.pairs.length}>
              <div class="match-col" data-match-col="left">
                {item.data.pairs.map((pair, pi) => (
                  <div class="option-row">
                    <button
                      type="button"
                      class="match-item"
                      data-match-item
                      data-side="left"
                      data-pair={pi}
                    >
                      {pair.left}
                    </button>
                    <button type="button" class="speak-btn match-speak" data-speak data-speak-text={pair.left} aria-label={`Escuchar «${pair.left}»`}>🔊</button>
                  </div>
                ))}
              </div>
              <div class="match-col" data-match-col="right">
                {shuffledIndices(item.data.pairs.length).map((pi) => (
                  <button
                    type="button"
                    class="match-item"
                    data-match-item
                    data-side="right"
                    data-pair={pi}
                  >
                    {item.data.pairs[pi].right}
                  </button>
                ))}
              </div>
            </div>
          </>
        )}

        {item.kind === 'order' && (
          <>
            <legend>Ordena las palabras para formar la frase correcta</legend>
            {item.data.translation && <p class="prompt-translation">{item.data.translation}</p>}
            <div
              class="order-assembled"
              data-order-assembled
              data-answer={item.data.sentence}
              aria-label="Frase que estás construyendo"
            ></div>
            <div class="order-bank" data-order-bank>
              {shuffledIndices(item.data.sentence.split(' ').length).map((wi) => (
                <button type="button" class="word-chip" data-word-chip data-word-index={wi}>
                  {item.data.sentence.split(' ')[wi]}
                </button>
              ))}
            </div>
            <button type="button" class="btn btn-primary check" data-check hidden>Comprobar</button>
          </>
        )}

        <p class="feedback" data-feedback role="status" aria-live="polite"></p>
        <p class="explanation" data-explanation hidden>
          {item.kind === 'choice' ? item.data.explanation : ''}
        </p>
        {(item.kind === 'fill-blank' || item.kind === 'write' || item.kind === 'order') && (
          <button type="button" class="speak-btn reveal-speak" data-speak data-reveal-speak hidden>🔊 Escuchar</button>
        )}
        <button type="button" class="btn btn-primary next" data-next hidden>
          Siguiente →
        </button>
      </fieldset>
    ))}
    </div>

    <div class="practice-done" data-practice-done hidden>
      <p class="score-emoji" data-score-emoji>🎉</p>
      <h3>¡Completado!</h3>
      <p data-score-text>Acertaste 0 / {items.length}</p>
      <button type="button" class="btn btn-ghost" data-restart>Repetir</button>
    </div>
  </section>
)}

<style is:global>
  .practice {
    margin-block: 2rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .practice-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .practice-progress {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 700;
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .kind-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  legend {
    font-weight: 700;
    font-size: 1.05rem;
    padding: 0;
    margin-bottom: 1rem;
  }

  .options {
    display: grid;
    gap: 0.6rem;
  }

  .option-row {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
  }

  .option-row .option,
  .option-row .match-item {
    flex: 1;
  }

  .speak-btn {
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1.05rem;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s ease;
  }

  .speak-btn:hover {
    border-color: var(--accent);
  }

  .speak-btn.match-speak {
    border-color: transparent;
    background: transparent;
    font-size: 0.95rem;
    border-radius: 999px;
  }

  .speak-btn.match-speak:hover,
  .speak-btn.match-speak:focus-visible {
    border-color: var(--border);
    background: var(--bg-elevated);
  }

  .speak-btn.reveal-speak {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: auto;
    min-width: 0;
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 700;
    margin-block: 0.75rem 0;
  }

  .option,
  .match-item,
  .word-chip {
    text-align: left;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 0.98rem;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .option:hover,
  .match-item:hover,
  .word-chip:hover {
    border-color: var(--accent);
  }

  .option.correct,
  .match-item.correct {
    border-color: #2f9e6e;
    background: rgba(47, 158, 110, 0.15);
  }

  .option.incorrect,
  .match-item.incorrect {
    border-color: var(--de-red);
    background: rgba(216, 0, 39, 0.12);
  }

  .option:disabled,
  .match-item:disabled {
    cursor: default;
  }

  .match-item.selected {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .match-item {
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    font-weight: 600;
    transition: border-color 0.15s ease, background 0.15s ease,
      box-shadow 0.15s ease, transform 0.15s ease;
  }

  .match-item:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .match-item:active:not(:disabled) {
    transform: translateY(0);
  }

  .match-item.selected {
    box-shadow: var(--shadow-card-hover);
  }

  .match-item.correct {
    animation: match-pop 0.35s ease;
  }

  .match-item.incorrect {
    animation: match-shake 0.4s ease;
  }

  @keyframes match-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes match-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-6px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(4px);
    }
  }

  .prompt-sentence {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .blank-marker {
    display: inline-block;
    min-width: 3.5rem;
    border-bottom: 2px solid var(--accent);
    text-align: center;
  }

  .prompt-translation {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }

  .answer-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .answer-input {
    flex: 1 1 200px;
    padding: 0.65rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1rem;
    font-family: inherit;
  }

  .answer-input:focus-visible {
    border-color: var(--accent);
  }

  .answer-input.correct {
    border-color: #2f9e6e;
  }

  .answer-input.incorrect {
    border-color: var(--de-red);
  }

  .hint {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .hint summary {
    cursor: pointer;
    font-weight: 600;
  }

  .match-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1rem;
  }

  .match-col {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .order-assembled {
    min-height: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.6rem;
    border: 1px dashed var(--border);
    border-radius: 10px;
    margin-bottom: 0.85rem;
  }

  .order-bank {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .word-chip {
    border-radius: 999px;
  }

  .word-chip[data-placed='true'] {
    display: none;
  }

  .feedback {
    min-height: 1.4rem;
    font-weight: 700;
    margin: 0.85rem 0 0;
  }

  .explanation {
    color: var(--text-muted);
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
  }

  .explanation:empty {
    display: none;
  }

  .next,
  .check {
    margin-top: 1rem;
  }

  .practice-done {
    text-align: center;
    padding: 1rem 0;
  }

  .score-emoji {
    font-size: 2.5rem;
    margin: 0;
  }

  @media (max-width: 480px) {
    .match-board {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { playCorrect, playIncorrect, speak, isMuted } from '../lib/sound';

  function normalize(value: string): string {
    return value
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '');
  }

  function initPractice() {
    document.querySelectorAll<HTMLElement>('[data-practice]').forEach((root) => {
      if (root.dataset.initialized) return;

      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-practice-item]'));
      if (items.length === 0 && root.dataset.dynamic === 'true') return;
      root.dataset.initialized = 'true';
      const progressEl = root.querySelector<HTMLElement>('[data-practice-progress]');
      const doneEl = root.querySelector<HTMLElement>('[data-practice-done]');
      const scoreText = root.querySelector<HTMLElement>('[data-score-text]');
      const scoreEmoji = root.querySelector<HTMLElement>('[data-score-emoji]');
      const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart]');
      let current = 0;
      let score = 0;
      const results: { id: string; kind: string; data: unknown; correct: boolean }[] = [];

      if (!('speechSynthesis' in window)) {
        root.querySelectorAll<HTMLElement>('[data-speak]').forEach((btn) => {
          btn.hidden = true;
        });
      }

      root.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement)?.closest<HTMLElement>('[data-speak]');
        if (!btn || btn.hidden) return;
        speak(btn.dataset.speakText ?? '', root.dataset.lang ?? '');
      });

      function showItem(index: number) {
        items.forEach((it, i) => {
          it.hidden = i !== index;
        });
        if (progressEl) progressEl.textContent = `${index + 1} / ${items.length}`;
      }

      function finish() {
        items.forEach((it) => (it.hidden = true));
        if (doneEl) doneEl.hidden = false;
        if (progressEl) progressEl.hidden = true;
        const pct = score / items.length;
        if (scoreEmoji) scoreEmoji.textContent = pct === 1 ? '🏆' : pct >= 0.5 ? '🎉' : '💪';
        if (scoreText) scoreText.textContent = `Acertaste ${score} / ${items.length}`;
        const minutes = Number(root.dataset.lessonMinutes ?? 8);
        root.dispatchEvent(
          new CustomEvent('practice-complete', {
            detail: {
              score,
              total: items.length,
              minutes,
              sessionType: root.dataset.sessionType ?? 'lesson',
              lessonId: root.dataset.lessonId ?? '',
              results,
            },
            bubbles: true,
          })
        );
      }

      function goNext() {
        current += 1;
        if (current < items.length) showItem(current);
        else finish();
      }

      items.forEach((item) => {
        const kind = item.dataset.kind;
        const feedback = item.querySelector<HTMLElement>('[data-feedback]');
        const explanation = item.querySelector<HTMLElement>('[data-explanation]');
        const nextBtn = item.querySelector<HTMLButtonElement>('[data-next]');
        const revealSpeak = item.querySelector<HTMLButtonElement>('[data-reveal-speak]');

        function reveal(correct: boolean) {
          if (feedback) feedback.textContent = correct ? '✅ ¡Correcto!' : '❌ No del todo.';
          if (correct) playCorrect(); else playIncorrect();
          if (explanation && explanation.textContent) explanation.hidden = false;
          if (nextBtn) nextBtn.hidden = false;
          if (correct) score += 1;
          let data: unknown = null;
          try {
            data = JSON.parse(item.dataset.itemJson ?? 'null');
          } catch {
            data = null;
          }
          results.push({ id: item.dataset.itemId ?? '', kind: kind ?? '', data, correct });
        }

        if (kind === 'choice') {
          const options = Array.from(item.querySelectorAll<HTMLButtonElement>('[data-option]'));
          options.forEach((opt) => {
            opt.addEventListener('click', () => {
              if (item.dataset.answered) return;
              item.dataset.answered = 'true';
              const isCorrect = opt.dataset.correct === 'true';
              options.forEach((o) => {
                o.disabled = true;
                if (o.dataset.correct === 'true') o.classList.add('correct');
              });
              if (!isCorrect) opt.classList.add('incorrect');
              reveal(isCorrect);
            });
          });
        }

        if (kind === 'fill-blank' || kind === 'write') {
          const input = item.querySelector<HTMLInputElement>('[data-answer-input]');
          const checkBtn = item.querySelector<HTMLButtonElement>('[data-check]');
          const submit = () => {
            if (!input || item.dataset.answered) return;
            item.dataset.answered = 'true';
            const answer = input.dataset.answer ?? '';
            const accepted = (input.dataset.accepted ?? '').split('|').filter(Boolean);
            const candidates = [answer, ...accepted].map(normalize);
            const isCorrect = candidates.includes(normalize(input.value));
            input.disabled = true;
            input.classList.add(isCorrect ? 'correct' : 'incorrect');
            if (!isCorrect) input.value = `${input.value} → ${answer}`;
            if (checkBtn) checkBtn.hidden = true;
            if (revealSpeak && answer) {
              revealSpeak.dataset.speakText = answer;
              revealSpeak.hidden = false;
            }
            // Auto-play must stay synchronous with the click that triggered submit() —
            // inserting an await/setTimeout before this line can make Safari drop the
            // user-gesture standing required for speechSynthesis.speak() to fire.
            if (kind === 'fill-blank' && isCorrect && !isMuted() && answer) {
              speak(answer, root.dataset.lang ?? '');
            }
            reveal(isCorrect);
          };
          checkBtn?.addEventListener('click', submit);
          input?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
              e.preventDefault();
              submit();
            }
          });
        }

        if (kind === 'match') {
          const board = item.querySelector<HTMLElement>('[data-match-board]');
          const matchItems = Array.from(item.querySelectorAll<HTMLButtonElement>('[data-match-item]'));
          let selectedLeft: HTMLButtonElement | null = null;
          let mistakes = 0;
          let remaining = Number(board?.dataset.remaining ?? matchItems.length / 2);

          matchItems.forEach((btn) => {
            btn.addEventListener('click', () => {
              if (btn.disabled) return;
              if (btn.dataset.side === 'left') {
                matchItems
                  .filter((b) => b.dataset.side === 'left')
                  .forEach((b) => b.classList.remove('selected'));
                selectedLeft = btn;
                btn.classList.add('selected');
                return;
              }
              if (!selectedLeft) return;
              const isMatch = selectedLeft.dataset.pair === btn.dataset.pair;
              if (isMatch) {
                selectedLeft.disabled = true;
                btn.disabled = true;
                selectedLeft.classList.remove('selected');
                selectedLeft.classList.add('correct');
                btn.classList.add('correct');
                selectedLeft = null;
                remaining -= 1;
                if (remaining <= 0 && !item.dataset.answered) {
                  item.dataset.answered = 'true';
                  reveal(mistakes === 0);
                }
              } else {
                mistakes += 1;
                playIncorrect();
                btn.classList.add('incorrect');
                selectedLeft.classList.add('incorrect');
                window.setTimeout(() => {
                  btn.classList.remove('incorrect');
                  selectedLeft?.classList.remove('incorrect', 'selected');
                  selectedLeft = null;
                }, 500);
              }
            });
          });
        }

        if (kind === 'order') {
          const assembled = item.querySelector<HTMLElement>('[data-order-assembled]');
          const chips = Array.from(item.querySelectorAll<HTMLButtonElement>('[data-word-chip]'));
          const checkBtn = item.querySelector<HTMLButtonElement>('[data-check]');
          const correctSentence = assembled?.dataset.answer ?? '';
          const placedOrder: number[] = [];

          function renderAssembled() {
            if (!assembled) return;
            assembled.textContent = '';
            placedOrder.forEach((wordIndex) => {
              const chip = chips.find((c) => Number(c.dataset.wordIndex) === wordIndex);
              if (!chip) return;
              const span = document.createElement('button');
              span.type = 'button';
              span.className = 'word-chip';
              span.textContent = (chip.textContent ?? '').trim();
              span.addEventListener('click', () => {
                const pos = placedOrder.indexOf(wordIndex);
                if (pos !== -1) placedOrder.splice(pos, 1);
                chip.dataset.placed = 'false';
                renderAssembled();
              });
              assembled.appendChild(span);
            });
            if (checkBtn) checkBtn.hidden = placedOrder.length !== chips.length;
          }

          chips.forEach((chip) => {
            chip.addEventListener('click', () => {
              if (item.dataset.answered || chip.dataset.placed === 'true') return;
              chip.dataset.placed = 'true';
              placedOrder.push(Number(chip.dataset.wordIndex));
              renderAssembled();
            });
          });

          checkBtn?.addEventListener('click', () => {
            if (item.dataset.answered) return;
            item.dataset.answered = 'true';
            const built = placedOrder
              .map((wi) => (chips.find((c) => Number(c.dataset.wordIndex) === wi)?.textContent ?? '').trim())
              .join(' ');
            const isCorrect = normalize(built) === normalize(correctSentence);
            checkBtn.hidden = true;
            if (!isCorrect && assembled) {
              const correction = document.createElement('p');
              correction.className = 'prompt-translation';
              correction.textContent = `Correcto: ${correctSentence}`;
              assembled.after(correction);
            }
            if (revealSpeak && correctSentence) {
              revealSpeak.dataset.speakText = correctSentence;
              revealSpeak.hidden = false;
            }
            // Auto-play must stay synchronous with this click handler — see the
            // fill-blank submit() comment above for why.
            if (isCorrect && !isMuted() && correctSentence) {
              speak(correctSentence, root.dataset.lang ?? '');
            }
            reveal(isCorrect);
          });
        }

        nextBtn?.addEventListener('click', goNext);
      });

      restartBtn?.addEventListener('click', () => {
        window.location.reload();
      });
    });
  }

  initPractice();
  document.addEventListener('astro:page-load', initPractice);
</script>
