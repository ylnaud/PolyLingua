---

<script>
  import { today, addDays, read, write } from '../lib/storage';
  import { INTERVAL_DAYS, MAX_BOX, targetLangFromId } from '../lib/srs';

  interface ResultItem {
    id: string;
    kind: string;
    data: unknown;
    correct: boolean;
    userAnswer?: string;
    correctAnswer?: string;
  }

  interface SrsEntry {
    id: string;
    kind: string;
    data: unknown;
    box: number;
    due: string;
    lang: string;
    level: string;
    firstFailedAt?: string;
    lastFailedAt?: string;
    failCount?: number;
  }

  interface ErrorLogEntry {
    id: string;
    lang: string;
    level: string;
    kind: string;
    date: string;
    userAnswer?: string;
    correctAnswer?: string;
  }

  interface VocabEntry {
    term: string;
    translation: string;
    lang: string;
    lessonId: string;
    learnedAt: string;
  }

  const EXAM_PASS_THRESHOLD = 0.7;
  const COMBO_THRESHOLD = 5;
  const PRACTICE_LIBRE_GOAL = 5;
  const ERROR_LOG_KEY = 'polylingua-error-log';
  const MAX_ERROR_LOG = 200;

  function readPool(): Record<string, SrsEntry> {
    try {
      return JSON.parse(read('polylingua-srs-pool') ?? '{}');
    } catch {
      return {};
    }
  }

  function writePool(pool: Record<string, SrsEntry>) {
    write('polylingua-srs-pool', JSON.stringify(pool));
  }

  function readVocabLearned(): Record<string, VocabEntry> {
    try {
      return JSON.parse(read('polylingua-vocab-learned') ?? '{}');
    } catch {
      return {};
    }
  }

  function recordLearnedVocab(lessonId: string) {
    const el = document.querySelector<HTMLElement>('[data-vocab-tracker]');
    if (!el) return;
    let vocabulary: { term: string; translation: string }[] = [];
    try {
      vocabulary = JSON.parse(el.dataset.vocabulary ?? '[]');
    } catch {
      return;
    }
    if (vocabulary.length === 0) return;
    // Idioma META, no el curso: `es-de/a1/uhrzeit` es alemán, no "es-de".
    const lang = targetLangFromId(lessonId);
    if (!lang) return;
    const learned = readVocabLearned();
    let changed = false;
    for (const v of vocabulary) {
      const vkey = `${lang}::${v.term}`;
      if (learned[vkey]) continue;
      learned[vkey] = {
        term: v.term,
        translation: v.translation,
        lang,
        lessonId,
        learnedAt: today(),
      };
      changed = true;
    }
    if (changed) write('polylingua-vocab-learned', JSON.stringify(learned));
  }

  function writeIfNew(key: string, value: string): boolean {
    const wasSet = read(key) !== null;
    write(key, value);
    return !wasSet;
  }

  function dispatchAchievement(id: string) {
    document.dispatchEvent(new CustomEvent('polylingua-achievement', { detail: { id } }));
  }

  function appendError(entry: Omit<ErrorLogEntry, 'date'>) {
    let log: ErrorLogEntry[];
    try {
      log = JSON.parse(read(ERROR_LOG_KEY) ?? '[]');
    } catch {
      log = [];
    }
    log.push({ ...entry, date: today() });
    if (log.length > MAX_ERROR_LOG) log = log.slice(-MAX_ERROR_LOG);
    write(ERROR_LOG_KEY, JSON.stringify(log));
  }

  function updateSrsPool(results: ResultItem[]) {
    const pool = readPool();
    for (const r of results) {
      if (!r.id) continue;
      const [, level = ''] = r.id.split('#')[0].split('/');
      const lang = targetLangFromId(r.id);
      if (!lang || !level) continue;
      if (!r.correct) {
        const existing = pool[r.id];
        const failBox = Math.max(0, (existing?.box ?? 0) - 2);
        pool[r.id] = {
          id: r.id,
          kind: r.kind,
          data: r.data,
          box: failBox,
          due: failBox === 0 ? today() : addDays(today(), INTERVAL_DAYS[failBox - 1]),
          lang,
          level,
          firstFailedAt: existing?.firstFailedAt ?? today(),
          lastFailedAt: today(),
          failCount: (existing?.failCount ?? 0) + 1,
        };
        appendError({
          id: r.id,
          lang,
          level,
          kind: r.kind,
          userAnswer: r.userAnswer,
          correctAnswer: r.correctAnswer,
        });
        continue;
      }
      const existing = pool[r.id];
      if (!existing) continue;
      const nextBox = existing.box + 1;
      if (nextBox >= MAX_BOX) {
        pool[r.id] = {
          ...existing,
          box: MAX_BOX - 1,
          due: addDays(today(), INTERVAL_DAYS[MAX_BOX - 1]),
        };
        if (existing.box === MAX_BOX - 2) {
          write(
            'polylingua-srs-mastered-count',
            String(Number(read('polylingua-srs-mastered-count') ?? '0') + 1),
          );
        }
      } else {
        pool[r.id] = {
          ...existing,
          box: nextBox,
          due: addDays(today(), INTERVAL_DAYS[nextBox - 1]),
        };
      }
    }
    writePool(pool);
  }

  // Bandera de módulo, no de document.body.dataset: bajo navegación SPA
  // (Astro <ClientRouter />) el <body> se reemplaza entero en cada
  // navegación, así que un guard basado en dataset nunca protegería el
  // listener de document, que sí persiste durante toda la sesión.
  let progressTrackerStarted = false;

  function initProgressTracker() {
    if (progressTrackerStarted) return;
    progressTrackerStarted = true;

    document.addEventListener('practice-complete', ((e: CustomEvent) => {
      const detail = e.detail ?? {};
      const sessionType: string = detail.sessionType ?? 'lesson';
      const lessonId: string = detail.lessonId ?? '';
      const score: number = detail.score ?? 0;
      const total: number = detail.total ?? 0;
      const results: ResultItem[] = Array.isArray(detail.results) ? detail.results : [];
      const maxStreak: number = detail.maxStreak ?? 0;

      if (maxStreak >= COMBO_THRESHOLD && writeIfNew('polylingua-achievement-combo', 'true')) {
        dispatchAchievement('combo');
      }

      if (sessionType === 'lesson' && lessonId) {
        const key = lessonId.replace(/\//g, '-');
        write(`polylingua-lesson-done-${key}`, today());
        recordLearnedVocab(lessonId);
        if (total > 0 && score === total) {
          if (writeIfNew(`polylingua-lesson-perfect-${key}`, '1')) dispatchAchievement('perfect');
        }
        try {
          const doneToday = Object.keys(localStorage).filter(
            (k) => k.startsWith('polylingua-lesson-done-') && localStorage.getItem(k) === today(),
          ).length;
          if (doneToday >= 3 && writeIfNew('polylingua-achievement-marathon', 'true')) {
            dispatchAchievement('marathon');
          }
        } catch {
          /* localStorage unavailable */
        }
      }

      if (sessionType === 'exam' && lessonId && total > 0 && score / total >= EXAM_PASS_THRESHOLD) {
        if (writeIfNew(`polylingua-level-passed-${lessonId.replace('/', '-')}`, 'true')) {
          dispatchAchievement('level-passed');
        }
      }

      if (sessionType === 'practice-libre') {
        const count = Number(read('polylingua-practice-libre-count') ?? '0') + 1;
        write('polylingua-practice-libre-count', String(count));
        if (
          count >= PRACTICE_LIBRE_GOAL &&
          writeIfNew('polylingua-achievement-practice-libre', 'true')
        ) {
          dispatchAchievement('practice-libre');
        }
      }

      // El repaso de vocabulario usa ids sintéticos (lang: 'vocab') que nunca
      // calzan con el filtro real de repasar.astro — igual evitamos meterlos
      // al pool SRS para no dejar entradas inertes dando vueltas.
      if (sessionType !== 'vocab') updateSrsPool(results);
    }) as EventListener);
  }

  initProgressTracker();
  document.addEventListener('astro:page-load', initProgressTracker);
</script>
