---
import IconToggle from './IconToggle.astro';

interface Props {
  // 'icon' es el botón circular del header (desktop/landscape); 'sheet' es la
  // variante de fila completa para el menú "Más" del bottom nav (portrait) —
  // ambas comparten el mismo comportamiento vía la clase .shadowing-toggle,
  // así que en cualquier página con las dos instancias montadas (header +
  // sheet) se sincronizan en simultáneo.
  variant?: 'icon' | 'sheet';
}

const { variant = 'icon' } = Astro.props;
---

<IconToggle
  toggleClass="shadowing-toggle"
  variant={variant}
  ariaLabel="Modo shadowing: repetir en voz alta antes de seguir"
>
  <span class="icon" aria-hidden="true">🎤</span>
  <span class="sheet-only">Modo shadowing (repetir en voz alta)</span>
</IconToggle>

<style>
  /* La forma del botón la pone IconToggle; acá solo el estado activo, que es
     lo propio de este toggle. Va con :global() porque .shadowing-toggle está
     en el <button> de IconToggle, fuera del scope de este archivo. */
  :global(.shadowing-toggle.is-active) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  :global(.shadowing-toggle-sheet.is-active) {
    color: var(--accent-text);
    background: none;
  }
</style>

<script>
  import { read, write } from '../lib/storage';

  // Puede haber más de un botón .shadowing-toggle montado a la vez (el del
  // header y el del menú "Más") — ver comentario equivalente en
  // SoundToggle.astro / InstallPrompt.astro.
  function allButtons(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>('.shadowing-toggle'));
  }

  function isShadowingEnabled(): boolean {
    return read('polylingua-shadowing-mode') === 'true';
  }

  function syncAll() {
    const active = isShadowingEnabled();
    allButtons().forEach((btn) => {
      btn.setAttribute('aria-pressed', String(active));
      btn.classList.toggle('is-active', active);
    });
  }

  function initShadowingToggle() {
    const btns = allButtons();
    if (btns.length === 0) return;

    btns.forEach((btn) => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';
      btn.addEventListener('click', () => {
        write('polylingua-shadowing-mode', String(!isShadowingEnabled()));
        syncAll();
      });
    });

    syncAll();
  }

  initShadowingToggle();
  document.addEventListener('astro:page-load', initShadowingToggle);
</script>
