---
import IconToggle from './IconToggle.astro';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { getDictionary } from '../i18n';

interface Props {
  // 'icon' es el botón circular del header (desktop/landscape); 'sheet' es la
  // variante de fila completa para el menú "Más" del bottom nav (portrait) —
  // ambas comparten el mismo comportamiento vía la clase .sound-toggle, así
  // que en cualquier página con las dos instancias montadas (header + sheet)
  // se sincronizan en simultáneo.
  variant?: 'icon' | 'sheet';
  // Lo pasan Header y BottomNav; sin esto los textos salían siempre en español.
  userLang?: string;
}

const { variant = 'icon', userLang = ACTIVE_USER_LANGUAGES[0].id } = Astro.props;
const t = getDictionary(userLang as never).widgets.sonido;

// El <script> reescribe el aria-label al alternar, y no puede leer el
// diccionario porque se resuelve en el servidor. Van por data-* al <span>,
// que es lo que este archivo renderiza — el mismo patrón que
// DismissibleBar.astro con [data-bar-strings].
const scriptStrings = JSON.stringify({ silenciar: t.silenciar, activar: t.activar });
---

<IconToggle toggleClass="sound-toggle" variant={variant} ariaLabel={t.silenciar}>
  <span class="icon icon-on" aria-hidden="true" data-sound-strings={scriptStrings}
    >🔊<span class="sheet-only"> {t.silenciar}</span></span
  >
  <span class="icon icon-off" aria-hidden="true"
    >🔇<span class="sheet-only"> {t.activar}</span></span
  >
</IconToggle>

<style>
  /* La forma del botón la pone IconToggle. Acá queda solo qué icono se ve.
     El :global() es porque la clase .sound-toggle va en el <button> que
     renderiza IconToggle, así que no lleva el scope de este archivo; los
     iconos sí, porque salen de acá. */
  .icon-off {
    display: none;
  }

  :global(.sound-toggle.is-muted) .icon-on {
    display: none;
  }

  :global(.sound-toggle.is-muted) .icon-off {
    display: inline;
  }
</style>

<script>
  import { isMuted, setMuted } from '../lib/sound';

  // Puede haber más de un botón .sound-toggle montado a la vez (el del
  // header y el del menú "Más"), así que todo lo que toca visibilidad/estado
  // opera sobre querySelectorAll en vez de un único id, para que ambas
  // instancias queden siempre sincronizadas — ver comentario equivalente en
  // InstallPrompt.astro.
  function allButtons(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>('.sound-toggle'));
  }

  function stringsDe(btn: HTMLButtonElement): { silenciar: string; activar: string } {
    const raw = btn.querySelector<HTMLElement>('[data-sound-strings]')?.dataset.soundStrings;
    try {
      if (raw) return JSON.parse(raw);
    } catch {}
    return { silenciar: 'Silenciar sonidos', activar: 'Activar sonidos' };
  }

  function syncAll() {
    const muted = isMuted();
    allButtons().forEach((btn) => {
      btn.setAttribute('aria-pressed', String(muted));
      btn.classList.toggle('is-muted', muted);
      const s = stringsDe(btn);
      btn.setAttribute('aria-label', muted ? s.activar : s.silenciar);
    });
  }

  function initSoundToggle() {
    const btns = allButtons();
    if (btns.length === 0) return;

    btns.forEach((btn) => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';
      btn.addEventListener('click', () => {
        setMuted(!isMuted());
        syncAll();
      });
    });

    syncAll();
  }

  initSoundToggle();
  document.addEventListener('astro:page-load', initSoundToggle);
</script>
