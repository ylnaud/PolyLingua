---
<button
  type="button"
  class="sound-toggle"
  id="sound-toggle"
  aria-label="Silenciar sonidos"
  aria-pressed="false"
>
  <span class="icon icon-on" aria-hidden="true">🔊</span>
  <span class="icon icon-off" aria-hidden="true">🔇</span>
</button>

<style>
  .sound-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    padding: 0;
  }

  .sound-toggle:hover {
    border-color: var(--accent);
  }

  .icon-off {
    display: none;
  }

  .sound-toggle.is-muted .icon-on {
    display: none;
  }

  .sound-toggle.is-muted .icon-off {
    display: inline;
  }
</style>

<script>
  import { isMuted, setMuted } from '../lib/sound';

  function initSoundToggle() {
    const btn = document.getElementById('sound-toggle');
    if (!btn || btn.dataset.initialized) return;
    btn.dataset.initialized = 'true';

    const sync = () => {
      const muted = isMuted();
      btn.setAttribute('aria-pressed', String(muted));
      btn.classList.toggle('is-muted', muted);
      btn.setAttribute('aria-label', muted ? 'Activar sonidos' : 'Silenciar sonidos');
    };
    sync();

    btn.addEventListener('click', () => {
      setMuted(!isMuted());
      sync();
    });
  }

  initSoundToggle();
  document.addEventListener('astro:page-load', initSoundToggle);
</script>
