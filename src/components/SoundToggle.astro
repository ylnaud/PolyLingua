---
import IconToggle from './IconToggle.astro';

interface Props {
  // 'icon' es el botón circular del header (desktop/landscape); 'sheet' es la
  // variante de fila completa para el menú "Más" del bottom nav (portrait) —
  // ambas comparten el mismo comportamiento vía la clase .sound-toggle, así
  // que en cualquier página con las dos instancias montadas (header + sheet)
  // se sincronizan en simultáneo.
  variant?: 'icon' | 'sheet';
}

const { variant = 'icon' } = Astro.props;
---

<IconToggle toggleClass="sound-toggle" variant={variant} ariaLabel="Silenciar sonidos">
  <span class="icon icon-on" aria-hidden="true"
    >🔊<span class="sheet-only"> Silenciar sonidos</span></span
  >
  <span class="icon icon-off" aria-hidden="true"
    >🔇<span class="sheet-only"> Activar sonidos</span></span
  >
</IconToggle>

<style>
  /* La forma del botón la pone IconToggle. Acá queda solo qué icono se ve.
     El :global() es porque la clase .sound-toggle va en el <button> que
     renderiza IconToggle, así que no lleva el scope de este archivo; los
     iconos sí, porque salen de acá. */
  .icon-off {
    display: none;
  }

  :global(.sound-toggle.is-muted) .icon-on {
    display: none;
  }

  :global(.sound-toggle.is-muted) .icon-off {
    display: inline;
  }
</style>

<script>
  import { isMuted, setMuted } from '../lib/sound';

  // Puede haber más de un botón .sound-toggle montado a la vez (el del
  // header y el del menú "Más"), así que todo lo que toca visibilidad/estado
  // opera sobre querySelectorAll en vez de un único id, para que ambas
  // instancias queden siempre sincronizadas — ver comentario equivalente en
  // InstallPrompt.astro.
  function allButtons(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>('.sound-toggle'));
  }

  function syncAll() {
    const muted = isMuted();
    allButtons().forEach((btn) => {
      btn.setAttribute('aria-pressed', String(muted));
      btn.classList.toggle('is-muted', muted);
      btn.setAttribute('aria-label', muted ? 'Activar sonidos' : 'Silenciar sonidos');
    });
  }

  function initSoundToggle() {
    const btns = allButtons();
    if (btns.length === 0) return;

    btns.forEach((btn) => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';
      btn.addEventListener('click', () => {
        setMuted(!isMuted());
        syncAll();
      });
    });

    syncAll();
  }

  initSoundToggle();
  document.addEventListener('astro:page-load', initSoundToggle);
</script>
