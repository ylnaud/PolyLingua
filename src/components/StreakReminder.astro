---
import DismissibleBar from './DismissibleBar.astro';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { getDictionary } from '../i18n';

// La cáscara (markup y CSS) es de DismissibleBar; acá vive solo lo propio de
// este aviso: cuándo aparece y qué dice. El texto lleva el número de días de
// racha, así que se arma en el cliente sobre [data-bar-text] con los strings
// que van por [data-bar-strings].

interface Props {
  userLang?: string;
}

const { userLang } = Astro.props;
const lang = (userLang ?? ACTIVE_USER_LANGUAGES[0].id) as never;
const t = getDictionary(lang).widgets;

// El CTA lleva al silo del idioma de la página, no siempre al español: desde
// una lección de /en/de/ mandaba a /es, sacando al usuario de su propio silo.
const ctaHref = `/${userLang ?? ACTIVE_USER_LANGUAGES[0].id}`;
---

<DismissibleBar
  id="streak"
  emoji="🔥"
  ctaLabel={t.racha.cta}
  ctaHref={ctaHref}
  dismissLabel={t.barra.cerrar}
  strings={{ texto: t.racha.texto, textos: t.racha.textos }}
/>

<script>
  import { today, yesterday, read, write } from '../lib/storage';

  function getStreak(): number {
    return Number(read('polylingua-streak-count') ?? '0');
  }

  function practicedToday(): boolean {
    return read('polylingua-progress-date') === today();
  }

  // Solo avisa cuando la racha está genuinamente en riesgo de romperse hoy:
  // hay racha activa, todavía no se practicó hoy, y la última práctica fue
  // ayer (si fue antes de ayer la racha ya se rompió — el próximo
  // practice-complete la reinicia en 1 sola, no tiene sentido "salvarla").
  function streakAtRisk(): boolean {
    const streak = getStreak();
    if (streak <= 0 || practicedToday()) return false;
    return read('polylingua-streak-last-date') === yesterday(today());
  }

  function dismissedToday(): boolean {
    return read('polylingua-streak-reminder-dismissed') === today();
  }

  function initStreakReminder() {
    const el = document.querySelector<HTMLElement>('[data-bar="streak"]');
    const text = el?.querySelector<HTMLElement>('[data-bar-text]');
    const dismissBtn = el?.querySelector<HTMLButtonElement>('[data-bar-dismiss]');
    if (!el || !text || !dismissBtn) return;

    const streak = getStreak();
    const show = streakAtRisk() && !dismissedToday();
    el.hidden = !show;
    if (show) {
      const s = JSON.parse(el.dataset.barStrings ?? '{}');
      const plantilla = (streak === 1 ? s.texto : s.textos) ?? '';
      text.textContent = plantilla.replace('{n}', String(streak));
    }

    if (!dismissBtn.dataset.initialized) {
      dismissBtn.dataset.initialized = 'true';
      dismissBtn.addEventListener('click', () => {
        write('polylingua-streak-reminder-dismissed', today());
        el.hidden = true;
      });
    }
  }

  initStreakReminder();
  document.addEventListener('astro:page-load', initStreakReminder);
</script>
