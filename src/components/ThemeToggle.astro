---
import IconToggle from './IconToggle.astro';

interface Props {
  // 'icon' es el botón circular del header (desktop/landscape); 'sheet' es la
  // variante de fila completa para el menú "Más" del bottom nav (portrait) —
  // ambas comparten el mismo comportamiento vía la clase .theme-toggle, así
  // que en cualquier página con las dos instancias montadas (header + sheet)
  // se sincronizan en simultáneo.
  variant?: 'icon' | 'sheet';
}

const { variant = 'icon' } = Astro.props;
---

<IconToggle
  toggleClass="theme-toggle"
  variant={variant}
  ariaLabel="Cambiar entre modo oscuro y modo claro"
>
  <span class="icon icon-sun" aria-hidden="true"
    >☀️<span class="sheet-only"> Cambiar a modo claro</span></span
  >
  <span class="icon icon-moon" aria-hidden="true"
    >🌙<span class="sheet-only"> Cambiar a modo oscuro</span></span
  >
</IconToggle>

<style>
  /* La forma del botón la pone IconToggle. El swap de iconos se hace con el
     atributo data-theme del <html> y no con una clase que ponga el JS, para
     que el icono correcto ya salga pintado en el primer frame: el script
     inline que restaura el tema corre antes que este componente, así que no
     hay parpadeo. */
  .icon-moon {
    display: none;
  }

  :root[data-theme='light'] .icon-sun {
    display: none;
  }

  :root[data-theme='light'] .icon-moon {
    display: inline;
  }
</style>

<script>
  // Puede haber más de un botón .theme-toggle montado a la vez (el del
  // header y el del menú "Más") — el swap de íconos ya lo resuelve un
  // selector CSS global sobre :root[data-theme], así que lo único que hay
  // que sincronizar entre instancias es aria-pressed. Ver comentario
  // equivalente en InstallPrompt.astro / SoundToggle.astro.
  function allButtons(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>('.theme-toggle'));
  }

  function syncAll() {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    allButtons().forEach((btn) => btn.setAttribute('aria-pressed', String(isLight)));
  }

  function initThemeToggle() {
    const btns = allButtons();
    if (btns.length === 0) return;

    btns.forEach((btn) => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';
      btn.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('polylingua-theme', next);
        } catch (e) {
          /* localStorage unavailable */
        }
        syncAll();
      });
    });

    syncAll();
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
