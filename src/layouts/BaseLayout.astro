---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgressTracker from '../components/ProgressTracker.astro';
import SoundEffects from '../components/SoundEffects.astro';
import CookieNotice from '../components/CookieNotice.astro';
import ScrollTopButton from '../components/ScrollTopButton.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  structuredData,
  noindex = false,
} = Astro.props;

const siteName = 'PolyLingua';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(path, Astro.site);
const ogImage = new URL('/og-image.svg', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PolyLingua" />

    <script is:inline data-astro-rerun>
      (function () {
        try {
          var stored = localStorage.getItem('polylingua-theme');
          var theme = stored || 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    )}

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ProgressTracker />
    <SoundEffects />
    <CookieNotice />
    <ScrollTopButton />
    <BottomNav />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then((registration) => {
            // El navegador solo revisa si hay un sw.js nuevo cada ~24h por su
            // cuenta — por eso una PWA instalada podía quedar pegada a una
            // versión vieja durante todo ese tiempo. Forzar la revisión en
            // cada carga, y recargar una sola vez apenas el service worker
            // nuevo toma el control (gracias a skipWaiting+clients.claim en
            // sw.js), hace que la actualización sea automática sin tener que
            // desinstalar ni esperar.
            registration.update().catch(() => {});

            // Una PWA "reabierta" desde el ícono no siempre dispara una carga
            // nueva de página — en Android/Chrome, si el sistema mantuvo la
            // app viva en segundo plano, volver a abrirla solo trae la
            // pestaña existente al frente sin recargar nada, así que el
            // 'load' de arriba nunca se vuelve a disparar. Revisar también
            // cuando la pestaña vuelve a estar visible cubre ese caso.
            document.addEventListener('visibilitychange', () => {
              if (document.visibilityState === 'visible') registration.update().catch(() => {});
            });

            let refreshed = false;
            navigator.serviceWorker.addEventListener('controllerchange', () => {
              if (refreshed) return;
              refreshed = true;
              window.location.reload();
            });
          }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
