---
import { ClientRouter } from 'astro:transitions';
import { ACTIVE_USER_LANGUAGES, USER_LANGUAGE_MAP } from '../data/userLanguages';
import Header from '../components/Header.astro';
import StreakReminder from '../components/StreakReminder.astro';
import EngineTracker from '../components/EngineTracker.astro';
import DrillTutor from '../components/DrillTutor.astro';
import BackupReminder from '../components/BackupReminder.astro';
import Footer from '../components/Footer.astro';
import ProgressTracker from '../components/ProgressTracker.astro';
import SoundEffects from '../components/SoundEffects.astro';
import CookieNotice from '../components/CookieNotice.astro';
import ScrollTopButton from '../components/ScrollTopButton.astro';
import BottomNav from '../components/BottomNav.astro';
import BaseSEO from '../components/BaseSEO.astro';
import '../styles/global.css';

import type { SiloContext } from '../lib/siloPath';

interface Props {
  title: string;
  description: string;
  path?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
  ogType?: string;
  ogImage?: string;
  // Solo lo pasan las páginas del silo [userLang]/[targetLang]/... — inyecta
  // hreflang cruzados + JSON-LD BreadcrumbList/LearningResource vía BaseSEO.
  siloContext?: SiloContext;
  // Idioma de INTERFAZ de la página, para las que no son del silo pero sí
  // están traducidas: las herramientas de /[userLang]/... Sin esto, la
  // cáscara (header, footer, nav) caía siempre al idioma principal, así que
  // un usuario en /de/es/vocabulario veía la navegación en español.
  userLang?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  structuredData,
  noindex = false,
  ogType = 'website',
  ogImage: ogImagePath = '/og-image.png',
  siloContext,
  userLang,
} = Astro.props;

const siteName = 'PolyLingua';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(path, Astro.site);

// El <html lang> tiene que declarar el idioma de la INTERFAZ, no uno fijo.
// Estaba hardcodeado a "es", así que una lección del silo alemán salía
// etiquetada como española: contenido en alemán con señal de idioma
// contradictoria para buscadores y lectores de pantalla.
const pageLang = siloContext?.userLang ?? userLang ?? ACTIVE_USER_LANGUAGES[0].id;
const htmlLang = USER_LANGUAGE_MAP[pageLang as keyof typeof USER_LANGUAGE_MAP]?.bcp47 ?? 'es-ES';

// El silo de un idioma de interfaz INACTIVO no se indexa.
//
// astro.config.mjs ya lo excluye del sitemap, y por buenos motivos: nadie
// enlaza a esas páginas, y su cáscara cae al diccionario español, así que
// /en/de/a1 y /es/de/a1 salían con el MISMO título y la MISMA descripción.
// Pero el sitemap solo es una sugerencia: sin noindex, Google puede llegar
// igual y quedarse con 91 duplicados del sitio que sí tiene tráfico.
//
// Se deriva de USER_LANGUAGES, la misma lista de la que sale el filtro del
// sitemap, para que al marcar un idioma como `active: true` las dos cosas
// vuelvan juntas y no haya que acordarse de esta.
const inactiveUserLang =
  USER_LANGUAGE_MAP[pageLang as keyof typeof USER_LANGUAGE_MAP]?.active === false;
const noindexFinal = noindex || inactiveUserLang;
const ogImage = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    {noindexFinal && <meta name="robots" content="noindex, nofollow" />}
    {!noindexFinal && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PolyLingua" />

    <script is:inline data-astro-rerun>
      (function () {
        try {
          var stored = localStorage.getItem('polylingua-theme');
          var theme = stored || 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
        />
      )
    }

    {siloContext && <BaseSEO {...siloContext} />}

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header userLang={pageLang} />
    <StreakReminder />
    <BackupReminder />
    <main id="main">
      <slot />
    </main>
    <Footer userLang={pageLang} />
    <ProgressTracker />
    <EngineTracker />
    <DrillTutor />
    <SoundEffects />
    <CookieNotice userLang={pageLang} />
    <ScrollTopButton />
    <BottomNav userLang={pageLang} />
    <script is:inline>
      // El Service Worker se actualiza solo: hace skipWaiting al instalarse, y
      // como las páginas se sirven de la red primero, la siguiente navegación
      // ya trae lo último publicado.
      //
      // Antes había acá un toast "Nueva versión disponible" y una recarga
      // automática al cambiar de worker. Los dos sobran ahora, y la recarga
      // encima era hostil: podía saltar en mitad de un ejercicio.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/sw.js')
            .then(function (registration) {
              registration.update().catch(function () {});

              document.addEventListener('visibilitychange', function () {
                if (document.visibilityState === 'visible')
                  registration.update().catch(function () {});
              });
            })
            .catch(function () {});
        });
      }
    </script>
  </body>
</html>
