---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import StreakReminder from '../components/StreakReminder.astro';
import BackupReminder from '../components/BackupReminder.astro';
import Footer from '../components/Footer.astro';
import ProgressTracker from '../components/ProgressTracker.astro';
import SoundEffects from '../components/SoundEffects.astro';
import CookieNotice from '../components/CookieNotice.astro';
import ScrollTopButton from '../components/ScrollTopButton.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  structuredData,
  noindex = false,
  ogType = 'website',
  ogImage: ogImagePath = '/og-image.png',
} = Astro.props;

const siteName = 'PolyLingua';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(path, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PolyLingua" />

    <script is:inline data-astro-rerun>
      (function () {
        try {
          var stored = localStorage.getItem('polylingua-theme');
          var theme = stored || 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header />
    <StreakReminder />
    <BackupReminder />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ProgressTracker />
    <SoundEffects />
    <CookieNotice />
    <ScrollTopButton />
    <BottomNav />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/sw.js')
            .then(function (registration) {
              registration.update().catch(function () {});

              document.addEventListener('visibilitychange', function () {
                if (document.visibilityState === 'visible')
                  registration.update().catch(function () {});
              });

              function showUpdateToast(worker) {
                if (document.getElementById('sw-update-toast')) return;
                var toast = document.createElement('div');
                toast.id = 'sw-update-toast';
                toast.className = 'sw-update-toast';
                toast.setAttribute('role', 'alert');
                toast.innerHTML =
                  '<span>\u{1F504} Nueva versión disponible</span>' +
                  '<button type="button" class="sw-update-btn">Actualizar</button>' +
                  '<button type="button" class="sw-update-close" aria-label="Cerrar">×</button>';
                document.body.appendChild(toast);
                toast.querySelector('.sw-update-btn').addEventListener('click', function () {
                  worker.postMessage({ type: 'SKIP_WAITING' });
                });
                toast.querySelector('.sw-update-close').addEventListener('click', function () {
                  toast.remove();
                });
              }

              if (registration.waiting) showUpdateToast(registration.waiting);

              registration.addEventListener('updatefound', function () {
                var newWorker = registration.installing;
                if (!newWorker) return;
                newWorker.addEventListener('statechange', function () {
                  if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                    showUpdateToast(newWorker);
                  }
                });
              });

              var refreshed = false;
              navigator.serviceWorker.addEventListener('controllerchange', function () {
                if (refreshed) return;
                refreshed = true;
                window.location.reload();
              });
            })
            .catch(function () {});
        });
      }
    </script>
  </body>
</html>
