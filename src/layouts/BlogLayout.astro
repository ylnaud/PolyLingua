---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  tags?: string[];
  path: string;
  ogImage?: string;
}

const { title, description, publishDate, updatedDate, tags = [], path, ogImage } = Astro.props;

const siteURL = Astro.site!.origin;

const dateFormatter = new Intl.DateTimeFormat('es', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: publishDate.toISOString(),
      ...(updatedDate && { dateModified: updatedDate.toISOString() }),
      author: {
        '@type': 'Organization',
        name: 'PolyLingua',
      },
      publisher: {
        '@type': 'Organization',
        name: 'PolyLingua',
      },
      mainEntityOfPage: `${siteURL}${path}`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteURL },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteURL}/blog` },
        { '@type': 'ListItem', position: 3, name: title, item: `${siteURL}${path}` },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${title} | PolyLingua`}
  description={description}
  path={path}
  structuredData={structuredData}
  ogType="article"
  ogImage={ogImage}
>
  <article class="post container">
    <Breadcrumbs
      items={[
        { name: 'Inicio', href: '/' },
        { name: 'Blog', href: '/blog' },
      ]}
    />

    <header class="post-head">
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta">
        <time datetime={publishDate.toISOString()}>{dateFormatter.format(publishDate)}</time>
        {
          tags.length > 0 && (
            <ul class="tags">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="content">
      <slot />
    </div>

    <RelatedLinks route={path} title="Empezá el curso" />

    <footer class="post-nav">
      <a class="btn btn-ghost" href="/blog">← Volver al blog</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    padding-block: 2.5rem 4rem;
  }

  .post-head h1 {
    font-size: clamp(1.9rem, 4.2vw, 2.6rem);
    margin: 0.5rem 0 0.6rem;
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0 0 0.9rem;
  }

  /* La fecha y las etiquetas son dos grupos, no una lista sola: en móvil las
     etiquetas bajan a su propia línea. Por eso se separan con el hueco y no
     con un punto — un punto de enlace se quedaría colgando al principio de la
     segunda línea. */
  .meta {
    display: flex;
    align-items: center;
    gap: 0.35rem 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Mismo cambio que en la portada del blog: eran píldoras con borde y fondo,
     que parecían botones sin serlo. */
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    padding: 0;
    margin: 0;
  }

  .tags li + li::before {
    content: '·';
    margin-right: 0.5rem;
    opacity: 0.55;
  }

  .content {
    margin-top: 2.25rem;
  }

  .content :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.4rem;
  }

  .content :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.1rem;
  }

  .content :global(p) {
    margin: 0.85rem 0;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.25rem;
  }

  .content :global(a) {
    color: var(--accent-text);
  }

  .post-nav {
    margin-top: 2.5rem;
  }
</style>
