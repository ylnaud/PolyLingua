---
import BaseLayout from './BaseLayout.astro';
import Practice from '../components/Practice.astro';
import { LEVEL_MAP } from '../data/levels';
import { LANGUAGE_MAP } from '../data/languages';

interface QuizQuestion {
  question: string;
  options: string[];
  answerIndex: number;
  explanation: string;
}

interface Props {
  language: 'de' | 'en' | 'fr' | 'it' | 'pt';
  level: 'a1' | 'a2' | 'b1' | 'b2' | 'c1' | 'c2';
  title: string;
  description: string;
  grammarTopic: string;
  funFact: string;
  minutes: number;
  quiz: QuizQuestion[];
  exercises?: any[];
  lessonId?: string;
  path: string;
}

const {
  language,
  level,
  title,
  description,
  grammarTopic,
  funFact,
  minutes,
  quiz,
  exercises = [],
  lessonId = '',
  path,
} = Astro.props;
const levelMeta = LEVEL_MAP[level];
const languageMeta = LANGUAGE_MAP[language];

const siteURL = 'https://poly-lingua.vercel.app';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LearningResource',
      name: title,
      description,
      educationalLevel: levelMeta.name,
      learningResourceType: 'Lesson',
      inLanguage: language,
      teaches: grammarTopic,
      isPartOf: {
        '@type': 'Course',
        name: `${languageMeta.name} ${levelMeta.name} — PolyLingua`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Idiomas', item: `${siteURL}/idiomas` },
        {
          '@type': 'ListItem',
          position: 2,
          name: languageMeta.name,
          item: `${siteURL}/idiomas/${language}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: levelMeta.name,
          item: `${siteURL}/idiomas/${language}/${level}`,
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: title,
          item: `${siteURL}${path}`,
        },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <article class="lesson container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/idiomas">Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/idiomas/${language}`}>{languageMeta.flag} {languageMeta.name}</a>
      <span aria-hidden="true">/</span>
      <a href={`/idiomas/${language}/${level}`}>{levelMeta.name}</a>
    </nav>

    <header class="lesson-head">
      <span class="badge" style={`border-color:${levelMeta.color}; color:${levelMeta.color}`}>
        {levelMeta.emoji} {levelMeta.name}
      </span>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta">
        <span>📘 {grammarTopic}</span>
        <span>⏱️ {minutes} min</span>
      </div>
    </header>

    <div class="fun-fact card">
      <span class="eyebrow">💡 Truco para no aburrirte</span>
      <p>{funFact}</p>
    </div>

    <div class="content">
      <slot />
    </div>

    <Practice
      quiz={quiz}
      exercises={exercises}
      minutes={minutes}
      lessonId={lessonId}
      sessionType="lesson"
      lang={languageMeta.bcp47}
    />

    <footer class="lesson-nav">
      <a class="btn btn-ghost" href={`/idiomas/${language}/${level}`}>← Volver a {languageMeta.name} {levelMeta.name}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .lesson {
    max-width: 760px;
    padding-block: 2.5rem 4rem;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumbs a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .breadcrumbs a:hover {
    color: var(--accent-text);
  }

  .lesson-head h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0.75rem 0 0.5rem;
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 0 0 0.75rem;
  }

  .meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .fun-fact {
    margin: 1.75rem 0;
    padding: 1.1rem 1.25rem;
    background: rgba(255, 206, 58, 0.08);
    border-color: rgba(255, 206, 58, 0.35);
  }

  .fun-fact p {
    margin: 0.35rem 0 0;
  }

  .content :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.4rem;
  }

  .content :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.1rem;
  }

  .content :global(p) {
    margin: 0.85rem 0;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.25rem;
  }

  .lesson-nav {
    margin-top: 2.5rem;
  }
</style>
