---
import BaseLayout from './BaseLayout.astro';
import Practice from '../components/Practice.astro';
import PhraseBank from '../components/PhraseBank.astro';
import AdSlot from '../components/AdSlot.astro';
import { LEVEL_MAP } from '../data/levels';
import { LANGUAGE_MAP, type LanguageId } from '../data/languages';

interface QuizQuestion {
  question: string;
  options: string[];
  answerIndex: number;
  explanation: string;
}

interface VocabularyItem {
  term: string;
  translation: string;
}

interface Phrase {
  text: string;
  es: string;
  say?: string;
  note?: string;
}

interface Props {
  userLang: string;
  language: LanguageId;
  level: 'a1' | 'a2' | 'b1' | 'b2' | 'c1' | 'c2';
  title: string;
  description: string;
  grammarTopic: string;
  funFact: string;
  minutes: number;
  quiz: QuizQuestion[];
  exercises?: any[];
  vocabulary?: VocabularyItem[];
  phrases?: Phrase[];
  situation?: string;
  lessonId?: string;
  path: string;
  prevLesson?: { title: string; href: string } | null;
  nextLesson?: { title: string; href: string } | null;
  ogImage?: string;
}

const {
  userLang,
  language,
  level,
  title,
  description,
  grammarTopic,
  funFact,
  minutes,
  quiz,
  exercises = [],
  vocabulary = [],
  phrases = [],
  situation,
  lessonId = '',
  path,
  prevLesson = null,
  nextLesson = null,
  ogImage,
} = Astro.props;
const levelMeta = LEVEL_MAP[level];
const languageMeta = LANGUAGE_MAP[language];

const siteURL = Astro.site!.origin;

const courseURL = `${siteURL}/${userLang}/${language}/${level}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Course',
      '@id': `${courseURL}#course`,
      name: `Curso de ${languageMeta.name} Interactivo — PolyLingua`,
      description: `Aprende ${languageMeta.name.toLowerCase()} de A1 a C2 gratis con gramática divertida y ejercicios interactivos.`,
      url: courseURL,
      publisher: { '@type': 'Organization', name: 'PolyLingua', url: siteURL },
    },
  ],
};

const restPath = `/${level}/${path.split('/').pop()}`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  structuredData={structuredData}
  ogImage={ogImage}
  siloContext={{
    userLang,
    targetLang: language,
    restPath,
    breadcrumbs: [
      { name: 'Idiomas', href: `/${userLang}` },
      { name: languageMeta.name, href: `/${userLang}/${language}` },
      { name: levelMeta.name, href: courseURL.replace(siteURL, '') },
      { name: title, href: path },
    ],
    learningResource: {
      title,
      description,
      minutes,
      grammarTopic,
      situation,
      level,
      quiz,
    },
  }}
>
  <article class="lesson container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href={`/${userLang}`}>Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/${userLang}/${language}`}>{languageMeta.flag} {languageMeta.name}</a>
      <span aria-hidden="true">/</span>
      <a href={`/${userLang}/${language}/${level}`}>{levelMeta.name}</a>
    </nav>

    <header class="lesson-head">
      <span class="badge" style={`border-color:${levelMeta.color}; color:${levelMeta.color}`}>
        {levelMeta.emoji}
        {levelMeta.name}
      </span>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta">
        <span>{situation ? `🗺️ ${situation}` : `📘 ${grammarTopic}`}</span>
        <span>⏱️ {minutes} min</span>
      </div>
    </header>

    <div class="fun-fact card texture-noise">
      <span class="eyebrow">💡 Truco para no aburrirte</span>
      <p>{funFact}</p>
    </div>

    <div class="content">
      <slot />
    </div>

    {phrases.length > 0 && <PhraseBank phrases={phrases} lang={languageMeta.bcp47} />}

    {
      vocabulary.length > 0 && (
        <>
          <div
            class="vocab-carousel card"
            data-vocab-carousel
            data-vocabulary={JSON.stringify(vocabulary)}
            data-lang={languageMeta.bcp47}
          >
            <span class="eyebrow">📚 Vocabulario de esta lección</span>
            <div class="vocab-counter" data-vocab-counter />
            <div class="vocab-card-inner">
              <span class="vocab-term" data-vocab-term />
              <span class="vocab-translation" data-vocab-translation />
              <button
                type="button"
                class="speak-btn vocab-speak"
                data-vocab-speak
                aria-label="Escuchar"
              >
                🔊 Escuchar
              </button>
            </div>
            <div class="vocab-nav">
              <button type="button" class="btn btn-ghost vocab-prev" data-vocab-prev disabled>
                ← Anterior
              </button>
              <button type="button" class="btn btn-primary vocab-next" data-vocab-next>
                Siguiente →
              </button>
            </div>
          </div>
          <div hidden data-vocab-tracker data-vocabulary={JSON.stringify(vocabulary)} />
        </>
      )
    }

    <AdSlot slotId={`lesson-top-${language}-${level}`} />

    <Practice
      quiz={quiz}
      exercises={exercises}
      minutes={minutes}
      lessonId={lessonId}
      sessionType="lesson"
      lang={languageMeta.bcp47}
    />

    <AdSlot slotId={`lesson-bottom-${language}-${level}`} />

    <footer class="lesson-nav">
      {
        prevLesson ? (
          <a class="btn btn-ghost" href={prevLesson.href}>
            ← {prevLesson.title}
          </a>
        ) : (
          <a class="btn btn-ghost" href={`/${userLang}/${language}/${level}`}>
            ← {languageMeta.name} {levelMeta.name}
          </a>
        )
      }
      {
        nextLesson && (
          <a class="btn btn-primary" href={nextLesson.href}>
            {nextLesson.title} →
          </a>
        )
      }
    </footer>
  </article>
</BaseLayout>

<style>
  .lesson {
    max-width: 760px;
    padding-block: 2.5rem 4rem;
  }

  .lesson-head h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0.75rem 0 0.5rem;
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 0 0 0.75rem;
  }

  .meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .fun-fact {
    margin: 1.75rem 0;
    padding: 1.1rem 1.25rem;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .fun-fact p {
    margin: 0.35rem 0 0;
  }

  .vocab-carousel {
    margin: 1.75rem 0;
    padding: 1.25rem;
    text-align: center;
  }

  .vocab-counter {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0.5rem 0 0.75rem;
  }

  .vocab-card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem;
    min-height: 120px;
    justify-content: center;
  }

  .vocab-term {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .vocab-translation {
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .vocab-speak {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    cursor: pointer;
    background: none;
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 8px;
    padding: 0.4rem 0.8rem;
    color: var(--text);
  }

  .vocab-nav {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .vocab-prev,
  .vocab-next {
    font-size: 0.9rem;
    padding: 0.5rem 1.1rem;
  }

  .vocab-prev:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .content :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.4rem;
  }

  .content :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.1rem;
  }

  .content :global(p) {
    margin: 0.85rem 0;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.25rem;
  }

  .content :global(strong) {
    color: var(--accent-text);
    font-weight: 700;
  }

  .lesson-nav {
    margin-top: 2.5rem;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>

<script>
  import { speak } from '../lib/sound';

  function initVocabCarousel() {
    const carousel = document.querySelector<HTMLElement>('[data-vocab-carousel]');
    if (!carousel || carousel.dataset.initialized) return;
    carousel.dataset.initialized = 'true';
    let items: { term: string; translation: string }[];
    try {
      items = JSON.parse(carousel.dataset.vocabulary ?? '[]');
    } catch {
      return;
    }
    if (items.length === 0) return;

    const lang = carousel.dataset.lang ?? 'de';
    const counter = carousel.querySelector<HTMLElement>('[data-vocab-counter]')!;
    const term = carousel.querySelector<HTMLElement>('[data-vocab-term]')!;
    const translation = carousel.querySelector<HTMLElement>('[data-vocab-translation]')!;
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-vocab-prev]')!;
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-vocab-next]')!;
    const speakBtn = carousel.querySelector<HTMLButtonElement>('[data-vocab-speak]')!;

    let current = 0;

    function render() {
      counter.textContent = `${current + 1} / ${items.length}`;
      term.textContent = items[current].term;
      translation.textContent = items[current].translation;
      prevBtn.disabled = current === 0;
      nextBtn.textContent = current === items.length - 1 ? 'Empezar práctica →' : 'Siguiente →';
    }

    prevBtn.addEventListener('click', () => {
      if (current > 0) {
        current--;
        render();
      }
    });
    nextBtn.addEventListener('click', () => {
      if (current < items.length - 1) {
        current++;
        render();
      } else {
        document.querySelector('[data-practice]')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
    speakBtn.addEventListener('click', () => {
      speak(items[current].term, lang);
    });

    render();
  }

  initVocabCarousel();
  document.addEventListener('astro:page-load', initVocabCarousel);
</script>
