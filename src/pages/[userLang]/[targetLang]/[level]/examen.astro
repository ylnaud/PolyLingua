---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Practice from '../../../../components/Practice.astro';
import { LEVELS, LEVEL_MAP } from '../../../../data/levels';
import { LANGUAGE_MAP } from '../../../../data/languages';
import { parseLessonId } from '../../../../lib/lessonPath';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');
  const combos = new Set<string>();
  for (const lesson of allLessons) {
    const { userLang, targetLang, level } = parseLessonId(lesson.id);
    combos.add(`${userLang}/${targetLang}/${level}`);
  }
  return Array.from(combos).map((combo) => {
    const [userLang, targetLang, level] = combo.split('/');
    return { params: { userLang, targetLang, level } };
  });
}

const { userLang, targetLang, level } = Astro.params;
const languageMeta = LANGUAGE_MAP[targetLang as keyof typeof LANGUAGE_MAP];
const levelMeta = LEVEL_MAP[level as keyof typeof LEVEL_MAP];

const allLessons = await getCollection('lessons');
const lessons = allLessons
  .filter((l) => l.data.language === targetLang && l.data.level === level)
  .sort((a, b) => a.data.order - b.data.order);

const PER_LESSON_CHOICE = 2;
const PER_LESSON_OTHER = 1;

interface PoolItem {
  kind: string;
  data: unknown;
  itemId: string;
}

const perLessonPools: PoolItem[][] = lessons.map((l, lessonIndex) => {
  const full: { kind: string; data: unknown }[] = [
    ...l.data.quiz.map((d) => ({ kind: 'choice', data: d })),
    ...l.data.exercises.map((d) => ({ kind: d.type, data: d })),
  ];
  // Cada ítem conserva su índice en el array combinado quiz+exercises: es el
  // mismo índice que usan la página de la lección y practica-libre.astro para
  // calcular el itemId, así el pool de SRS (indexado por ese id) sigue
  // apuntando a la entrada real en vez de crear una fantasma.
  const withIndex = full.map((it, idx) => ({ ...it, idx }));
  const choiceItems = withIndex.filter((it) => it.kind === 'choice');
  const otherItems = withIndex.filter((it) => it.kind !== 'choice');

  // Todas las lecciones listan sus exercises en el mismo orden (fill-blank,
  // fill-blank, match, write, order), así que tomar siempre el primero
  // volvería a dejar match/write/order fuera del examen. Rotar el punto de
  // partida según la posición de la lección dentro del nivel para que el
  // examen combine varios tipos a lo largo de sus lecciones.
  const selectedOther: typeof otherItems = [];
  for (let k = 0; k < PER_LESSON_OTHER && otherItems.length > 0; k += 1) {
    selectedOther.push(otherItems[(lessonIndex + k) % otherItems.length]);
  }
  const choiceSlots = PER_LESSON_CHOICE + (PER_LESSON_OTHER - selectedOther.length);
  const selectedChoice = choiceItems.slice(0, choiceSlots);

  return [...selectedChoice, ...selectedOther].map((it) => ({
    kind: it.kind,
    data: it.data,
    itemId: `${l.id}#${it.kind}-${it.idx}`,
  }));
});

const examItems = perLessonPools.flat();
const examChoice = examItems.filter((i) => i.kind === 'choice');
const examOther = examItems.filter((i) => i.kind !== 'choice');
const examQuiz = examChoice.map((i) => i.data) as any[];
const examExercises = examOther.map((i) => ({ type: i.kind, ...(i.data as object) })) as any[];
const examItemIds = [...examChoice.map((i) => i.itemId), ...examOther.map((i) => i.itemId)];
const estimatedMinutes = Math.max(5, Math.round(examItems.length * 0.5));

const levelIndex = LEVELS.findIndex((l) => l.id === level);
const nextLevel = levelIndex >= 0 ? LEVELS[levelIndex + 1] : undefined;
---

<BaseLayout
  title={`Examen de ${languageMeta?.name} — ${levelMeta?.name}`}
  description={`Examen final de ${levelMeta?.name} de ${languageMeta?.name}: combina todo lo aprendido en el nivel. Apruébalo con 70% o más para desbloquear el siguiente nivel.`}
  path={`/${userLang}/${targetLang}/${level}/examen`}
  noindex
>
  <section class="container exam-head">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href={`/${userLang}`}>Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/${userLang}/${targetLang}`}>{languageMeta?.flag} {languageMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <a href={`/${userLang}/${targetLang}/${level}`}>{levelMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <span>Examen</span>
    </nav>
    <span class="emoji" aria-hidden="true">🏆</span>
    <h1>Examen de nivel — {levelMeta?.name}</h1>
    <p class="desc">
      Este examen combina preguntas y ejercicios de las {lessons.length} lecciones de{' '}
      {levelMeta?.name}. Necesitas <strong>70% o más</strong> para aprobar
      {
        nextLevel ? (
          <>
            {' '}
            y desbloquear <strong>{nextLevel.name}</strong>
          </>
        ) : (
          <> y completar el idioma</>
        )
      }.
    </p>
  </section>

  <section class="container exam-body">
    <Practice
      quiz={examQuiz}
      exercises={examExercises}
      minutes={estimatedMinutes}
      sessionType="exam"
      lessonId={`${targetLang}/${level}`}
      itemIds={examItemIds}
      lang={languageMeta?.bcp47}
    />

    <div class="exam-result" data-exam-result hidden>
      <div class="card result-card" data-result-pass hidden>
        <p class="result-emoji">🎉</p>
        <h2>¡Aprobado!</h2>
        {
          nextLevel ? (
            <p>
              Desbloqueaste <strong>{nextLevel.name}</strong>.
            </p>
          ) : (
            <p>Completaste todo el curso de {languageMeta?.name}. ¡Felicidades!</p>
          )
        }
        <div class="result-actions">
          {
            nextLevel && (
              <a class="btn btn-primary" href={`/${userLang}/${targetLang}/${nextLevel.id}`}>
                Ir a {nextLevel.name} →
              </a>
            )
          }
          <a class="btn btn-ghost" href="/logros">Ver mis logros</a>
        </div>
      </div>
      <div class="card result-card" data-result-fail hidden>
        <p class="result-emoji">💪</p>
        <h2>Todavía no</h2>
        <p>Necesitas al menos 70% para aprobar. Tus fallos ya quedaron guardados para repasar.</p>
        <div class="result-actions">
          <a class="btn btn-primary" href={`/${userLang}/${targetLang}/${level}/examen`}
            >Reintentar</a
          >
          <a class="btn btn-ghost" href={`/idiomas/${targetLang}/repasar`}>Repasar ahora</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const EXAM_PASS_THRESHOLD = 0.7;

  document.addEventListener('practice-complete', ((e: CustomEvent) => {
    const { score = 0, total = 0, sessionType } = e.detail ?? {};
    if (sessionType !== 'exam' || total === 0) return;
    const resultBox = document.querySelector<HTMLElement>('[data-exam-result]');
    const passCard = document.querySelector<HTMLElement>('[data-result-pass]');
    const failCard = document.querySelector<HTMLElement>('[data-result-fail]');
    if (!resultBox) return;
    resultBox.hidden = false;
    const passed = score / total >= EXAM_PASS_THRESHOLD;
    if (passCard) passCard.hidden = !passed;
    if (failCard) failCard.hidden = passed;
  }) as EventListener);
</script>

<style>
  .exam-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .exam-body {
    max-width: 680px;
    padding-block: 0 4rem;
  }

  .result-card {
    text-align: center;
    padding: 2rem 1.5rem;
    margin-top: 1.5rem;
  }

  .result-emoji {
    font-size: 2.5rem;
    margin: 0;
  }

  .result-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
</style>
