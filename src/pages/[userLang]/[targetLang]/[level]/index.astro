---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { LEVEL_MAP } from '../../../../data/levels';
import { LANGUAGE_MAP } from '../../../../data/languages';
import { parseLessonId } from '../../../../lib/lessonPath';
import { getDictionary } from '../../../../i18n';
import { getCollection } from 'astro:content';
import { UNITS, type UnitMeta } from '../../../../data/units';
import { TSA } from '../../../../data/tsa';

export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');
  const combos = new Set<string>();
  for (const lesson of allLessons) {
    const { userLang, targetLang, level } = parseLessonId(lesson.id);
    combos.add(`${userLang}/${targetLang}/${level}`);
  }
  return Array.from(combos).map((combo) => {
    const [userLang, targetLang, level] = combo.split('/');
    return { params: { userLang, targetLang, level } };
  });
}

const { userLang, targetLang, level } = Astro.params;
const dict = getDictionary(userLang as never);
const levelName = dict.levelNames[level as keyof typeof dict.levelNames];
const languageName = dict.languageNames[targetLang as keyof typeof dict.languageNames];
const languageMeta = LANGUAGE_MAP[targetLang as keyof typeof LANGUAGE_MAP];
const levelMeta = LEVEL_MAP[level as keyof typeof LEVEL_MAP];

const allLessons = await getCollection('lessons');
const lessons = allLessons
  .filter(
    (l) =>
      l.data.language === targetLang &&
      l.data.level === level &&
      parseLessonId(l.id).userLang === userLang,
  )
  .sort((a, b) => a.data.order - b.data.order);

const unitMetas = UNITS[`${targetLang}-${level}`] ?? null;
const tsaEntry = TSA[`${targetLang}-${level}`] ?? null;

// Agrupar por unidad, sin perder ninguna lección por el camino.
//
// Antes esto era `unitMetas.map(u => lessons.filter(l => l.data.unit === u.id))`
// a secas, y una lección sin `unit` —o con un `unit` que no existe en
// src/data/units.ts— no entraba en ningún grupo y desaparecía de la página en
// silencio: seguía en el sitemap y accesible por URL directa, pero nadie
// podía llegar a ella navegando. Había 15 así. Ahora las que sobran caen en
// un grupo final, de modo que un error de frontmatter se ve en pantalla en
// vez de esconder contenido.
const unitGroups: { unit: UnitMeta | null; items: typeof lessons }[] = (() => {
  if (!unitMetas) return [{ unit: null, items: lessons }];
  const grouped = unitMetas
    .map((unit) => ({ unit, items: lessons.filter((l) => l.data.unit === unit.id) }))
    .filter((g) => g.items.length > 0);
  const agrupadas = new Set(grouped.flatMap((g) => g.items.map((l) => l.id)));
  const sueltas = lessons.filter((l) => !agrupadas.has(l.id));
  return sueltas.length > 0 ? [...grouped, { unit: null, items: sueltas }] : grouped;
})();

// El número de cada nodo del camino es su posición tal como se ve, no su
// posición en `lessons`: agrupar por unidad puede reordenar, y numerar por la
// lista sin agrupar dejaba saltos (…7, 8, 10, 11, 9…).
const pathOrder = unitGroups.flatMap((g) => g.items);

const siteURL = Astro.site!.origin;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${languageName} ${levelName} — PolyLingua`,
  description: dict.levelDescriptions[level as keyof typeof dict.levelDescriptions],
  url: `${siteURL}/${userLang}/${targetLang}/${level}`,
  inLanguage: targetLang,
  provider: { '@type': 'Organization', name: 'PolyLingua', url: siteURL },
  hasCourseInstance: lessons.map((l) => ({
    '@type': 'CourseInstance',
    name: l.data.title,
    url: `${siteURL}/${userLang}/${targetLang}/${level}/${l.id.split('/').pop()}`,
    courseMode: 'online',
  })),
};
---

<BaseLayout
  title={`${languageName} ${levelName}`}
  description={dict.levelDescriptions[level as keyof typeof dict.levelDescriptions]}
  path={`/${userLang}/${targetLang}/${level}`}
  structuredData={structuredData}
  ogImage={`/og-${targetLang}.png`}
  siloContext={{
    userLang,
    targetLang,
    restPath: `/${level}`,
    breadcrumbs: [
      { name: dict.silo.idiomas, href: `/${userLang}` },
      { name: languageName, href: `/${userLang}/${targetLang}` },
      { name: levelName, href: `/${userLang}/${targetLang}/${level}` },
    ],
  }}
>
  <div class="container level-layout">
    <aside class="level-aside" style={`--accent-c:${levelMeta.color}`}>
      <nav class="breadcrumbs" aria-label={dict.breadcrumbAria}>
        <a href={`/${userLang}`}>{dict.silo.idiomas}</a>
        <span aria-hidden="true">/</span>
        <a href={`/${userLang}/${targetLang}`}>{languageMeta.flag} {languageName}</a>
        <span aria-hidden="true">/</span>
        <span>{levelName}</span>
      </nav>

      <h1 class="level-title">
        <span class="lt-lang">{languageName}</span>
        <span class="lt-level">
          <span class="lt-emoji" aria-hidden="true">{levelMeta.emoji}</span>{levelName}
        </span>
      </h1>
      <p class="tagline">{dict.levelTaglines[level as keyof typeof dict.levelTaglines]}</p>
      <p class="desc">{dict.levelDescriptions[level as keyof typeof dict.levelDescriptions]}</p>

      {
        lessons.length > 0 && (
          <div class="level-progress" data-level-progress>
            <div class="lp-track">
              <span class="lp-fill" data-level-fill />
            </div>
            <p class="lp-text" data-level-text />
            <a
              class="btn btn-primary lp-cta"
              data-continue-cta
              href={`/${userLang}/${targetLang}/${level}`}
              hidden
            >
              {dict.silo.continuar}
            </a>
          </div>
        )
      }
    </aside>

    <div class="level-path">
      {lessons.length === 0 && <p class="empty">{dict.silo.nivelVacio}</p>}

      {
        unitGroups.map((group) => (
          <section class="unit" style={`--accent-c:${levelMeta.color}`}>
            {group.unit && (
              <header class="unit-head">
                <span class="unit-emoji" aria-hidden="true">
                  {group.unit.emoji}
                </span>
                <div class="unit-titles">
                  <h2 class="unit-name">
                    Unidad {group.unit.id} — {group.unit.name}
                  </h2>
                  <p class="unit-desc">{group.unit.description}</p>
                </div>
                <span
                  class="unit-count"
                  data-unit-progress
                  data-unit-slugs={group.items.map((l) => l.id.split('/').pop()).join(',')}
                />
                <div class="unit-track">
                  <span class="unit-fill" data-unit-fill />
                </div>
              </header>
            )}

            <ol class="path">
              {group.items.map((lesson) => {
                const slug = lesson.id.split('/').pop();
                return (
                  <li class="path-item">
                    <a
                      class="path-link"
                      data-lesson-item
                      data-slug={slug}
                      href={`/${userLang}/${targetLang}/${level}/${slug}`}
                    >
                      <span class="node" data-lesson-num aria-hidden="true">
                        {pathOrder.indexOf(lesson) + 1}
                      </span>
                      <div class="path-body">
                        <h3 class="path-title underline-draw">{lesson.data.title}</h3>
                        <p class="path-desc">{lesson.data.description}</p>
                        <span class="path-meta">
                          <span class="chip">{lesson.data.grammarTopic}</span>
                          <span class="chip chip-time">{lesson.data.minutes} min</span>
                        </span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      }

      {
        lessons.length > 0 && (
          <a
            class="exam-milestone"
            data-exam-item
            href={`/${userLang}/${targetLang}/${level}/examen`}
            style={`--accent-c:${levelMeta.color}`}
          >
            <span class="node exam-node" data-lesson-num aria-hidden="true">
              🏆
            </span>
            <div class="path-body">
              <h2 class="path-title underline-draw">{dict.silo.examenNivel}</h2>
              <p class="path-desc">{dict.silo.examenDesc.replace('{nivel}', levelName)}</p>
            </div>
          </a>
        )
      }
    </div>
  </div>

  {
    tsaEntry && (
      <section class="container tsa">
        <h2>{tsaEntry.heading}</h2>
        <p class="tsa-intro">{tsaEntry.intro}</p>

        <ul class="tsa-achievements">
          {tsaEntry.achievements.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <blockquote class="tsa-insight">{tsaEntry.insight}</blockquote>

        <p class="tsa-stat">
          <strong>{tsaEntry.stat.value}</strong> {tsaEntry.stat.label}
        </p>

        <p class="tsa-links">
          Seguí con:{' '}
          {tsaEntry.links.map((link, i) => (
            <>
              <a href={link.href}>{link.label}</a>
              {i < tsaEntry.links.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      </section>
    )
  }
</BaseLayout>

<script
  define:vars={{
    userLang,
    targetLang,
    level,
    continuarLabel: dict.silo.continuar,
    empezarLabel: dict.header.ctaStart,
    leccionLabel: dict.silo.leccion,
    leccionesLabel: dict.silo.lecciones,
  }}
>
  function read(key) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function isLessonDone(slug) {
    return !!read(`polylingua-lesson-done-${targetLang}-${level}-${slug}`);
  }

  function lockItem(el) {
    el.classList.add('locked');
    el.setAttribute('aria-disabled', 'true');
    el.setAttribute('data-astro-prefetch', 'false');
    const num = el.querySelector('[data-lesson-num]');
    if (num) num.textContent = '🔒';
    el.addEventListener('click', (e) => e.preventDefault());
  }

  // Sin envolver en initX()+astro:page-load, esto solo corría una vez por
  // carga completa — bajo navegación SPA (Astro <ClientRouter />) revisitar
  // esta página no recalcularía qué lecciones/examen siguen bloqueados. Cada
  // navegación trae nodos DOM frescos (sin la clase locked, que solo la
  // agrega este script), así que reejecutarlo es seguro y no necesita guard.
  function initLevelIndex() {
    const items = Array.from(document.querySelectorAll('[data-lesson-item]'));
    // El orden sale del DOM, no de una lista inyectada desde el frontmatter.
    // Es la misma lista, pero agrupar por unidad puede reordenar o (si el
    // frontmatter tiene un `unit` raro) dejar afuera alguna lección: con una
    // lista aparte, el índice i apuntaba a otra lección y el candado se le
    // ponía a la equivocada. Leyendo data-slug eso no puede desalinearse.
    const slugs = items.map((el) => el.dataset.slug);
    let firstPending = -1;

    items.forEach((el, i) => {
      const num = el.querySelector('[data-lesson-num]');
      if (isLessonDone(slugs[i])) {
        el.classList.add('done');
        // El número deja paso al tilde: en un camino, lo que importa de una
        // lección terminada es que está hecha, no en qué posición iba.
        if (num) num.textContent = '\u2713';
      } else if (i > 0 && !isLessonDone(slugs[i - 1])) {
        lockItem(el);
      } else if (firstPending === -1) {
        // La primera sin hacer y desbloqueada es "dónde estás": es la única
        // que se levanta del camino como tarjeta.
        firstPending = i;
        el.classList.add('current');
      }
    });

    // Progreso del nivel entero, en la columna lateral.
    const done = slugs.filter(isLessonDone).length;
    const fill = document.querySelector('[data-level-fill]');
    const text = document.querySelector('[data-level-text]');
    const pct = slugs.length ? Math.round((done / slugs.length) * 100) : 0;
    if (fill) fill.style.width = pct + '%';
    const unidad = slugs.length === 1 ? leccionLabel : leccionesLabel;
    if (text) text.textContent = done + '/' + slugs.length + ' ' + unidad + ' · ' + pct + '%';

    // El CTA lleva a donde te quedaste, no siempre a la primera lección.
    const cta = document.querySelector('[data-continue-cta]');
    if (cta && slugs.length) {
      const target = firstPending === -1 ? slugs[slugs.length - 1] : slugs[firstPending];
      cta.href = '/' + userLang + '/' + targetLang + '/' + level + '/' + target;
      cta.textContent = done === 0 ? empezarLabel : continuarLabel;
      cta.hidden = false;
    }

    document.querySelectorAll('[data-unit-progress]').forEach((el) => {
      var uSlugs = (el.dataset.unitSlugs || '').split(',').filter(Boolean);
      var uDone = uSlugs.filter(isLessonDone).length;
      el.textContent = uDone + '/' + uSlugs.length;
      if (uDone === uSlugs.length && uSlugs.length > 0) el.classList.add('complete');
      var head = el.closest('.unit-head');
      var bar = head && head.querySelector('[data-unit-fill]');
      if (bar) bar.style.width = (uSlugs.length ? (uDone / uSlugs.length) * 100 : 0) + '%';
    });

    const examItem = document.querySelector('[data-exam-item]');
    const lastSlug = slugs[slugs.length - 1];
    if (examItem && (!lastSlug || !isLessonDone(lastSlug))) lockItem(examItem);
    if (
      examItem &&
      lastSlug &&
      isLessonDone(lastSlug) &&
      read('polylingua-level-passed-' + targetLang + '-' + level)
    ) {
      examItem.classList.add('done');
    }
  }

  initLevelIndex();
  document.addEventListener('astro:page-load', initLevelIndex);
</script>

<style>
  /* ── Estructura general ──────────────────────────────────────────────
     Dos columnas en escritorio: a la izquierda la ficha del nivel (que
     queda fija al hacer scroll, porque es el contexto de todo lo demás) y
     a la derecha el camino de lecciones. En móvil se apila: primero la
     ficha, después el camino. */
  .level-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
    padding-block: 2.25rem 4rem;
  }

  @media (min-width: 960px) {
    .level-layout {
      grid-template-columns: minmax(250px, 300px) minmax(0, 1fr);
      gap: 3.5rem;
    }

    .level-aside {
      position: sticky;
      /* Debajo del header sticky, que mide ~4rem. */
      top: 5rem;
    }
  }

  /* ── Columna izquierda: ficha del nivel ─────────────────────────────── */
  /* El h1 lleva idioma y nivel (los dos importan para SEO), pero en dos
     renglones propios: en una sola línea, "Alemán — A1 · Principiante" se
     partía por cualquier lado y el "·" quedaba huérfano al inicio del
     segundo renglón. */
  .level-title {
    margin: 1rem 0 0.5rem;
  }

  .lt-lang {
    display: block;
    font-size: clamp(1.7rem, 3.4vw, 2.2rem);
    line-height: 1.1;
  }

  .lt-level {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.45rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-c);
  }

  .lt-emoji {
    font-size: 1.2rem;
  }

  .tagline {
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .level-progress {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .lp-track,
  .unit-track {
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-muted) 22%, transparent);
    overflow: hidden;
  }

  .lp-fill,
  .unit-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--accent-c, var(--accent));
    transition: width 0.4s ease;
  }

  .lp-text {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .lp-cta {
    display: inline-flex;
    margin-top: 1rem;
    width: 100%;
    justify-content: center;
  }

  /* ── Columna derecha: el camino ─────────────────────────────────────── */
  .empty {
    color: var(--text-muted);
  }

  .unit + .unit {
    margin-top: 2.5rem;
  }

  .unit-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-bottom: 1.25rem;
  }

  .unit-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }

  .unit-titles {
    min-width: 0;
  }

  .unit-name {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .unit-desc {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .unit-count {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    white-space: nowrap;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .unit-count.complete {
    color: #22c55e;
    border-color: color-mix(in srgb, #22c55e 45%, transparent);
  }

  .unit-track {
    grid-column: 1 / -1;
  }

  /* La lista es el camino: un hilo vertical detrás de los nodos, dibujado
     con un pseudo-elemento del <li> en vez de un borde, para poder cortarlo
     en el último item sin que sobre línea al final del grupo. */
  .path {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .path-item {
    position: relative;
  }

  /* El hilo va del centro de este nodo al centro del siguiente (de ahí el
     bottom negativo: se mete en el <li> de abajo). El nodo tiene fondo
     opaco, así que la parte que le pasa por detrás no se ve. */
  .path-item::before {
    content: '';
    position: absolute;
    left: 19px;
    top: calc(0.85rem + 20px);
    bottom: calc(-0.85rem - 20px);
    width: 2px;
    background: var(--border);
  }

  .path-item:last-child::before {
    display: none;
  }

  .path-link {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 0.85rem 0.9rem 0.85rem 0;
    text-decoration: none;
    color: var(--text);
    /* Borde transparente siempre presente: así, cuando .current lo pinta,
       el contenido no se corre 1px respecto al resto del camino. */
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }

  .path-link:hover {
    background: color-mix(in srgb, var(--accent-c, var(--accent)) 7%, transparent);
    transform: translateX(3px);
  }

  .path-link:hover .underline-draw {
    background-size: 100% 2px;
  }

  /* El nodo del camino. Fondo opaco (no transparente) para tapar el hilo
     que pasa por detrás. */
  .node {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 0.95rem;
    background: var(--bg-card);
    color: var(--text-muted);
    border: 2px solid var(--border);
    flex-shrink: 0;
  }

  .path-body {
    display: block;
    min-width: 0;
    padding-top: 0.15rem;
  }

  .path-title {
    margin: 0 0 0.25rem;
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .path-desc {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .path-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    font-size: 0.73rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .chip-time::before {
    content: '⏱ ';
  }

  /* ── Estados: hecha / actual / bloqueada ────────────────────────────── */
  .path-link.done .node {
    background: #22c55e;
    border-color: #22c55e;
    color: #fff;
  }

  .path-link.done .path-title,
  .path-link.done .path-desc {
    color: var(--text-muted);
  }

  /* "Dónde estás": la única lección que se levanta del camino como tarjeta,
     para que la vista tenga un solo punto de entrada obvio. */
  .path-link.current {
    background: var(--bg-card);
    border-color: color-mix(in srgb, var(--accent-c, var(--accent)) 55%, var(--border));
    box-shadow: var(--shadow-card);
    /* El margen negativo compensa el padding: la tarjeta se extiende hacia
       la izquierda sin mover el nodo, que tiene que seguir sobre el hilo. */
    margin-left: -0.9rem;
    padding-left: 0.9rem;
  }

  .path-link.current .node {
    background: var(--accent-c, var(--accent));
    border-color: var(--accent-c, var(--accent));
    color: var(--de-black);
  }

  .path-link.locked {
    cursor: default;
    opacity: 0.45;
  }

  .path-link.locked:hover {
    background: none;
    transform: none;
  }

  .path-link.locked:hover .underline-draw {
    background-size: 0 2px;
  }

  /* ── Meta final del nivel: el examen ────────────────────────────────── */
  .exam-milestone {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    margin-top: 2rem;
    padding: 1.15rem 1.15rem 1.15rem 0.9rem;
    text-decoration: none;
    color: var(--text);
    background: color-mix(in srgb, var(--accent-c, var(--accent)) 8%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--accent-c, var(--accent)) 45%, var(--border));
    border-radius: var(--radius);
    transition:
      transform 0.15s ease,
      box-shadow 0.2s ease;
  }

  .exam-milestone:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .exam-milestone:hover .underline-draw {
    background-size: 100% 2px;
  }

  .exam-node {
    background: transparent;
    border-color: color-mix(in srgb, var(--accent-c, var(--accent)) 45%, var(--border));
    font-size: 1.15rem;
  }

  .exam-milestone .path-title {
    font-size: 1.08rem;
  }

  .exam-milestone .path-desc {
