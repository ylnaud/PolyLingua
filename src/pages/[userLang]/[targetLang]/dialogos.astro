---
import { getCollection } from 'astro:content';
import { getDictionary } from '../../../i18n';
import SiloToolPage from '../../../components/SiloToolPage.astro';
import { LANGUAGE_MAP } from '../../../data/languages';
import { getSpanishGlossCourseStaticPaths } from '../../../lib/courses';
import { LEVEL_MAP } from '../../../data/levels';

// Solo se genera dentro del silo español: el contenido de esta herramienta
// guarda su traducción en español y no tiene eje userLang. Ver
// getSpanishGlossCourseStaticPaths() en src/lib/courses.ts.
export const getStaticPaths = getSpanishGlossCourseStaticPaths;

const { userLang, targetLang } = Astro.params;
const dict = getDictionary(userLang as never);
const lang = targetLang;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];

const LEVEL_ORDER = ['a1', 'a2', 'b1', 'b2', 'c1', 'c2'];
const allDialogos = (await getCollection('dialogos', (entry) => entry.data.language === lang)).sort(
  (a, b) => {
    const byLevel = LEVEL_ORDER.indexOf(a.data.level) - LEVEL_ORDER.indexOf(b.data.level);
    return byLevel !== 0 ? byLevel : a.data.order - b.data.order;
  },
);

const situations = [...new Set(allDialogos.map((d) => d.data.situation))].map((sit) => ({
  situation: sit,
  dialogues: allDialogos.filter((d) => d.data.situation === sit),
}));

// El ItemList del JSON-LD sale de aplanar los mismos grupos que se pintan, en
// el mismo orden: es la única forma de que anuncie exactamente lo que hay en
// la página y no una lista paralela que se desincronice.
const enOrdenDeLaPagina = situations.flatMap((g) => g.dialogues);

const siloContext = {
  userLang: userLang!,
  targetLang: lang!,
  restPath: '/dialogos',
  breadcrumbs: [
    { name: dict.silo.idiomas, href: `/${userLang}` },
    { name: languageMeta?.name ?? lang!, href: `/${userLang}/${lang}` },
    { name: dict.silo.explorar.dialogos, href: `/${userLang}/${lang}/dialogos` },
  ],
  collection: {
    name: `Diálogos en ${languageMeta?.name}`,
    about: languageMeta?.name,
    items: enOrdenDeLaPagina.map((d) => ({
      name: d.data.title,
      href: `/${userLang}/${lang}/dialogos/${d.id.split('/').pop()}`,
    })),
  },
};
---

<SiloToolPage
  userLang={userLang!}
  targetLang={lang!}
  slug="dialogos"
  siloContext={siloContext}
  emoji="💬"
  headClass="dlg-head"
  name={dict.silo.explorar.dialogos}
  title={`Diálogos en ${languageMeta?.name}`}
  description={`Aprendé ${languageMeta?.name} con ${allDialogos.length} diálogos cortos de situaciones reales: pedir en un café, viajar, ir al médico o alquilar. Cada uno con traducción línea a línea.`}
  h1="Diálogos para asimilar"
  desc="Diálogos cortos y reales que asimilás por repetición, no por análisis. Leelos, traducilos y dejalos reposar — en 4 días el patrón se graba solo."
>
  <section class="container dlg-body">
    {
      situations.length === 0 ? (
        <div class="card empty-state">
          <p class="empty-emoji">🚧</p>
          <h2>Todavía no hay diálogos en {languageMeta?.name}</h2>
          <p>Estamos armando este modo idioma por idioma — volvé pronto.</p>
          <a class="btn btn-primary" href={`/${userLang}/${lang}`}>
            Ver lecciones
          </a>
        </div>
      ) : (
        situations.map((group) => (
          <div class="sit-group">
            <h2 class="sit-title">{group.situation}</h2>
            <div class="dlg-grid">
              {group.dialogues.map((dlg) => {
                const slug = dlg.id.split('/').pop()!;
                const levelMeta = LEVEL_MAP[dlg.data.level as keyof typeof LEVEL_MAP];
                return (
                  <a
                    class="dlg-item card"
                    href={`/${userLang}/${lang}/dialogos/${slug}`}
                    data-dlg-card
                    data-dlg-key={`polylingua-dialogo-cycle-${lang}-${slug}`}
                  >
                    <span class="dlg-level" style={`color:${levelMeta?.color}`}>
                      {levelMeta?.emoji} {dlg.data.level.toUpperCase()}
                    </span>
                    <span class="dlg-name">{dlg.data.title}</span>
                    <span class="dlg-desc">{dlg.data.description}</span>
                    <div class="dlg-meta">
                      <span>{dlg.data.dialogue.length} líneas</span>
                      <span>⏱ {dlg.data.minutes} min</span>
                      <span class="dlg-cycle-badge" data-cycle-badge />
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      )
    }
  </section>
</SiloToolPage>

<script>
  import { read } from '../../../lib/storage';

  function initCycleBadges() {
    document.querySelectorAll<HTMLElement>('[data-dlg-card]').forEach((card) => {
      const key = card.dataset.dlgKey ?? '';
      const badge = card.querySelector<HTMLElement>('[data-cycle-badge]');
      if (!badge || !key) return;

      const raw = read(key);
      if (!raw) return;

      try {
        const state = JSON.parse(raw);
        if (!Array.isArray(state.completed)) return;
        const done = state.completed.length;
        if (done >= 4) {
          badge.textContent = '✓ Completado';
          badge.classList.add('badge-done');
        } else if (done > 0) {
          badge.textContent = `${done}/4 días`;
          badge.classList.add('badge-progress');
        }
      } catch {
        /* ignore */
      }
    });
  }

  initCycleBadges();
  document.addEventListener('astro:page-load', initCycleBadges);
</script>

<style>
  .dlg-body {
    max-width: 680px;
    padding-block: 0 4rem;
  }

  .sit-group {
    margin-bottom: 2rem;
  }

  .sit-title {
    font-size: 1.1rem;
    margin: 0 0 0.85rem;
  }

  .dlg-grid {
    display: grid;
    gap: 0.85rem;
  }

  .dlg-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease;
  }

  .dlg-item:hover {
    border-color: var(--accent);
  }

  .dlg-level {
    font-size: 0.78rem;
    font-weight: 700;
  }

  .dlg-name {
    font-weight: 700;
  }

  .dlg-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .dlg-meta {
    display: flex;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    margin-top: 0.2rem;
  }

  .badge-done {
    color: #22c55e;
  }

  .badge-progress {
    color: var(--accent-text);
  }

  .empty-state h2 {
    margin: 0 0 0.5rem;
  }

  .empty-state p {
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }
</style>
