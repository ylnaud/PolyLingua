---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGUAGE_MAP } from '../../../data/languages';
import { getCourseStaticPaths, getCourseLessons } from '../../../lib/courses';
import { getDictionary } from '../../../i18n';
import { fill } from '../../../lib/interpolate';

export const getStaticPaths = getCourseStaticPaths;

const { userLang, targetLang: lang } = Astro.params;
const dict = getDictionary(userLang as never);
const tt = dict.tools.gramatica;
// El nombre del idioma meta traducido al idioma de la interfaz: 'Alemán' para
// un hispanohablante, 'Deutsch' para un alemán. src/data/languages.ts guarda
// una sola versión (en español), por eso sale del diccionario.
const langName = dict.languageNames[lang as keyof typeof dict.languageNames];
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];

const lessonsForLang = getCourseLessons(userLang!, lang!);

interface TopicInfo {
  topic: string;
  lessonIds: string[];
  exerciseCount: number;
}

const topicMap = new Map<string, TopicInfo>();
for (const lesson of lessonsForLang) {
  const topic = lesson.data.grammarTopic;
  if (!topic) continue;
  const existing = topicMap.get(topic);
  const exerciseCount = lesson.data.quiz.length + lesson.data.exercises.length;
  if (existing) {
    existing.lessonIds.push(lesson.id);
    existing.exerciseCount += exerciseCount;
  } else {
    topicMap.set(topic, { topic, lessonIds: [lesson.id], exerciseCount });
  }
}

const topics = [...topicMap.values()].sort((a, b) => a.topic.localeCompare(b.topic, 'es'));
const topicManifest = Object.fromEntries(topics.map((t) => [t.topic, t.lessonIds]));
---

<BaseLayout
  userLang={userLang}
  title={fill(tt.metaTitulo, { lang: langName })}
  description={fill(tt.metaDescripcion, { lang: langName })}
  path={`/${userLang}/${lang}/gramatica`}
  noindex
>
  <section class="container grammar-head">
    <Breadcrumbs
      userLang={userLang}
      items={[
        { name: dict.silo.idiomas, href: `/${userLang}` },
        { name: langName, flag: languageMeta?.flag, href: `/${userLang}/${lang}` },
        { name: dict.tools.nombres.gramatica },
      ]}
    />
    <span class="emoji" aria-hidden="true">📖</span>
    <h1>{fill(tt.h1, { lang: langName })}</h1>
    <p class="desc">{tt.desc}</p>
  </section>

  <section class="container grammar-grid" data-grammar-grid>
    {
      topics.map((entry) => (
        <div class="grammar-card card" data-grammar-card data-topic={entry.topic}>
          <h2 class="grammar-topic">{entry.topic}</h2>
          <div class="grammar-meta">
            <span class="grammar-exercises">
              {fill(entry.exerciseCount === 1 ? tt.ejercicio : tt.ejercicios, {
                n: entry.exerciseCount,
              })}
            </span>
            <span class="grammar-mastery" data-mastery>
              {dict.tools.comun.sinDatos}
            </span>
          </div>
          <div class="grammar-bar-wrap">
            <div class="grammar-bar">
              <div class="grammar-bar-fill" data-mastery-fill />
            </div>
          </div>
          <a
            class="btn btn-ghost grammar-cta"
            href={`/${userLang}/${lang}/repasar?tema=${encodeURIComponent(entry.topic)}`}
          >
            {dict.tools.comun.practicar}
          </a>
        </div>
      ))
    }
  </section>

  <div hidden data-topic-manifest={JSON.stringify(topicManifest)}></div>
  <div
    hidden
    data-page-strings={JSON.stringify({
      sinDatos: dict.tools.comun.sinDatos,
      mastery: dict.tools.comun.mastery,
      caja: dict.tools.comun.caja,
    })}
  >
  </div>
</BaseLayout>

<script>
  import { read } from '../../../lib/storage';
  import { MAX_BOX } from '../../../lib/srs';
  import { readPageStrings, fill } from '../../../lib/pageStrings';

  // MASTERY_LABELS de src/lib/srs.ts está solo en español (también lo usa
  // lógica que no ve el usuario); las etiquetas visibles vienen traducidas
  // desde el diccionario por [data-page-strings].
  const s = readPageStrings({
    sinDatos: 'Sin datos',
    mastery: ['Nueva', 'Aprendiendo', 'Familiar', 'Buena', 'Dominada', 'Muy dominada'],
    caja: 'Caja {n}',
  });

  interface SrsEntry {
    id: string;
    box: number;
    lang: string;
  }

  function readPool(): Record<string, SrsEntry> {
    try {
      return JSON.parse(read('polylingua-srs-pool') ?? '{}');
    } catch {
      return {};
    }
  }

  function readTopicManifest(): Record<string, string[]> {
    const el = document.querySelector<HTMLElement>('[data-topic-manifest]');
    if (!el) return {};
    try {
      return JSON.parse(el.dataset.topicManifest ?? '{}');
    } catch {
      return {};
    }
  }

  function initGrammar() {
    const grid = document.querySelector<HTMLElement>('[data-grammar-grid]');
    if (!grid) return;
    if (grid.dataset.built) return;
    grid.dataset.built = 'true';

    const lang = window.location.pathname.split('/')[2] ?? '';
    const pool = readPool();
    const topicManifest = readTopicManifest();

    const cards = grid.querySelectorAll<HTMLElement>('[data-grammar-card]');
    cards.forEach((card) => {
      const topic = card.dataset.topic ?? '';
      const lessonIds = topicManifest[topic] ?? [];

      const entries: SrsEntry[] = [];
      for (const entry of Object.values(pool)) {
        if (entry.lang !== lang) continue;
        const lessonId = (entry as any).id?.split('#')[0] ?? '';
        if (lessonIds.includes(lessonId)) entries.push(entry);
      }

      const masteryEl = card.querySelector<HTMLElement>('[data-mastery]');
      const fillEl = card.querySelector<HTMLElement>('[data-mastery-fill]');

      if (entries.length === 0) {
        if (masteryEl) {
          masteryEl.textContent = s.sinDatos;
          masteryEl.classList.add('no-data');
        }
        return;
      }

      const avgBox = Math.round(entries.reduce((s, e) => s + e.box, 0) / entries.length);
      const clampedBox = Math.min(avgBox, MAX_BOX - 1);
      const pct = Math.round((clampedBox / (MAX_BOX - 1)) * 100);

      if (masteryEl) {
        masteryEl.textContent = s.mastery[clampedBox] ?? fill(s.caja, { n: clampedBox });
        masteryEl.classList.remove('no-data');
      }
      if (fillEl) fillEl.style.width = `${pct}%`;
    });
  }

  initGrammar();
  document.addEventListener('astro:page-load', initGrammar);
</script>

<style>
  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .grammar-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .grammar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    padding-block: 0 4rem;
    max-width: 900px;
  }

  .grammar-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .grammar-topic {
    font-size: 1.05rem;
    margin: 0;
  }

  .grammar-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }

  .grammar-exercises {
    color: var(--text-muted);
    font-weight: 600;
  }

  .grammar-mastery {
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-text);
  }

  .grammar-mastery:global(.no-data) {
    background: var(--bg-elevated);
    color: var(--text-muted);
  }

  .grammar-bar-wrap {
    width: 100%;
  }

  .grammar-bar {
    height: 6px;
    border-radius: 3px;
    background: var(--border, #e5e7eb);
    overflow: hidden;
  }

  .grammar-bar-fill {
    height: 100%;
    border-radius: 3px;
    background: var(--accent);
    transition: width 0.4s ease;
    width: 0%;
  }

  .grammar-cta {
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    align-self: flex-start;
    text-decoration: none;
  }

  @media (max-width: 560px) {
    .grammar-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
