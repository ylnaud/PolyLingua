---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LEVELS } from '../../../data/levels';
import { LANGUAGE_MAP } from '../../../data/languages';
import { TSA_LANG } from '../../../data/tsa';
import { parseLessonId } from '../../../lib/lessonPath';
import { MATRIX_DATA } from '../../../data/matrices';
import { SPANISH_GLOSS_USER_LANG } from '../../../lib/courses';
import { getDictionary } from '../../../i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');
  const combos = new Set<string>();
  for (const lesson of allLessons) {
    const { userLang, targetLang } = parseLessonId(lesson.id);
    combos.add(`${userLang}/${targetLang}`);
  }
  return Array.from(combos).map((combo) => {
    const [userLang, targetLang] = combo.split('/');
    return { params: { userLang, targetLang } };
  });
}

const { userLang, targetLang } = Astro.params;
const dict = getDictionary(userLang as never);
const t = dict.silo;
const languageName = dict.languageNames[targetLang as keyof typeof dict.languageNames];
const languageTagline = dict.languageTaglines[targetLang as keyof typeof dict.languageNames];
const languageDescription =
  dict.languageDescriptions[targetLang as keyof typeof dict.languageNames];
const languageMeta = LANGUAGE_MAP[targetLang as keyof typeof LANGUAGE_MAP];
const tsaEntry = TSA_LANG[targetLang as string] ?? null;

// Diálogos, recursos y generador de frases solo existen dentro del silo
// español: su contenido guarda la traducción en un solo idioma de interfaz
// (ver SPANISH_GLOSS_USER_LANG en src/lib/courses.ts). Enlazarlos desde otro
// silo sería mandar al usuario a una página que no se genera.
const hasSpanishGlossTools = userLang === SPANISH_GLOSS_USER_LANG;

const allLessons = await getCollection('lessons');
const sameSilo = (l: (typeof allLessons)[number], lvlId: string) =>
  l.data.language === targetLang &&
  l.data.level === lvlId &&
  parseLessonId(l.id).userLang === userLang;

const levelLessonSlugs: Record<string, string[]> = {};
for (const lvl of LEVELS) {
  levelLessonSlugs[lvl.id] = allLessons
    .filter((l) => sameSilo(l, lvl.id))
    .sort((a, b) => a.data.order - b.data.order)
    .map((l) => l.id.split('/').pop()!);
}

const totalLessons = LEVELS.reduce((n, lvl) => n + levelLessonSlugs[lvl.id].length, 0);

const firstLessonSlug = levelLessonSlugs['a1']?.[0];
const defaultContinueHref = firstLessonSlug
  ? `/${userLang}/${targetLang}/a1/${firstLessonSlug}`
  : `/${userLang}/${targetLang}`;

const siteURL = Astro.site!.origin;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${languageName} — PolyLingua`,
  description: languageDescription,
  url: `${siteURL}/${userLang}/${targetLang}`,
  inLanguage: targetLang,
  provider: { '@type': 'Organization', name: 'PolyLingua', url: siteURL },
};
---

<BaseLayout
  title={`${languageName} — PolyLingua`}
  description={languageDescription}
  path={`/${userLang}/${targetLang}`}
  structuredData={structuredData}
  ogImage={`/og-${targetLang}.png`}
  siloContext={{
    userLang,
    targetLang,
    restPath: '',
    breadcrumbs: [
      { name: t.idiomas, href: `/${userLang}` },
      { name: languageName, href: `/${userLang}/${targetLang}` },
    ],
  }}
>
  <div class="container silo-layout">
    <aside class="silo-aside" style={`--accent-c:${languageMeta.color}`}>
      <nav class="breadcrumbs" aria-label={dict.breadcrumbAria}>
        <a href={`/${userLang}`}>{t.idiomas}</a>
        <span aria-hidden="true">/</span>
        <span>{languageName}</span>
      </nav>

      <h1 class="lang-title">
        <span class="lt-name">
          <span class="lt-flag" aria-hidden="true">{languageMeta.flag}</span>{languageName}
        </span>
        <span class="lt-native">{languageMeta.nativeName}</span>
      </h1>
      <p class="tagline">{languageTagline}</p>
      <p class="desc">{languageDescription}</p>

      {
        totalLessons > 0 && (
          <div class="silo-progress">
            <div class="silo-track">
              <span class="silo-fill" data-course-fill />
            </div>
            <p class="silo-progress-text" data-course-text />
            <a class="btn btn-primary silo-cta" data-course-cta href={defaultContinueHref}>
              {t.continuar}
            </a>

            <div class="stats">
              <div class="stat">
                <span class="stat-num" data-stat-review>
                  0
                </span>
                <span class="stat-label">{t.repaso}</span>
              </div>
              <a class="stat stat-link" href={`/${userLang}/${targetLang}/mis-errores`}>
                <span class="stat-num" data-stat-errors>
                  0
                </span>
                <span class="stat-label">{t.errores}</span>
              </a>
              <div class="stat">
                <span class="stat-num" data-stat-streak>
                  0
                </span>
                <span class="stat-label">{t.racha}</span>
              </div>
            </div>
          </div>
        )
      }
    </aside>

    <div class="levels">
      <ol class="silo-path">
        {
          LEVELS.map((level) => (
            <li class="silo-item">
              <a
                class="silo-link"
                data-level-item
                data-level-id={level.id}
                href={`/${userLang}/${targetLang}/${level.id}`}
                style={`--accent-c:${level.color}`}
              >
                <span class="silo-node" data-level-node aria-hidden="true">
                  {level.emoji}
                </span>
                <div class="silo-body">
                  <h2 class="silo-title underline-draw">{dict.levelNames[level.id]}</h2>
                  <p class="lvl-tagline">{dict.levelTaglines[level.id]}</p>
                  <p class="silo-desc">{dict.levelDescriptions[level.id]}</p>
                  <div class="silo-meta">
                    <span class="lvl-track silo-track">
                      <span class="silo-fill" data-level-fill />
                    </span>
                    <span class="silo-chip" data-level-badge>
                      {levelLessonSlugs[level.id].length}{' '}
                      {levelLessonSlugs[level.id].length === 1 ? t.leccion : t.lecciones}
                    </span>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <section class="container explore-more" style={`--accent-c:${languageMeta.color}`}>
    <span class="eyebrow">{t.explorarMas}</span>
    <div class="explore-grid">
      <a class="explore-item card" href={`/${userLang}/${targetLang}/situaciones`}>
        <span class="explore-icon" aria-hidden="true">🗺️</span>
        <span>{t.explorar.situaciones}</span>
      </a>
      {
        hasSpanishGlossTools && (
          <a class="explore-item card" href={`/${userLang}/${targetLang}/dialogos`}>
            <span class="explore-icon" aria-hidden="true">
              💬
            </span>
            <span>{t.explorar.dialogos}</span>
          </a>
        )
      }
      <a class="explore-item card" href={`/${userLang}/${targetLang}/pronunciacion`}>
        <span class="explore-icon" aria-hidden="true">🗣️</span>
        <span>{t.explorar.pronunciacion}</span>
      </a>
      {
        hasSpanishGlossTools && (
          <a class="explore-item card" href={`/${userLang}/${targetLang}/recursos`}>
            <span class="explore-icon" aria-hidden="true">
              📻
            </span>
            <span>{t.explorar.recursos}</span>
          </a>
        )
      }
      <a class="explore-item card" href="/logros">
        <span class="explore-icon" aria-hidden="true">🎯</span>
        <span>{t.explorar.sprintSemanal}</span>
      </a>
      <a class="explore-item card" href={`/${userLang}/${targetLang}/diario`}>
        <span class="explore-icon" aria-hidden="true">✍️</span>
        <span>{t.explorar.diario}</span>
      </a>
      <a class="explore-item card" href={`/${userLang}/${targetLang}/mis-errores`}>
        <span class="explore-icon" aria-hidden="true">🔴</span>
        <span>{t.explorar.misErrores}</span>
      </a>
      <a class="explore-item card" href={`/${userLang}/${targetLang}/gramatica`}>
        <span class="explore-icon" aria-hidden="true">📖</span>
        <span>{t.explorar.gramatica}</span>
      </a>
      {
        hasSpanishGlossTools && MATRIX_DATA[targetLang as keyof typeof MATRIX_DATA] && (
          <a class="explore-item card" href={`/${userLang}/${targetLang}/generador-frases`}>
            <span class="explore-icon" aria-hidden="true">
              🧩
            </span>
            <span>{t.explorar.generadorFrases}</span>
          </a>
        )
      }
    </div>
  </section>

  {
    tsaEntry && (
      <section class="container tsa">
        <h2>{tsaEntry.heading}</h2>
        <p class="tsa-intro">{tsaEntry.intro}</p>

        <ul class="tsa-achievements">
          {tsaEntry.achievements.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <blockquote class="tsa-insight">{tsaEntry.insight}</blockquote>

        <p class="tsa-stat">
          <strong>{tsaEntry.stat.value}</strong> {tsaEntry.stat.label}
        </p>

        <p class="tsa-links">
          Seguí con:{' '}
          {tsaEntry.links.map((link, i) => (
            <>
              <a href={link.href}>{link.label}</a>
              {i < tsaEntry.links.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      </section>
    )
  }
</BaseLayout>

<script
  define:vars={{
    userLang,
    targetLang,
    levelLessonSlugs,
    totalLessons,
    txtLecciones: t.lecciones,
    txtBloqueado: t.bloqueado,
    txtCompletado: t.completado,
    txtIrAlExamen: t.irAlExamen,
    txtContinuar: t.continuar,
    txtEmpezar: dict.header.ctaStart,
  }}
>
  function read(key) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function isLevelPassed(levelId) {
    return read('polylingua-level-passed-' + targetLang + '-' + levelId) === 'true';
  }

  function isLessonDone(lvl, slug) {
    return !!read('polylingua-lesson-done-' + targetLang + '-' + lvl + '-' + slug);
  }

  function doneIn(lvl) {
    var slugs = levelLessonSlugs[lvl] || [];
    var n = 0;
    for (var i = 0; i < slugs.length; i++) {
      if (isLessonDone(lvl, slugs[i])) n++;
    }
    return n;
  }

  function todayStr() {
    var d = new Date();
    return (
      d.getFullYear() +
      '-' +
      String(d.getMonth() + 1).padStart(2, '0') +
      '-' +
      String(d.getDate()).padStart(2, '0')
    );
  }

  function lockItem(el, badge) {
    el.classList.add('locked');
    el.setAttribute('aria-disabled', 'true');
    el.setAttribute('data-astro-prefetch', 'false');
    if (badge) badge.textContent = txtBloqueado;
    var node = el.querySelector('[data-level-node]');
    if (node) node.textContent = '🔒';
    el.addEventListener('click', function (e) {
      e.preventDefault();
    });
  }

  // Sin envolver en initX()+astro:page-load esto solo correría en la carga
  // completa: bajo navegación SPA (<ClientRouter />) volver acá no recalcularía
  // qué niveles siguen bloqueados. Los nodos vienen frescos en cada navegación
  // (sin .locked, que solo agrega este script), así que reejecutarlo es seguro.
  function initCourseIndex() {
    var items = Array.from(document.querySelectorAll('[data-level-item]'));
    // El id sale del propio elemento, no de un array inyectado aparte: si el
    // orden del DOM y el del array se separan, el candado le cae al nivel
    // equivocado. El atributo ya estaba puesto y nadie lo usaba.
    var ids = items.map(function (el) {
      return el.dataset.levelId;
    });

    var currentLevel = null;

    items.forEach(function (el, i) {
      var lvl = ids[i];
      var slugs = levelLessonSlugs[lvl] || [];
      var done = doneIn(lvl);
      var badge = el.querySelector('[data-level-badge]');
      var fill = el.querySelector('[data-level-fill]');
      var node = el.querySelector('[data-level-node]');
      var pct = slugs.length ? Math.round((done / slugs.length) * 100) : 0;

      if (fill) fill.style.width = pct + '%';

      if (isLevelPassed(lvl)) {
        el.classList.add('done');
        if (node) node.textContent = '✓';
        if (badge) badge.textContent = txtCompletado;
        // Aprobado el examen, el nivel está cerrado aunque queden lecciones
        // sueltas sin marcar: una barra al 28% al lado de "Completado" se
        // contradice sola.
        if (fill) fill.style.width = '100%';
        return;
      }

      // Un nivel se abre cuando el anterior está aprobado. El primero siempre.
      if (i > 0 && !isLevelPassed(ids[i - 1])) {
        lockItem(el, badge);
        return;
      }

      if (badge && done > 0) badge.textContent = done + '/' + slugs.length + ' · ' + pct + '%';
      if (currentLevel === null) {
        currentLevel = lvl;
        el.classList.add('current');
      }
    });

    initAside(currentLevel === null ? ids[ids.length - 1] : currentLevel);
  }

  function initAside(currentLevel) {
    // Progreso del curso entero, no solo del nivel en curso: es la respuesta a
    // "cuánto me falta para terminar alemán".
    var doneTotal = 0;
    for (var key in levelLessonSlugs) {
      doneTotal += doneIn(key);
    }
    var pct = totalLessons ? Math.round((doneTotal / totalLessons) * 100) : 0;

    var fill = document.querySelector('[data-course-fill]');
    if (fill) fill.style.width = pct + '%';
    var text = document.querySelector('[data-course-text]');
    if (text) {
      text.textContent = doneTotal + '/' + totalLessons + ' ' + txtLecciones + ' · ' + pct + '%';
    }

    var cta = document.querySelector('[data-course-cta]');
    var slugs = levelLessonSlugs[currentLevel] || [];
    var pending = null;
    for (var i = 0; i < slugs.length; i++) {
      if (!isLessonDone(currentLevel, slugs[i])) {
        pending = slugs[i];
        break;
      }
    }
    if (cta && slugs.length) {
      if (pending) {
        cta.href = '/' + userLang + '/' + targetLang + '/' + currentLevel + '/' + pending;
        // A quien no empezó nunca no se le dice "Continuar".
        cta.textContent = doneTotal === 0 ? txtEmpezar : txtContinuar;
      } else {
        // Todas hechas y el nivel sin aprobar: lo que falta es el examen.
        cta.href = '/' + userLang + '/' + targetLang + '/' + currentLevel + '/examen';
        cta.textContent = txtIrAlExamen;
      }
    }

    var reviewCount = 0;
    try {
      var pool = JSON.parse(read('polylingua-srs-pool') || '{}');
      var td = todayStr();
      for (var k in pool) {
        if (pool[k].lang === targetLang && pool[k].due <= td) reviewCount++;
      }
    } catch (e) {}
    var reviewEl = document.querySelector('[data-stat-review]');
    if (reviewEl) reviewEl.textContent = String(reviewCount);

    var errorCount = 0;
    try {
      var log = JSON.parse(read('polylingua-error-log') || '[]');
      for (var e2 = 0; e2 < log.length; e2++) {
        if (log[e2].lang === targetLang) errorCount++;
      }
    } catch (e) {}
    var errorEl = document.querySelector('[data-stat-errors]');
    if (errorEl) errorEl.textContent = String(errorCount);

    var streakEl = document.querySelector('[data-stat-streak]');
    if (streakEl) streakEl.textContent = String(Number(read('polylingua-streak-count') || '0'));
  }

  initCourseIndex();
  document.addEventListener('astro:page-load', initCourseIndex);
</script>

<style>
  /* Las primitivas del camino (.silo-layout, .silo-path, .silo-node, la barra
     de progreso y los estados hecho/actual/bloqueado) viven en
     src/styles/global.css: las comparte con la página de nivel. Acá queda solo
     lo propio de la página de curso. */

  /* Mismo criterio que el h1 de la página de nivel: nombre e idioma nativo en
     renglones propios, para que ninguna línea se parta por un separador. */
  .lang-title {
    margin: 1rem 0 0.5rem;
  }

  .lt-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.7rem, 3.4vw, 2.2rem);
    line-height: 1.1;
  }

  .lt-flag {
    font-size: 1.6rem;
  }

  .lt-native {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-c);
  }

  .tagline {
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  /* ── Contadores de la lateral ───────────────────────────────────────── */
  .stats {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .stat {
    text-align: center;
    flex: 1;
  }

  .stat-link {
    text-decoration: none;
    color: var(--text);
    transition: opacity 0.15s ease;
  }

  .stat-link:hover {
    opacity: 0.7;
  }

  .stat-num {
    display: block;
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* ── Los 6 niveles ──────────────────────────────────────────────────── */
  .levels {
    padding-top: 0.5rem;
  }

  .lvl-tagline {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-c);
  }

  /* ── Explorá más ────────────────────────────────────────────────────
     Se quedó sin estilos cuando reescribí la página —las reglas vivían en el
     <style> viejo y no las traje—, así que salían como enlaces sueltos. De
     paso pasan a verse como el resto: tarjeta con el icono en su círculo y
     el mismo hover que los niveles. */
  .explore-more {
    padding-block: 0 4rem;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.85rem;
  }

  .explore-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.25;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.2s ease;
  }

  .explore-item:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent-c, var(--accent)) 45%, var(--border));
    box-shadow: var(--shadow-card-hover);
  }

  .explore-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 1.05rem;
    background: color-mix(in srgb, var(--accent-c, var(--accent)) 14%, transparent);
  }

  @media (max-width: 560px) {
    .explore-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* "29 lecciones" o "8/29 · 28%": corto, no hace falta que se parta. */
  [data-level-badge] {
    white-space: nowrap;
  }

  /* La barra ocupa el ancho que le deja el chip del conteo, a su derecha. */
  .lvl-track {
    flex: 1;
    min-width: 90px;
  }

  /* En un nivel bloqueado la barra siempre está en cero: cinco barras vacías
     seguidas son ruido, y el chip "Bloqueado" ya dice todo lo que hay que
     saber. */
  .silo-link.locked .lvl-track {
    display: none;
  }

  .silo-link.done .silo-fill {
    background: #22c55e;
  }
</style>
