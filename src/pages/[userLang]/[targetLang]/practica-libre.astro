---
import SiloToolPage from '../../../components/SiloToolPage.astro';
import Practice from '../../../components/Practice.astro';
import { LANGUAGE_MAP } from '../../../data/languages';
import { getCourseStaticPaths, getCourseLessons } from '../../../lib/courses';
import { getDictionary } from '../../../i18n';

export const getStaticPaths = getCourseStaticPaths;

const { userLang, targetLang: lang } = Astro.params;
const dict = getDictionary(userLang as never);
const tt = dict.tools.practicaLibre;
// El nombre del idioma meta traducido al idioma de la interfaz: 'Alemán' para
// un hispanohablante, 'Deutsch' para un alemán. src/data/languages.ts guarda
// una sola versión (en español), por eso sale del diccionario.
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];

const lessons = getCourseLessons(userLang!, lang!);

interface PoolItem {
  id: string;
  kind: string;
  data: unknown;
  box: number;
  due: string;
  lang: string;
  level: string;
}

const pool: PoolItem[] = lessons.flatMap((lesson) => {
  const level = lesson.id.split('/')[1] ?? '';
  const combined = [
    ...lesson.data.quiz.map((data) => ({ kind: 'choice', data })),
    ...lesson.data.exercises.map((data) => ({ kind: data.type, data })),
  ];
  return combined.map((item, i) => ({
    id: `${lesson.id}#${item.kind}-${i}`,
    kind: item.kind,
    data: item.data,
    box: 0,
    due: '',
    lang: lang ?? '',
    level,
  }));
});
---

<SiloToolPage
  userLang={userLang!}
  targetLang={lang!}
  tool="practicaLibre"
  slug="practica-libre"
  emoji="🎲"
  headClass="free-head"
  desc={tt.armando}
  descAttr="data-free-desc"
>
  <section class="container free-body">
    <div class="card empty-state" data-empty-state hidden>
      <p class="empty-emoji">🌱</p>
      <h2>Todavía no hay ejercicios para practicar</h2>
      <p>Completa alguna lección primero y vuelve por aquí.</p>
      <a class="btn btn-primary" href={`/${userLang}/${lang}`}>{dict.tools.comun.verLecciones}</a>
    </div>

    <Practice
      quiz={[]}
      exercises={[]}
      dynamic={true}
      sessionType="practice-libre"
      lessonId="practice-libre"
      minutes={5}
      lang={languageMeta?.bcp47}
      userLang={userLang}
    />

    <div hidden data-page-strings={JSON.stringify({ sesion: tt.sesion })}></div>
  </section>
</SiloToolPage>

<script define:vars={{ pool }}>
  window.POOL_ITEMS = pool;
</script>
<script>
  import {
    buildItemFieldset,
    primePracticeCounters,
    type SrsEntry,
  } from '../../../lib/practiceItemMarkup';
  import { shuffle } from '../../../lib/shuffle';
  import { readPageStrings, fill } from '../../../lib/pageStrings';

  const SESSION_SIZE = 12;
  const strings = readPageStrings({
    sesion: 'Una sesión aleatoria de {n} ítems, distinta cada vez que visitas esta página.',
  });

  function initFreePractice() {
    // [data-practice] es el markup genérico que Practice.astro renderiza en
    // toda página que lo use — acotarlo a esta sesión evita que este script
    // (cuyo listener de astro:page-load queda activo el resto de la
    // navegación SPA) toque el quiz de una lección o examen ajenos.
    const practiceRoot = document.querySelector<HTMLElement>(
      '[data-practice][data-session-type="practice-libre"]',
    );
    const container = practiceRoot?.querySelector<HTMLElement>('[data-items-container]');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
    const desc = document.querySelector<HTMLElement>('[data-free-desc]');
    if (!practiceRoot || !container) return;
    if (practiceRoot.dataset.freeBuilt) return;
    practiceRoot.dataset.freeBuilt = 'true';

    const pool = (window as unknown as { POOL_ITEMS?: SrsEntry[] }).POOL_ITEMS ?? [];
    const session = shuffle(pool).slice(0, SESSION_SIZE);

    if (session.length === 0) {
      if (emptyState) emptyState.hidden = false;
      practiceRoot.hidden = true;
      if (desc) desc.hidden = true;
      return;
    }

    if (desc) {
      desc.textContent = fill(strings.sesion, { n: session.length });
    }

    session.forEach((entry, i) => {
      container.appendChild(buildItemFieldset(entry, i));
    });

    primePracticeCounters(practiceRoot, session.length);

    document.dispatchEvent(new Event('astro:page-load'));
  }

  initFreePractice();
  document.addEventListener('astro:page-load', initFreePractice);
</script>

<style>
  .free-body {
    max-width: 680px;
    padding-block: 0 4rem;
  }
</style>
