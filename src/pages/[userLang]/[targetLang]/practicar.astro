---
import SiloToolPage from '../../../components/SiloToolPage.astro';
import Practice from '../../../components/Practice.astro';
import { LANGUAGE_MAP } from '../../../data/languages';
import { SKILLS } from '../../../data/skills';
import {
  getCourseLessons,
  getCourseStaticPaths,
  SPANISH_GLOSS_USER_LANG,
} from '../../../lib/courses';
import { getDictionary } from '../../../i18n';
import { fill } from '../../../lib/interpolate';

// Solo para los cursos que tienen habilidades definidas: hoy, alemán. El resto
// sigue con Repasar, que no ha cambiado. Cuando se definan las skills de otro
// idioma, esta página aparece sola para ese curso.
export async function getStaticPaths() {
  const conSkills = new Set(SKILLS.map((s) => s.lang));
  return (await getCourseStaticPaths()).filter((p: any) => conSkills.has(p.params.targetLang));
}

const { userLang, targetLang } = Astro.params;
const dict = getDictionary(userLang as never);
const languageMeta = LANGUAGE_MAP[targetLang as keyof typeof LANGUAGE_MAP];
const languageName = dict.languageNames[targetLang as keyof typeof dict.languageNames];

// El banco de ejercicios: cada ítem de cada lección etiquetada con skills,
// con el mismo id que usa el pool SRS (`<lessonId>#<índice>`) para que las dos
// cosas hablen de lo mismo.
//
// Se publica en el HTML y no se pide al servidor porque el sitio es estático:
// el build no sabe qué va a necesitar cada visitante, así que se manda el
// catálogo y el motor elige en el cliente. Es el mismo patrón que ya usa
// repasar.astro con [data-exercise-manifest].
const lessons = getCourseLessons(userLang!, targetLang!).filter(
  (l) => (l.data.skills ?? []).length > 0,
);

const bank = lessons.flatMap((l) => {
  const skills = l.data.skills ?? [];
  const items = [
    ...l.data.quiz.map((data) => ({ kind: 'choice', data })),
    ...l.data.exercises.map((data) => ({ kind: data.type, data })),
  ];
  return items.map((item, i) => ({ id: `${l.id}#${i}`, ...item, skills }));
});

const skills = SKILLS.filter((s) => s.lang === targetLang);

// La reparación intensiva solo se ofrece donde sus plantillas están escritas.
//
// REPAIR_TEMPLATES guarda `explanation` y `translation` en un solo idioma, el
// español, indexadas por skillId —que lleva el idioma META—, así que la misma
// plantilla sirve a es-de y a en-de. Sin este filtro, un angloparlante con
// errores acumulados recibía cinco ejercicios con la explicación y las
// traducciones en castellano. Se cae al `generateExercise()` normal, que tira
// del banco de las propias lecciones y por tanto está en inglés.
//
// Mismo criterio que el gate de DrillTutor.astro y que tsaFor() en tsa.ts.
const repairEnabled = userLang === SPANISH_GLOSS_USER_LANG;

// Los textos de la página. Estaban escritos a mano en el markup —era la única
// de las seis herramientas así— y por eso /en/de/practicar salía en español
// aunque el diccionario inglés estuviera completo.
const t = dict.tools.practicar;
// Los que pinta el <script> sobre la sesión ya armada no pueden leer el
// diccionario (se resuelve en el servidor): van por [data-page-strings].
const pageStrings = {
  elegidos: t.elegidos,
  progresoGeneral: t.progresoGeneral,
  motivos: t.motivos,
  categorias: t.categorias,
};
---

<SiloToolPage
  userLang={userLang!}
  targetLang={targetLang!}
  slug="practicar"
  emoji="🎯"
  headClass="adaptive-head"
  ownHeadStyles
  name={dict.tools.comun.practicar}
  title={fill(t.metaTitulo, { lang: languageName })}
  description={fill(t.metaDescripcion, { lang: languageName })}
  h1={fill(t.h1, { lang: languageName })}
  desc={t.preparando}
  descAttr="data-practice-desc"
  siloContext={{
    userLang: userLang!,
    targetLang: targetLang!,
    restPath: '/practicar',
    breadcrumbs: [
      { name: dict.silo.idiomas, href: `/${userLang}` },
      { name: languageName, href: `/${userLang}/${targetLang}` },
      { name: dict.tools.comun.practicar, href: `/${userLang}/${targetLang}/practicar` },
    ],
  }}
>
  <Fragment slot="head">
    {
      /* Por qué el motor eligió esto. Se muestra para que la sesión no parezca
        una lista al azar: si estás reparando un error, tenés que saberlo. */
    }
    <div class="reason-card card" data-reason hidden>
      <span class="reason-tag" data-reason-tag></span>
      <p class="reason-text" data-reason-text></p>
    </div>
  </Fragment>

  <section class="container adaptive-body">
    <div class="card empty-state" data-empty hidden>
      <p class="empty-emoji">🌱</p>
      <h2>{t.vacioTitulo}</h2>
      <p>{t.vacioDesc}</p>
      <a class="btn btn-primary" href={`/${userLang}/${targetLang}`}
        >{dict.tools.comun.verLecciones}</a
      >
    </div>

    <Practice
      quiz={[]}
      exercises={[]}
      dynamic={true}
      sessionType="review"
      lessonId="practicar"
      minutes={5}
      lang={languageMeta?.bcp47}
      userLang={userLang}
    />
  </section>

  <section class="container dashboard" data-dashboard hidden>
    <span class="eyebrow">{fill(t.progresoTitulo, { lang: languageName })}</span>
    <div class="dash-overall">
      <div class="silo-track"><span class="silo-fill" data-dash-fill></span></div>
      <p class="dash-overall-text" data-dash-text></p>
    </div>

    <div class="dash-cats" data-dash-cats></div>

    <div class="dash-weak" data-dash-weak hidden>
      <h2>{t.debilesTitulo}</h2>
      <ul class="weak-list" data-weak-list></ul>
    </div>
  </section>

  <div hidden data-skill-bank={JSON.stringify(bank)}></div>
  <div hidden data-skill-catalog={JSON.stringify(skills)}></div>
  <div hidden data-repair-enabled={String(repairEnabled)}></div>
  <div hidden data-page-strings={JSON.stringify(pageStrings)}></div>
</SiloToolPage>

<script>
  import { buildItemFieldset, primePracticeCounters } from '../../../lib/practiceItemMarkup';
  import { getState } from '../../../lib/engine/learnerStore';
  import { buildSession, type Candidate } from '../../../lib/engine/scheduler';
  import {
    generateExercise,
    generateRepairSet,
    type BankItem,
  } from '../../../lib/engine/exerciseGenerator';
  import { needsIntensiveRepair } from '../../../lib/engine/errors';
  import { readPageStrings, fill } from '../../../lib/pageStrings';
  import type { Exercise, Skill } from '../../../lib/engine/types';

  const SESSION_SIZE = 10;

  // Los textos que este script escribe. Llegan del servidor ya en el idioma de
  // la página; el fallback es el español, que es lo que había escrito a mano
  // acá antes y lo que se usaría si el atributo faltara.
  const S = readPageStrings({
    elegidos: '{n} ejercicios elegidos para ti.',
    progresoGeneral: 'Progreso general {pct}% · {n} de {total} habilidades empezadas',
    motivos: {} as Record<string, { tag: string; texto: string }>,
    categorias: {} as Record<string, string>,
  });

  function readJson<T>(selector: string, attr: string, fallback: T): T {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el) return fallback;
    try {
      return JSON.parse(el.dataset[attr] ?? '') as T;
    } catch {
      return fallback;
    }
  }

  // Las claves son los ids que devuelve el scheduler; el texto sale del
  // diccionario vía [data-page-strings].
  const MOTIVOS: Record<string, { tag: string; texto: string }> = S.motivos;

  function initAdaptivePractice() {
    const root = document.querySelector<HTMLElement>('[data-practice][data-session-type="review"]');
    const container = root?.querySelector<HTMLElement>('[data-items-container]');
    const vacio = document.querySelector<HTMLElement>('[data-empty]');
    const desc = document.querySelector<HTMLElement>('[data-practice-desc]');
    if (!root || !container || root.dataset.adaptiveBuilt) return;
    root.dataset.adaptiveBuilt = 'true';

    const bank = readJson<BankItem[]>('[data-skill-bank]', 'skillBank', []);
    const catalog = readJson<Skill[]>('[data-skill-catalog]', 'skillCatalog', []);
    // Lo decide el servidor: las plantillas de reparación solo existen en
    // español. Ver el comentario del frontmatter.
    const repairEnabled =
      document.querySelector<HTMLElement>('[data-repair-enabled]')?.dataset.repairEnabled ===
      'true';
    const state = getState();

    // El motor decide. La página solo pinta lo que le dicen.
    const sesion = buildSession(
      { skills: catalog, progress: state.progress, errors: Object.values(state.errors) },
      SESSION_SIZE,
    );

    const ejercicios: { exercise: Exercise; candidate: Candidate }[] = [];
    const usados: string[] = [];

    for (const candidato of sesion) {
      const skill = catalog.find((s) => s.id === candidato.skillId);
      if (!skill) continue;
      const dificultad = state.settings.difficulty[skill.id] ?? skill.difficulty;

      // Reparación intensiva: cinco variaciones dirigidas al patrón, no un
      // ejercicio suelto. Es la diferencia entre "volvé a intentarlo" y
      // "vamos a trabajar esto".
      if (repairEnabled && candidato.error && needsIntensiveRepair(candidato.error)) {
        const tanda = generateRepairSet(skill, 5);
        if (tanda.length > 0) {
          for (const ej of tanda) ejercicios.push({ exercise: ej, candidate: candidato });
          continue;
        }
      }

      const ej = generateExercise({ skill, difficulty: dificultad, bank, exclude: usados });
      if (!ej) continue;
      usados.push(ej.id);
      ejercicios.push({ exercise: ej, candidate: candidato });
    }

    if (ejercicios.length === 0) {
      if (vacio) vacio.hidden = false;
      root.hidden = true;
      if (desc) desc.hidden = true;
      return;
    }

    // Mapa exacto ítem→habilidad, para que EngineTracker atribuya cada
    // resultado a la habilidad correcta en vez de a todas las de una lección.
    const itemSkills: Record<string, string[]> = {};
    for (const { exercise } of ejercicios) itemSkills[exercise.id] = [exercise.skillId];
    const mapa = document.createElement('div');
    mapa.hidden = true;
    mapa.dataset.itemSkills = JSON.stringify(itemSkills);
    document.body.appendChild(mapa);

    ejercicios.forEach(({ exercise }, i) => {
      const item = exercise.render ?? { kind: 'choice', data: {} };
      const fieldset = buildItemFieldset({ ...item, id: exercise.id } as any, i);
      container.appendChild(fieldset);
    });

    primePracticeCounters(root, ejercicios.length);

    // El motivo del PRIMER ejercicio es el que explica la sesión.
    const primero = ejercicios[0].candidate;
    const motivo = MOTIVOS[primero.reason];
    const caja = document.querySelector<HTMLElement>('[data-reason]');
    if (caja && motivo) {
      const skill = catalog.find((s) => s.id === primero.skillId);
      caja.hidden = false;
      const tag = caja.querySelector<HTMLElement>('[data-reason-tag]');
      const texto = caja.querySelector<HTMLElement>('[data-reason-text]');
      if (tag) tag.textContent = `${motivo.tag}${skill ? ` · ${skill.name}` : ''}`;
      if (texto) {
        // En reparación se explica la regla antes de preguntar: explicación
        // corta, producción, repetición. No una clase.
        texto.textContent = ejercicios[0].exercise.explanation || motivo.texto;
      }
    }

    if (desc) {
      desc.textContent = fill(S.elegidos, { n: ejercicios.length });
    }

    document.dispatchEvent(new Event('astro:page-load'));
  }

  /**
   * Etiquetas de las categorías, en el orden en que se muestran.
   *
   * El ORDEN vive acá porque es una decisión de la página; los ids son los de
   * `Skill.category` y no se traducen. El texto sale del diccionario.
   */
  const CATEGORIAS: [string, string][] = (
    ['grammar', 'vocabulary', 'word_order', 'pronunciation', 'writing'] as const
  ).map((id) => [id, S.categorias[id] ?? id]);

  /** Punto de color según lo urgente que sea, igual que en el documento. */
  function semaforo(status: string): string {
    if (status === 'weak') return '🔴';
    if (status === 'learning') return '🟡';
    return '🟢';
  }

  function renderDashboard() {
    const caja = document.querySelector<HTMLElement>('[data-dashboard]');
    if (!caja) return;
    const catalog = readJson<Skill[]>('[data-skill-catalog]', 'skillCatalog', []);
    const state = getState();
    const practicadas = catalog.filter((s) => (state.progress[s.id]?.attempts ?? 0) > 0);

    // Sin nada practicado el dashboard no dice nada útil: mejor no mostrarlo
    // que mostrar seis ceros.
    if (practicadas.length === 0) return;
    caja.hidden = false;

    const media = Math.round(
      catalog.reduce((n, s) => n + (state.progress[s.id]?.mastery ?? 0), 0) / catalog.length,
    );
    // `barra`, no `fill`: ese nombre lo ocupa ahora el interpolador de
    // pageStrings, y el local lo tapaba.
    const barra = caja.querySelector<HTMLElement>('[data-dash-fill]');
    if (barra) barra.style.width = media + '%';
    const texto = caja.querySelector<HTMLElement>('[data-dash-text]');
    if (texto) {
      texto.textContent = fill(S.progresoGeneral, {
        pct: media,
        n: practicadas.length,
        total: catalog.length,
      });
    }

    // Media por categoría, solo de las que existen en este curso.
    const cats = caja.querySelector<HTMLElement>('[data-dash-cats]');
    if (cats) {
      cats.innerHTML = '';
      for (const [id, etiqueta] of CATEGORIAS) {
        const delTipo = catalog.filter((s) => s.category === id);
        if (delTipo.length === 0) continue;
        const pct = Math.round(
          delTipo.reduce((n, s) => n + (state.progress[s.id]?.mastery ?? 0), 0) / delTipo.length,
        );
        const fila = document.createElement('div');
        fila.className = 'dash-cat';
        const nombre = document.createElement('span');
        nombre.className = 'dash-cat-name';
        nombre.textContent = etiqueta;
        const barra = document.createElement('span');
        barra.className = 'silo-track dash-cat-track';
        const relleno = document.createElement('span');
        relleno.className = 'silo-fill';
        relleno.style.width = pct + '%';
        barra.appendChild(relleno);
        const valor = document.createElement('span');
        valor.className = 'dash-cat-value';
        valor.textContent = pct + '%';
        fila.append(nombre, barra, valor);
        cats.appendChild(fila);
      }
    }

    // Lo que hay que practicar, con el MISMO criterio con el que el motor
    // elige: no una lista aparte que pueda contradecir a la sesión.
    const flojas = buildSession(
      { skills: catalog, progress: state.progress, errors: Object.values(state.errors) },
      6,
      // Solo lo que de verdad va mal: un repaso pendiente o una habilidad
      // nueva no son un problema, y mezclarlos bajo "Necesitas practicar"
      // hacía que apareciera una habilidad en verde en la lista de avisos.
    ).filter(
      (c) =>
        c.reason === 'severe_error' || c.reason === 'persistent_error' || c.reason === 'weak_skill',
    );

    const bloque = caja.querySelector<HTMLElement>('[data-dash-weak]');
    const lista = caja.querySelector<HTMLElement>('[data-weak-list]');
    if (bloque && lista && flojas.length > 0) {
      bloque.hidden = false;
      lista.innerHTML = '';
      for (const c of flojas) {
        const skill = catalog.find((s) => s.id === c.skillId);
        if (!skill) continue;
        const p = state.progress[skill.id];
        const li = document.createElement('li');
        li.textContent = `${semaforo(p?.status ?? 'new')} ${skill.name}`;
        if (c.error) li.textContent += ` · ${c.error.occurrences} fallos`;
        lista.appendChild(li);
      }
    }
  }

  initAdaptivePractice();
  renderDashboard();
  document.addEventListener('astro:page-load', initAdaptivePractice);
</script>

<style>
  /* No se llama .practice-head: ese nombre ya lo usa Practice.astro para su
     propia cabecera con display:flex, y la regla alcanzaba a esta sección
     dejándola en una fila. */
  :global(.adaptive-head) {
    padding-block: 2.5rem 1rem;
    max-width: 680px;
  }

  .reason-card {
    margin-top: 1.25rem;
    padding: 1rem 1.15rem;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-card));
  }

  .reason-tag {
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .reason-text {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .adaptive-body {
    padding-block: 1rem 2rem;
  }

  /* Dashboard: mismo lenguaje visual que el camino del silo (.silo-track y
     .silo-fill vienen de global.css), sin librerías de gráficos. */
  .dashboard {
    padding-block: 1rem 4rem;
    max-width: 680px;
  }

  .dash-overall-text {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .dash-cats {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  /* Estas filas las crea el JS, así que NO llevan el atributo de scope de
     Astro y una regla scoped no las alcanza. Se anclan al contenedor, que sí
     está en la plantilla, y el hijo va con :global(). Mismo patrón que
     IconToggle con sus iconos por slot. */
  .dash-cats :global(.dash-cat) {
    display: grid;
    grid-template-columns: minmax(90px, 30%) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
  }

  .dash-cats :global(.dash-cat-name) {
    font-weight: 600;
  }

  /* .silo-track está pensada para un contenedor de bloque; sobre un <span>
     inline la altura no aplica y el border-radius lo deja hecho un círculo. */
  .dash-cats :global(.dash-cat-track) {
    display: block;
  }

  .dash-cats :global(.dash-cat-value) {
    font-weight: 700;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .dash-weak {
    margin-top: 2rem;
  }

  .dash-weak h2 {
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }

  .weak-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
  }

  /* Los <li> también los crea el JS. */
  .weak-list :global(li) {
    line-height: 1.4;
  }
</style>
