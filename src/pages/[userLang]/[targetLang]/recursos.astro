---
import SiloToolPage from '../../../components/SiloToolPage.astro';
import { getDictionary } from '../../../i18n';
import { LANGUAGE_MAP } from '../../../data/languages';
import { getSpanishGlossCourseStaticPaths } from '../../../lib/courses';
import { RESOURCES, CATEGORY_LABELS, type ResourceItem } from '../../../data/resources';

// Solo se genera dentro del silo español: el contenido de esta herramienta
// guarda su traducción en español y no tiene eje userLang. Ver
// getSpanishGlossCourseStaticPaths() en src/lib/courses.ts.
export const getStaticPaths = getSpanishGlossCourseStaticPaths;

const { userLang, targetLang } = Astro.params;
const dict = getDictionary(userLang as never);
const lang = targetLang;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];
const items = RESOURCES[lang as keyof typeof RESOURCES] ?? [];

const categories = (Object.keys(CATEGORY_LABELS) as ResourceItem['category'][]).map((category) => ({
  category,
  label: CATEGORY_LABELS[category],
  items: items.filter((item) => item.category === category),
}));
---

<SiloToolPage
  userLang={userLang!}
  targetLang={lang!}
  slug="recursos"
  emoji="📻"
  headClass="resources-head"
  name={dict.silo.explorar.recursos}
  title={`Recursos de ${languageMeta?.name} para practicar fuera de la app`}
  description={`Podcasts, series, películas y libros reales para seguir practicando ${languageMeta?.name} fuera de PolyLingua, elegidos por nivel.`}
  h1={`Recursos de ${languageMeta?.name}`}
  desc="Aprender de verdad requiere contacto diario con el idioma, no solo lecciones. Estos son recursos reales para seguir practicando por tu cuenta."
>
  <section class="container resources-body">
    {
      items.length === 0 ? (
        <div class="card empty-state">
          <p class="empty-emoji">🚧</p>
          <h2>Todavía no hay recursos para {languageMeta?.name}</h2>
          <p>Estamos sumando recomendaciones para este idioma — volvé pronto.</p>
        </div>
      ) : (
        categories
          .filter((c) => c.items.length > 0)
          .map((c) => (
            <div class="card resource-group">
              <span class="eyebrow">{c.label}</span>
              <ul class="resource-list">
                {c.items.map((item) => (
                  <li class="resource-item">
                    <span class="resource-title">{item.title}</span>
                    {item.level && <span class="resource-level">{item.level}</span>}
                    <p class="resource-note">{item.note}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
      )
    }
  </section>
</SiloToolPage>

<style>
  .resources-body {
    max-width: 680px;
    padding-block: 0 4rem;
    display: grid;
    gap: 1.25rem;
  }

  .resource-group {
    padding: 1.5rem;
  }

  .resource-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .resource-item {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .resource-item:first-child {
    padding-top: 0;
    border-top: none;
  }

  .resource-title {
    font-weight: 700;
  }

  .resource-level {
    margin-left: 0.5rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .resource-note {
    color: var(--text-muted);
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
  }
</style>
