---
import SiloToolPage from '../../../components/SiloToolPage.astro';
import Practice from '../../../components/Practice.astro';
import { LANGUAGE_MAP } from '../../../data/languages';
import { getCourseStaticPaths, getCourseLessons } from '../../../lib/courses';
import { getDictionary } from '../../../i18n';

export const getStaticPaths = getCourseStaticPaths;

const { userLang, targetLang: lang } = Astro.params;
const dict = getDictionary(userLang as never);
const tt = dict.tools.repasar;
// El nombre del idioma meta traducido al idioma de la interfaz: 'Alemán' para
// un hispanohablante, 'Deutsch' para un alemán. src/data/languages.ts guarda
// una sola versión (en español), por eso sale del diccionario.
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];

// Manifest lección→ítems de este idioma, para poder ofrecer al repasar un
// ejercicio distinto de la misma lección en vez de repetir exactamente la
// frase que se falló (repetición espaciada con contexto nuevo, no
// memorización de una frase puntual). Acotado a un idioma, mismo patrón que
// vocabulario.astro.
const lessonsForLang = getCourseLessons(userLang!, lang!);
const exerciseManifest = Object.fromEntries(
  lessonsForLang.map((l) => [
    l.id,
    [
      ...l.data.quiz.map((data) => ({ kind: 'choice', data })),
      ...l.data.exercises.map((data) => ({ kind: data.type, data })),
    ],
  ]),
);

// Manifest lección→tema gramatical de este idioma, para poder filtrar el
// repaso por tema (ver el chip row data-topic-filters más abajo) sin tener
// que parsear el id de la lección para adivinar el tema.
const topicManifest = Object.fromEntries(lessonsForLang.map((l) => [l.id, l.data.grammarTopic]));
---

<SiloToolPage
  userLang={userLang!}
  targetLang={lang!}
  tool="repasar"
  slug="repasar"
  emoji="📚"
  headClass="review-head"
  desc={tt.cargando}
  descAttr="data-review-desc"
>
  <Fragment slot="head">
    <div class="topic-filters" data-topic-filters hidden></div>
  </Fragment>

  <section class="container review-body">
    <div class="card empty-state" data-empty-state hidden>
      <p class="empty-emoji">🎉</p>
      <h2>No te queda nada por repasar hoy</h2>
      <p>Vuelve mañana, o sigue avanzando con lecciones nuevas mientras tanto.</p>
      <a class="btn btn-primary" href={`/${userLang}/${lang}`}>{dict.tools.comun.verLecciones}</a>
    </div>

    <Practice
      quiz={[]}
      exercises={[]}
      dynamic={true}
      sessionType="review"
      lessonId="review"
      minutes={1}
      lang={languageMeta?.bcp47}
      userLang={userLang}
    />
  </section>

  <div hidden data-exercise-manifest={JSON.stringify(exerciseManifest)}></div>
  <div hidden data-topic-manifest={JSON.stringify(topicManifest)}></div>
  <div
    hidden
    data-page-strings={JSON.stringify({
      todos: dict.tools.comun.todos,
      mastery: dict.tools.comun.mastery,
      caja: dict.tools.comun.caja,
      pendiente: tt.pendiente,
      pendientes: tt.pendientes,
    })}
  >
  </div>
</SiloToolPage>

<script>
  import {
    buildItemFieldset,
    primePracticeCounters,
    type SrsEntry,
  } from '../../../lib/practiceItemMarkup';
  import { today, getActiveSprint, markSprintDayDone } from '../../../lib/storage';
  import { matchesLang } from '../../../lib/srs';
  import { shuffle } from '../../../lib/shuffle';
  import { readPageStrings, fill } from '../../../lib/pageStrings';

  // MASTERY_LABELS de src/lib/srs.ts está solo en español; las etiquetas que
  // ve el usuario llegan traducidas por [data-page-strings].
  const strings = readPageStrings({
    todos: 'Todos ({n})',
    mastery: ['Nueva', 'Aprendiendo', 'Familiar', 'Buena', 'Dominada', 'Muy dominada'],
    caja: 'Caja {n}',
    pendiente: 'Tienes {n} ítem por repasar{detalle}',
    pendientes: 'Tienes {n} ítems por repasar{detalle}',
  });

  interface ManifestItem {
    kind: string;
    data: unknown;
  }

  function readPool(): Record<string, SrsEntry> {
    try {
      return JSON.parse(localStorage.getItem('polylingua-srs-pool') ?? '{}');
    } catch {
      return {};
    }
  }

  function readExerciseManifest(): Record<string, ManifestItem[]> {
    const manifestEl = document.querySelector<HTMLElement>('[data-exercise-manifest]');
    if (!manifestEl) return {};
    try {
      return JSON.parse(manifestEl.dataset.exerciseManifest ?? '{}');
    } catch {
      return {};
    }
  }

  function readTopicManifest(): Record<string, string> {
    const manifestEl = document.querySelector<HTMLElement>('[data-topic-manifest]');
    if (!manifestEl) return {};
    try {
      return JSON.parse(manifestEl.dataset.topicManifest ?? '{}');
    } catch {
      return {};
    }
  }

  // Chips "Todos" + un chip por tema presente entre los ítems vencidos, con
  // cantidad. data-astro-reload fuerza una navegación real (no SPA) al
  // clickear uno — mismo patrón que ya usan los links de Repasar en
  // Header/BottomNav — para que initReview() vuelva a correr de cero con el
  // nuevo ?tema= en vez de tener que reconciliar el estado ya iniciado de
  // Practice.astro sobre el mismo root.
  function renderTopicFilters(
    dueAll: SrsEntry[],
    topicManifest: Record<string, string>,
    selectedTopic: string | null,
  ) {
    const container = document.querySelector<HTMLElement>('[data-topic-filters]');
    if (!container) return;

    const counts = new Map<string, number>();
    for (const entry of dueAll) {
      const topic = topicManifest[entry.id.split('#')[0]];
      if (!topic) continue;
      counts.set(topic, (counts.get(topic) ?? 0) + 1);
    }

    if (counts.size < 2) {
      container.hidden = true;
      return;
    }

    container.innerHTML = '';
    container.hidden = false;

    const basePath = window.location.pathname;

    const allChip = document.createElement('a');
    allChip.className = selectedTopic ? 'topic-chip' : 'topic-chip is-active';
    allChip.href = basePath;
    allChip.dataset.astroReload = 'true';
    allChip.textContent = fill(strings.todos, { n: dueAll.length });
    container.appendChild(allChip);

    const sortedTopics = [...counts.entries()].sort((a, b) => b[1] - a[1]);
    for (const [topic, count] of sortedTopics) {
      const chip = document.createElement('a');
      chip.className = topic === selectedTopic ? 'topic-chip is-active' : 'topic-chip';
      chip.href = `${basePath}?tema=${encodeURIComponent(topic)}`;
      chip.dataset.astroReload = 'true';
      chip.textContent = `${topic} (${count})`;
      container.appendChild(chip);
    }
  }

  // En vez de repasar la frase exacta que se falló, ofrece otro ítem de la
  // misma lección (mismo tema gramatical) cuando hay alternativas — refuerza
  // la regla en vez de memorizar una frase puntual. Si no hay alternativa
  // (lección con un solo ítem, o manifest sin esa lección), cae al
  // comportamiento anterior: mostrar la data original.
  function pickReviewItem(entry: SrsEntry, manifest: Record<string, ManifestItem[]>): SrsEntry {
    const lessonId = entry.id.split('#')[0];
    const pool = manifest[lessonId] ?? [];
    const alternatives = pool.filter(
      (item) =>
        item.kind !== entry.kind || JSON.stringify(item.data) !== JSON.stringify(entry.data),
    );
    if (alternatives.length === 0) return entry;
    const chosen = shuffle(alternatives)[0];
    return { ...entry, kind: chosen.kind, data: chosen.data };
  }

  function initReview() {
    // [data-practice] es el markup genérico que Practice.astro renderiza en
    // toda página que lo use (lección, examen, práctica libre) — acotarlo a
    // esta sesión evita que este script, cuyo listener de astro:page-load
    // queda activo para el resto de la navegación SPA, toque el quiz de una
    // lección o examen visitados después de pasar por /repasar.
    const practiceRoot = document.querySelector<HTMLElement>(
      '[data-practice][data-session-type="review"]',
    );
    const container = practiceRoot?.querySelector<HTMLElement>('[data-items-container]');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
    const desc = document.querySelector<HTMLElement>('[data-review-desc]');
    if (!practiceRoot || !container) return;
    if (practiceRoot.dataset.reviewBuilt) return;
    practiceRoot.dataset.reviewBuilt = 'true';

    const lang = window.location.pathname.split('/')[2] ?? '';
    const pool = readPool();
    const topicManifest = readTopicManifest();
    const selectedTopic = new URLSearchParams(window.location.search).get('tema');

    const dueAll = Object.values(pool).filter(
      (entry) => matchesLang(entry.lang, lang!) && entry.due <= today(),
    );
    renderTopicFilters(dueAll, topicManifest, selectedTopic);

    const due = (
      selectedTopic
        ? dueAll.filter((entry) => topicManifest[entry.id.split('#')[0]] === selectedTopic)
        : dueAll
    ).slice(0, 20);

    if (due.length === 0) {
      if (emptyState) emptyState.hidden = false;
      practiceRoot.hidden = true;
      if (desc) desc.hidden = true;
      return;
    }

    if (desc) {
      const boxCounts = new Map<number, number>();
      for (const e of due) boxCounts.set(e.box, (boxCounts.get(e.box) ?? 0) + 1);
      const parts: string[] = [];
      for (const [box, count] of [...boxCounts.entries()].sort((a, b) => a[0] - b[0])) {
        parts.push(`${count} ${(strings.mastery[box] ?? '').toLowerCase()}`);
      }
      desc.textContent = fill(due.length === 1 ? strings.pendiente : strings.pendientes, {
        n: due.length,
        detalle: parts.length > 0 ? `: ${parts.join(', ')}.` : '.',
      });
    }

    const manifest = readExerciseManifest();
    due.forEach((entry, i) => {
      const fieldset = buildItemFieldset(pickReviewItem(entry, manifest), i);
      const masteryTag = document.createElement('span');
      masteryTag.className = 'mastery-tag';
      masteryTag.textContent = strings.mastery[entry.box] ?? fill(strings.caja, { n: entry.box });
      if (entry.failCount && entry.failCount > 0) {
        masteryTag.textContent += ` · ${entry.failCount}×`;
      }
      const kindTag = fieldset.querySelector('.kind-tag');
      if (kindTag) kindTag.after(masteryTag);
      else fieldset.prepend(masteryTag);
      container.appendChild(fieldset);
    });

    primePracticeCounters(practiceRoot, due.length);

    document.dispatchEvent(new Event('astro:page-load'));
  }

  // El sprint semanal de /logros cuenta en qué fechas se completó una sesión
  // de repaso filtrada por su tema (?tema=) — enganchado a document (no al
  // practiceRoot puntual) con guard de módulo, mismo patrón que
  // ProgressTracker.astro/DailyGoal.astro usan para su listener de
  // practice-complete, así no se duplica bajo navegación SPA repetida a
  // /repasar.
  let sprintHookAttached = false;

  function initSprintHook() {
    if (sprintHookAttached) return;
    sprintHookAttached = true;
    document.addEventListener('practice-complete', ((e: CustomEvent) => {
      if (e.detail?.sessionType !== 'review') return;
      const lang = window.location.pathname.split('/')[2] ?? '';
      const selectedTopic = new URLSearchParams(window.location.search).get('tema');
      if (!selectedTopic) return;
      const sprint = getActiveSprint();
      if (!sprint || sprint.lang !== lang || sprint.topic !== selectedTopic) return;
      markSprintDayDone(lang, selectedTopic);
    }) as EventListener);
  }

  initReview();
  initSprintHook();
  document.addEventListener('astro:page-load', initReview);
</script>

<style>
  .topic-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  /* Los chips se crean con document.createElement en JS a partir del pool
     de SRS — nunca reciben el atributo de scoping de Astro, así que hace
     falta :global() para que este CSS los alcance (mismo patrón que
     .pending-list en /logros). */
  .topic-filters :global(.topic-chip) {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .topic-filters :global(.topic-chip:hover) {
    border-color: var(--accent);
    color: var(--text);
  }

  .topic-filters :global(.topic-chip.is-active) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent-text);
  }

  .review-body {
    max-width: 680px;
    padding-block: 0 4rem;
  }

  .review-body :global(.mastery-tag) {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-text);
    margin-left: 0.4rem;
  }
</style>
