---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { AUTHOR } from '../../data/author';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat('es', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const siteURL = Astro.site!.origin;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog de PolyLingua',
  description:
    'Trucos de gramática, comparativas con otras apps y consejos para aprender idiomas gratis.',
  url: `${siteURL}/blog`,
  mainEntity: {
    '@type': 'Blog',
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${siteURL}/blog/${p.id}`,
      datePublished: p.data.publishDate.toISOString(),
      author: { '@type': 'Person', '@id': `${siteURL}/acerca#autor`, name: p.data.author },
    })),
  },
};
---

<BaseLayout
  title="Blog de PolyLingua"
  description="Trucos de gramática, comparativas con otras apps y consejos para aprender alemán, inglés, francés, italiano y portugués gratis."
  path="/blog"
  structuredData={structuredData}
>
  <section class="container page-head">
    <span class="eyebrow">Blog</span>
    <h1>Artículos para aprender idiomas de verdad</h1>
    <p>
      Trucos de gramática, comparativas honestas con otras apps, y todo lo que aprendí construyendo
      un curso gratuito de 5 idiomas. Los escribe <a href="/acerca">{AUTHOR.name}</a>.
    </p>
  </section>

  <section class="container posts-grid">
    {posts.length === 0 && <p class="empty">Muy pronto vamos a publicar el primer artículo.</p>}
    {
      posts.map((post) => (
        <a class="post-card card card-glow" href={`/blog/${post.id}`}>
          <time datetime={post.data.publishDate.toISOString()}>
            {dateFormatter.format(post.data.publishDate)}
          </time>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: 3rem 2rem;
    max-width: 640px;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0.6rem 0 0.75rem;
  }

  .page-head p {
    color: var(--text-muted);
  }

  .page-head a {
    color: var(--accent-text);
  }

  /* Una columna en móvil, dos en tablet y tres en escritorio. Los cortes son
     640px y 960px, los mismos que ya usa el resto del sitio. Con el contenedor
     a 1120px, tres columnas dejan tarjetas de ~340px: suficiente para que el
     título respire y no tan anchas como para que la descripción se convierta
     en un renglón interminable. */
  .posts-grid {
    display: grid;
    gap: 1.5rem;
    padding-block: 1rem 4rem;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .post-card {
    /* Columna flexible para que todas las tarjetas de una fila midan lo mismo
       y las etiquetas queden alineadas abajo (margin-top: auto), en vez de
       colgar de una descripción que en cada tarjeta ocupa distinto. */
    display: flex;
    flex-direction: column;
    /* Mismo motivo que en DialogueCard: sin esto, un título con una palabra
       larga ensancha la tarjeta más allá del contenedor. */
    min-width: 0;
    overflow-wrap: break-word;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--text);
  }

  /* El hover (elevación, borde y glow radial) sale de .card-glow, que ya usan
     LanguageCard y los selectores de idioma. Antes esta tarjeta se movía sola
     con un translateY propio; ahora se comporta igual que el resto. */
  .post-card:hover h2,
  .post-card:focus-visible h2 {
    color: var(--accent-text);
  }

  .post-card time {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.55rem;
  }

  .post-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
    line-height: 1.25;
    transition: color 0.15s ease;
  }

  /* La descripción se corta a tres líneas. Las meta descriptions van de 130 a
     160 caracteres porque eso es lo que pide el SEO, pero volcadas enteras en
     la tarjeta son un párrafo que nadie lee y que además descuadra las alturas
     de la fila. Tres líneas alcanzan para decidir si el artículo interesa; el
     texto completo sigue entero en la meta description y en el post. */
  .post-card p {
    margin: 0 0 1rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  /* Las etiquetas eran píldoras con borde y fondo: dentro de una tarjeta que
     entera es un enlace parecían botones, y no lo son —no llevan a ningún
     lado—. Además, una etiqueta de dos palabras partía en dos líneas dentro
     de su píldora y dejaba la fila con alturas desparejas.
     Ahora son lo que son: una línea de metadatos separada por puntos, debajo
     de una regla fina que cierra la tarjeta. */
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    padding: 0.85rem 0 0;
    /* auto: empuja las etiquetas al pie de la tarjeta, así la regla queda a la
       misma altura en toda la fila aunque un título ocupe dos líneas y otro
       tres. */
    margin: auto 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .tags li + li::before {
    content: '·';
    margin-right: 0.5rem;
    opacity: 0.55;
  }

  .empty {
    color: var(--text-muted);
  }
</style>
