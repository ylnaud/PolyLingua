---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Diagnóstico de instalación"
  description="Chequeo técnico de por qué PolyLingua no se puede instalar como app en este navegador."
  path="/debug-pwa"
  noindex
>
  <section class="container debug-head">
    <span class="emoji" aria-hidden="true">🔧</span>
    <h1>Diagnóstico de instalación</h1>
    <p class="desc">
      Esta página revisa, en este navegador puntual, por qué puede no aparecer la opción de
      instalar PolyLingua como app. Sacale una captura de pantalla a lo que aparezca abajo y
      mandala — no hace falta que entiendas los detalles técnicos.
    </p>
  </section>

  <section class="container debug-body">
    <div class="card status-card" data-status-card>
      <span class="eyebrow">⏳ Corriendo el chequeo…</span>
      <dl class="status-list" data-status-list></dl>
    </div>

    <div class="card copy-card">
      <span class="eyebrow">📋 Texto para copiar</span>
      <textarea readonly rows="10" data-copy-text aria-label="Resultado del diagnóstico en texto plano"
        >Corriendo el chequeo…</textarea
      >
      <button type="button" class="btn btn-primary copy-btn" data-copy-btn>Copiar diagnóstico</button>
      <p class="copy-hint" data-copy-hint hidden>Copiado ✓</p>
    </div>
  </section>
</BaseLayout>

<script>
  interface CheckResult {
    label: string;
    ok: boolean | null;
    detail: string;
  }

  function buildPlainText(results: CheckResult[]): string {
    const lines = results.map((r) => `${r.ok === null ? '⏳' : r.ok ? '✅' : '❌'} ${r.label}: ${r.detail}`);
    return `Diagnóstico PolyLingua — ${new Date().toISOString()}\n${lines.join('\n')}`;
  }

  function renderResults(results: CheckResult[]) {
    const list = document.querySelector<HTMLElement>('[data-status-list]');
    const eyebrow = document.querySelector<HTMLElement>('[data-status-card] .eyebrow');
    const copyText = document.querySelector<HTMLTextAreaElement>('[data-copy-text]');
    if (!list) return;

    list.innerHTML = '';
    for (const r of results) {
      const dt = document.createElement('dt');
      dt.textContent = `${r.ok === null ? '⏳' : r.ok ? '✅' : '❌'} ${r.label}`;
      const dd = document.createElement('dd');
      dd.textContent = r.detail;
      const item = document.createElement('div');
      item.className = 'status-item';
      item.append(dt, dd);
      list.appendChild(item);
    }

    if (eyebrow) eyebrow.textContent = '📋 Resultado del chequeo';
    if (copyText) copyText.value = buildPlainText(results);
  }

  async function runDiagnostics() {
    const results: CheckResult[] = [];

    // El listener tiene que engancharse ANTES de cualquier await, porque
    // beforeinstallprompt puede disparar apenas carga la página — si se
    // engancha después, se pierde el disparo temprano.
    let beforeInstallPromptFired = false;
    window.addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault();
      beforeInstallPromptFired = true;
    });

    results.push({
      label: 'Conexión segura (HTTPS)',
      ok: location.protocol === 'https:' || location.hostname === 'localhost',
      detail: location.protocol,
    });

    const swSupported = 'serviceWorker' in navigator;
    results.push({
      label: 'El navegador soporta Service Worker',
      ok: swSupported,
      detail: navigator.userAgent,
    });
    renderResults(results);

    if (swSupported) {
      try {
        const registration = await navigator.serviceWorker.register('/sw.js');
        results.push({
          label: 'Service Worker registrado',
          ok: true,
          detail: `scope: ${registration.scope}`,
        });
        results.push({
          label: 'Service Worker activo',
          ok: !!registration.active,
          detail: registration.active ? registration.active.scriptURL : 'todavía no hay uno activo',
        });
      } catch (err) {
        results.push({
          label: 'Service Worker registrado',
          ok: false,
          detail: err instanceof Error ? err.message : String(err),
        });
      }
    }
    renderResults(results);

    try {
      const res = await fetch('/manifest.webmanifest');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const manifest = await res.json();
      results.push({
        label: 'Manifest accesible y válido',
        ok: true,
        detail: `nombre: "${manifest.name}", ${Array.isArray(manifest.icons) ? manifest.icons.length : 0} ícono(s)`,
      });
    } catch (err) {
      results.push({
        label: 'Manifest accesible y válido',
        ok: false,
        detail: err instanceof Error ? err.message : String(err),
      });
    }
    renderResults(results);

    const standalone =
      window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
    results.push({
      label: '¿Ya está instalada como app?',
      ok: standalone,
      detail: standalone ? 'sí, esto se está viendo en modo app instalada' : 'no, es una pestaña normal',
    });
    renderResults(results);

    results.push({ label: 'Esperando el aviso de instalación del navegador…', ok: null, detail: 'hasta 4 segundos' });
    renderResults(results);
    await new Promise((resolve) => setTimeout(resolve, 4000));
    results.pop();

    results.push({
      label: 'El navegador ofreció instalar automáticamente',
      ok: beforeInstallPromptFired,
      detail: beforeInstallPromptFired
        ? 'sí disparó'
        : 'no disparó en 4 segundos (normal en Safari/iOS, y puede pasar en algunos Android)',
    });
    renderResults(results);
  }

  function initCopyButton() {
    const btn = document.querySelector<HTMLButtonElement>('[data-copy-btn]');
    const textarea = document.querySelector<HTMLTextAreaElement>('[data-copy-text]');
    const hint = document.querySelector<HTMLElement>('[data-copy-hint]');
    if (!btn || !textarea || btn.dataset.initialized) return;
    btn.dataset.initialized = 'true';

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(textarea.value);
      } catch {
        textarea.focus();
        textarea.select();
        try {
          document.execCommand('copy');
        } catch {
          /* el usuario puede copiar a mano desde el textarea seleccionado */
        }
      }
      if (hint) {
        hint.hidden = false;
        window.setTimeout(() => {
          hint.hidden = true;
        }, 2000);
      }
    });
  }

  function init() {
    initCopyButton();
    runDiagnostics();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .debug-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .debug-body {
    max-width: 680px;
    padding-block: 0 4rem;
    display: grid;
    gap: 1.5rem;
  }

  .status-card,
  .copy-card {
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 0.9rem;
  }

  .status-list {
    display: block;
    margin: 0;
  }

  .status-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .status-item:last-child {
    border-bottom: none;
  }

  .status-item dt {
    font-weight: 700;
  }

  .status-item dd {
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    word-break: break-word;
  }

  .copy-card textarea {
    width: 100%;
    resize: vertical;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .copy-hint {
    display: inline-block;
    margin: 0.6rem 0 0;
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.85rem;
  }
</style>
