---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
---

<BaseLayout
  title="Diario de escritura"
  description="Escribe unas líneas cada día en alemán, inglés, francés, italiano o portugués para practicar escritura libre, sin respuestas fijas."
  path="/diario"
  noindex
>
  <section class="container picker">
    <h1>¿En qué idioma quieres escribir hoy?</h1>
    <p class="desc">Elige un idioma para escribir tu entrada de hoy.</p>
    <div class="lang-grid">
      {
        LANGUAGES.map((language) => (
          <a class="lang-item card" href={`/idiomas/${language.id}/diario`}>
            <span class="flag" aria-hidden="true">
              {language.flag}
            </span>
            <span>{language.name}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
