---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
import { MATRIX_DATA } from '../data/matrices';

const availableLanguages = LANGUAGES.filter((language) => MATRIX_DATA[language.id]);
---

<BaseLayout
  title="Generador de frases"
  description="Genera cientos de frases combinando sujetos, verbos y objetos con el método Janulus. Practica hasta que te salgan automáticamente."
  path="/generador-frases"
  noindex
>
  <section class="container picker">
    <h1>Genera frases en el idioma que quieras</h1>
    <p class="desc">
      Elige un idioma para practicar combinaciones de frases con el método Janulus.
    </p>
    <div class="lang-grid">
      {
        availableLanguages.map((language) => (
          <a class="lang-item card" href={`/idiomas/${language.id}/generador-frases`}>
            <span class="flag" aria-hidden="true">
              {language.flag}
            </span>
            <span>{language.name}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
