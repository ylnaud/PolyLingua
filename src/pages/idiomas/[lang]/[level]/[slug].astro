---
import LessonLayout from '../../../../layouts/LessonLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => {
    const [lang, level, slug] = lesson.id.split('/');
    const siblings = lessons
      .filter((l) => l.data.language === lang && l.data.level === level)
      .sort((a, b) => a.data.order - b.data.order);
    const idx = siblings.findIndex((s) => s.id === lesson.id);
    const prev = idx > 0 ? siblings[idx - 1] : null;
    const next = idx < siblings.length - 1 ? siblings[idx + 1] : null;
    return {
      params: { lang, level, slug },
      props: {
        lesson,
        prevLesson: prev ? { title: prev.data.title, href: `/idiomas/${lang}/${level}/${prev.id.split('/').pop()}` } : null,
        nextLesson: next ? { title: next.data.title, href: `/idiomas/${lang}/${level}/${next.id.split('/').pop()}` } : null,
      },
    };
  });
}

const { lesson, prevLesson, nextLesson } = Astro.props;
const { Content } = await render(lesson);
const { lang, level, slug } = Astro.params;
---

<LessonLayout
  language={lesson.data.language}
  level={lesson.data.level}
  title={lesson.data.title}
  description={lesson.data.description}
  grammarTopic={lesson.data.grammarTopic}
  funFact={lesson.data.funFact}
  minutes={lesson.data.minutes}
  quiz={lesson.data.quiz}
  exercises={lesson.data.exercises}
  vocabulary={lesson.data.vocabulary}
  phrases={lesson.data.phrases}
  situation={lesson.data.situation}
  lessonId={lesson.id}
  path={`/idiomas/${lang}/${level}/${slug}`}
  prevLesson={prevLesson}
  nextLesson={nextLesson}
  ogImage={`/og-${lang}.png`}
>
  <Content />
</LessonLayout>
