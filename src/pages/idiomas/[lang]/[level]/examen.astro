---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Practice from '../../../../components/Practice.astro';
import { LEVELS, LEVEL_MAP } from '../../../../data/levels';
import { LANGUAGE_MAP } from '../../../../data/languages';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');
  const combos = new Set<string>();
  for (const lesson of allLessons) {
    combos.add(`${lesson.data.language}/${lesson.data.level}`);
  }
  return Array.from(combos).map((combo) => {
    const [lang, level] = combo.split('/');
    return { params: { lang, level } };
  });
}

const { lang, level } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];
const levelMeta = LEVEL_MAP[level as keyof typeof LEVEL_MAP];

const allLessons = await getCollection('lessons');
const lessons = allLessons
  .filter((l) => l.data.language === lang && l.data.level === level)
  .sort((a, b) => a.data.order - b.data.order);

const PER_LESSON = 3;

interface PoolItem {
  kind: string;
  data: unknown;
  itemId: string;
}

const perLessonPools: PoolItem[][] = lessons.map((l) => {
  const full: { kind: string; data: unknown }[] = [
    ...l.data.quiz.map((d) => ({ kind: 'choice', data: d })),
    ...l.data.exercises.map((d) => ({ kind: d.type, data: d })),
  ];
  return full.slice(0, PER_LESSON).map((it, idx) => ({
    ...it,
    itemId: `${l.id}#${it.kind}-${idx}`,
  }));
});

const examItems = perLessonPools.flat();
const examChoice = examItems.filter((i) => i.kind === 'choice');
const examOther = examItems.filter((i) => i.kind !== 'choice');
const examQuiz = examChoice.map((i) => i.data) as any[];
const examExercises = examOther.map((i) => ({ type: i.kind, ...(i.data as object) })) as any[];
const examItemIds = [...examChoice.map((i) => i.itemId), ...examOther.map((i) => i.itemId)];
const estimatedMinutes = Math.max(5, Math.round(examItems.length * 0.5));

const levelIndex = LEVELS.findIndex((l) => l.id === level);
const nextLevel = levelIndex >= 0 ? LEVELS[levelIndex + 1] : undefined;
---

<BaseLayout
  title={`Examen de ${languageMeta?.name} — ${levelMeta?.name}`}
  description={`Examen final de ${levelMeta?.name} de ${languageMeta?.name}: combina todo lo aprendido en el nivel. Apruébalo con 70% o más para desbloquear el siguiente nivel.`}
  path={`/idiomas/${lang}/${level}/examen`}
  noindex
>
  <section class="container exam-head">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/idiomas">Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/idiomas/${lang}`}>{languageMeta?.flag} {languageMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <a href={`/idiomas/${lang}/${level}`}>{levelMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <span>Examen</span>
    </nav>
    <span class="emoji" aria-hidden="true">🏆</span>
    <h1>Examen de nivel — {levelMeta?.name}</h1>
    <p class="desc">
      Este examen combina preguntas y ejercicios de las {lessons.length} lecciones de{' '}
      {levelMeta?.name}. Necesitas <strong>70% o más</strong> para aprobar
      {nextLevel ? <> y desbloquear <strong>{nextLevel.name}</strong></> : <> y completar el idioma</>}.
    </p>
  </section>

  <section class="container exam-body">
    <Practice
      quiz={examQuiz}
      exercises={examExercises}
      minutes={estimatedMinutes}
      sessionType="exam"
      lessonId={`${lang}/${level}`}
      itemIds={examItemIds}
    />

    <div class="exam-result" data-exam-result hidden>
      <div class="card result-card" data-result-pass hidden>
        <p class="result-emoji">🎉</p>
        <h2>¡Aprobado!</h2>
        {nextLevel ? (
          <p>Desbloqueaste <strong>{nextLevel.name}</strong>.</p>
        ) : (
          <p>Completaste todo el curso de {languageMeta?.name}. ¡Felicidades!</p>
        )}
        <div class="result-actions">
          {nextLevel && (
            <a class="btn btn-primary" href={`/idiomas/${lang}/${nextLevel.id}`}>
              Ir a {nextLevel.name} →
            </a>
          )}
          <a class="btn btn-ghost" href="/logros">Ver mis logros</a>
        </div>
      </div>
      <div class="card result-card" data-result-fail hidden>
        <p class="result-emoji">💪</p>
        <h2>Todavía no</h2>
        <p>Necesitas al menos 70% para aprobar. Tus fallos ya quedaron guardados para repasar.</p>
        <div class="result-actions">
          <a class="btn btn-primary" href={`/idiomas/${lang}/${level}/examen`}>Reintentar</a>
          <a class="btn btn-ghost" href={`/idiomas/${lang}/repasar`}>Repasar ahora</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const EXAM_PASS_THRESHOLD = 0.7;

  document.addEventListener('practice-complete', ((e: CustomEvent) => {
    const { score = 0, total = 0, sessionType } = e.detail ?? {};
    if (sessionType !== 'exam' || total === 0) return;
    const resultBox = document.querySelector<HTMLElement>('[data-exam-result]');
    const passCard = document.querySelector<HTMLElement>('[data-result-pass]');
    const failCard = document.querySelector<HTMLElement>('[data-result-fail]');
    if (!resultBox) return;
    resultBox.hidden = false;
    const passed = score / total >= EXAM_PASS_THRESHOLD;
    if (passCard) passCard.hidden = !passed;
    if (failCard) failCard.hidden = passed;
  }) as EventListener);
</script>

<style>
  .exam-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .breadcrumbs a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .breadcrumbs a:hover {
    color: var(--accent-text);
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .exam-body {
    max-width: 680px;
    padding-block: 0 4rem;
  }

  .result-card {
    text-align: center;
    padding: 2rem 1.5rem;
    margin-top: 1.5rem;
  }

  .result-emoji {
    font-size: 2.5rem;
    margin: 0;
  }

  .result-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
</style>
