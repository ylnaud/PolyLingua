---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { LEVEL_MAP } from '../../../../data/levels';
import { LANGUAGE_MAP } from '../../../../data/languages';
import { getCollection } from 'astro:content';
import { UNITS } from '../../../../data/units';

export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');
  const combos = new Set<string>();
  for (const lesson of allLessons) {
    combos.add(`${lesson.data.language}/${lesson.data.level}`);
  }
  return Array.from(combos).map((combo) => {
    const [lang, level] = combo.split('/');
    return { params: { lang, level } };
  });
}

const { lang, level } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];
const levelMeta = LEVEL_MAP[level as keyof typeof LEVEL_MAP];

const allLessons = await getCollection('lessons');
const lessons = allLessons
  .filter((l) => l.data.language === lang && l.data.level === level)
  .sort((a, b) => a.data.order - b.data.order);

const unitMetas = UNITS[`${lang}-${level}`] ?? null;

const siteURL = 'https://poly-lingua.vercel.app';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Course',
      name: `${languageMeta.name} ${levelMeta.name} — PolyLingua`,
      description: levelMeta.description,
      url: `${siteURL}/idiomas/${lang}/${level}`,
      inLanguage: lang,
      provider: { '@type': 'Organization', name: 'PolyLingua', url: siteURL },
      hasCourseInstance: lessons.map((l) => ({
        '@type': 'CourseInstance',
        name: l.data.title,
        url: `${siteURL}/idiomas/${lang}/${level}/${l.id.split('/').pop()}`,
        courseMode: 'online',
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Idiomas', item: `${siteURL}/idiomas` },
        { '@type': 'ListItem', position: 2, name: languageMeta.name, item: `${siteURL}/idiomas/${lang}` },
        { '@type': 'ListItem', position: 3, name: levelMeta.name, item: `${siteURL}/idiomas/${lang}/${level}` },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${languageMeta.name} ${levelMeta.name}`}
  description={`${levelMeta.description} Gramática de ${languageMeta.name}, gratis y gamificada.`}
  path={`/idiomas/${lang}/${level}`}
  structuredData={structuredData}
  ogImage={`/og-${lang}.png`}
>
  <section class="container level-head" style={`--accent-c:${levelMeta.color}`}>
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/idiomas">Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/idiomas/${lang}`}>{languageMeta.flag} {languageMeta.name}</a>
      <span aria-hidden="true">/</span>
      <span>{levelMeta.name}</span>
    </nav>
    <span class="emoji" aria-hidden="true">{levelMeta.emoji}</span>
    <h1>{languageMeta.name} — {levelMeta.name}</h1>
    <p class="tagline">{levelMeta.tagline}</p>
    <p class="desc">{levelMeta.description}</p>
  </section>

  <section class="container lessons">
    {lessons.length === 0 && (
      <p class="empty">Estamos preparando lecciones para este nivel. ¡Vuelve pronto!</p>
    )}

    {unitMetas ? (
      unitMetas.map((unit) => {
        const unitLessons = lessons.filter((l) => l.data.unit === unit.id);
        return unitLessons.length > 0 && (
          <div class="unit-group">
            <div class="unit-header">
              <span class="unit-emoji" aria-hidden="true">{unit.emoji}</span>
              <div>
                <h2 class="unit-name">Unidad {unit.id} — {unit.name}</h2>
                <p class="unit-desc">{unit.description}</p>
                <span class="unit-progress" data-unit-progress data-unit-slugs={unitLessons.map((l) => l.id.split('/').pop()).join(',')}></span>
              </div>
            </div>
            <ol class="lesson-list">
              {unitLessons.map((lesson) => {
                const gi = lessons.indexOf(lesson);
                return (
                  <li>
                    <a
                      class="lesson-item card"
                      data-lesson-item
                      data-slug={lesson.id.split('/').pop()}
                      href={`/idiomas/${lang}/${level}/${lesson.id.split('/').pop()}`}
                    >
                      <span class="lesson-num" data-lesson-num style={`background:${levelMeta.color}`}>{gi + 1}</span>
                      <div>
                        <h2>{lesson.data.title}</h2>
                        <p>{lesson.data.description}</p>
                        <span class="lesson-meta">📘 {lesson.data.grammarTopic} · ⏱️ {lesson.data.minutes} min</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ol>
          </div>
        );
      })
    ) : (
      <ol class="lesson-list">
        {lessons.map((lesson, i) => (
          <li>
            <a
              class="lesson-item card"
              data-lesson-item
              data-slug={lesson.id.split('/').pop()}
              href={`/idiomas/${lang}/${level}/${lesson.id.split('/').pop()}`}
            >
              <span class="lesson-num" data-lesson-num style={`background:${levelMeta.color}`}>{i + 1}</span>
              <div>
                <h2>{lesson.data.title}</h2>
                <p>{lesson.data.description}</p>
                <span class="lesson-meta">📘 {lesson.data.grammarTopic} · ⏱️ {lesson.data.minutes} min</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    )}

    {lessons.length > 0 && (
      <ol class="lesson-list exam-list">
        <li>
          <a
            class="lesson-item card exam-item"
            data-exam-item
            href={`/idiomas/${lang}/${level}/examen`}
          >
            <span class="lesson-num" data-lesson-num style={`background:${levelMeta.color}`}>🏆</span>
            <div>
              <h2>Examen de nivel</h2>
              <p>Combina todo lo que aprendiste en {levelMeta.name} — apruébalo para desbloquear el siguiente nivel.</p>
            </div>
          </a>
        </li>
      </ol>
    )}
  </section>
</BaseLayout>

<script define:vars={{ lang, level, slugs: lessons.map((l) => l.id.split('/').pop()) }}>
  function read(key) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function isLessonDone(slug) {
    return !!read(`polylingua-lesson-done-${lang}-${level}-${slug}`);
  }

  function lockItem(el) {
    el.classList.add('locked');
    el.setAttribute('aria-disabled', 'true');
    el.setAttribute('data-astro-prefetch', 'false');
    const num = el.querySelector('[data-lesson-num]');
    if (num) num.textContent = '🔒';
    el.addEventListener('click', (e) => e.preventDefault());
  }

  // Sin envolver en initX()+astro:page-load, esto solo corría una vez por
  // carga completa — bajo navegación SPA (Astro <ClientRouter />) revisitar
  // esta página no recalcularía qué lecciones/examen siguen bloqueados. Cada
  // navegación trae nodos DOM frescos (sin la clase locked, que solo la
  // agrega este script), así que reejecutarlo es seguro y no necesita guard.
  function initLevelIndex() {
    document.querySelectorAll('[data-lesson-item]').forEach((el, i) => {
      if (isLessonDone(slugs[i])) el.classList.add('done');
      if (i === 0) return;
      if (!isLessonDone(slugs[i - 1])) lockItem(el);
    });

    document.querySelectorAll('[data-unit-progress]').forEach((el) => {
      var uSlugs = (el.dataset.unitSlugs || '').split(',').filter(Boolean);
      var done = uSlugs.filter(isLessonDone).length;
      el.textContent = done + '/' + uSlugs.length;
      if (done === uSlugs.length && uSlugs.length > 0) el.classList.add('complete');
    });

    const examItem = document.querySelector('[data-exam-item]');
    const lastSlug = slugs[slugs.length - 1];
    if (examItem && (!lastSlug || !isLessonDone(lastSlug))) lockItem(examItem);
    if (examItem && lastSlug && isLessonDone(lastSlug) && read('polylingua-level-passed-' + lang + '-' + level)) {
      examItem.classList.add('done');
    }
  }

  initLevelIndex();
  document.addEventListener('astro:page-load', initLevelIndex);
</script>

<style>
  .level-head {
    padding-block: 2.5rem 2rem;
    max-width: 640px;
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.4rem;
  }

  .tagline {
    color: var(--accent-c);
    font-weight: 700;
    margin: 0 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .lessons {
    padding-block: 1rem 4rem;
  }

  .lesson-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .lesson-item {
    display: flex;
    gap: 1.1rem;
    padding: 1.25rem 1.4rem;
    text-decoration: none;
    color: var(--text);
    align-items: flex-start;
    transition: transform 0.15s ease;
  }

  .lesson-item:hover {
    transform: translateX(4px);
  }

  .lesson-num {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 800;
    color: #14161c;
    font-size: 0.9rem;
  }

  .lesson-item h2 {
    margin: 0 0 0.3rem;
    font-size: 1.1rem;
  }

  .lesson-item p {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.93rem;
  }

  .lesson-meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .empty {
    color: var(--text-muted);
  }

  .exam-item {
    border-color: var(--accent);
  }

  .unit-group {
    margin-bottom: 2rem;
  }

  .unit-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: var(--surface, #f3f4f6);
  }

  :root[data-theme='dark'] .unit-header,
  :root:not([data-theme='light']) .unit-header {
    background: var(--surface, #1e1e2e);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .unit-header {
      background: var(--surface, #1e1e2e);
    }
  }

  .unit-emoji {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .unit-name {
    margin: 0;
    font-size: 1.05rem;
  }

  .unit-desc {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .unit-progress {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .unit-progress.complete {
    color: #22c55e;
  }

  .exam-list {
    margin-top: 1rem;
  }

  .lesson-item.done .lesson-num {
    background: #22c55e !important;
    color: #fff;
  }

  .locked {
    opacity: 0.5;
    cursor: default;
  }

  .locked:hover {
    transform: none;
  }
</style>
