---
import { LANGUAGES } from '../../../data/languages';
import { ACTIVE_USER_LANGUAGES } from '../../../data/userLanguages';
import { getTargetLangsFor } from '../../../lib/courses';

// Ruta legacy anterior a que las herramientas entraran al silo: la
// herramienta vivía en /idiomas/<idioma>/ahorcado, sin eje de idioma de
// interfaz. Ahora vive en /<userLang>/<idioma>/ahorcado, así que esto es una
// redirección 301 al silo del idioma de interfaz principal — mismo patrón que
// src/pages/niveles/, las otras rutas legacy del sitio.
// Solo los idiomas meta que el silo destino tiene de verdad: /idiomas/es/… no
// puede redirigir a /es/es/…, que no existe (nadie estudia su propio idioma).
export async function getStaticPaths() {
  const targets = getTargetLangsFor(ACTIVE_USER_LANGUAGES[0].id);
  return LANGUAGES.filter((language) => targets.includes(language.id)).map((language) => ({
    params: { lang: language.id },
  }));
}

const { lang } = Astro.params;
return Astro.redirect(`/${ACTIVE_USER_LANGUAGES[0].id}/${lang}/ahorcado`, 301);
---
