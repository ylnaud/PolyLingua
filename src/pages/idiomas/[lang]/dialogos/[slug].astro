---
import { getCollection } from 'astro:content';
import { ACTIVE_USER_LANGUAGES } from '../../../../data/userLanguages';

// Ruta legacy: /idiomas/<idioma>/dialogos/<slug> → /<userLang>/<idioma>/dialogos/<slug>.
export async function getStaticPaths() {
  return (await getCollection('dialogos')).map((entry) => {
    const parts = entry.id.split('/');
    return { params: { lang: parts[0], slug: parts[parts.length - 1] } };
  });
}

const { lang, slug } = Astro.params;
return Astro.redirect(`/${ACTIVE_USER_LANGUAGES[0].id}/${lang}/dialogos/${slug}`, 301);
---
