---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGUAGES, LANGUAGE_MAP } from '../../../data/languages';
import { MATRIX_DATA, type PhraseMatrix, type PhraseAssembler } from '../../../data/matrices';

export async function getStaticPaths() {
  return LANGUAGES.map((language) => ({ params: { lang: language.id } }));
}

interface DeckPhrase {
  text: string;
  es: string;
  comboKey: string;
}

interface Deck {
  id: string;
  title: string;
  glossEs: string;
  phrases: DeckPhrase[];
}

function buildDecks(matrix: PhraseMatrix, assemble: PhraseAssembler): Deck[] {
  const lengths = matrix.columns.map((col) => col.items.length);
  const total = lengths.reduce((a, b) => a * b, 1);
  const deckMap = new Map<string, Deck>();

  for (let i = 0; i < total; i++) {
    const colIndices: number[] = [];
    let remaining = i;
    for (let j = lengths.length - 1; j >= 0; j--) {
      colIndices.unshift(remaining % lengths[j]);
      remaining = Math.floor(remaining / lengths[j]);
    }

    const subjectIdx = colIndices[0];
    const modalIdx = colIndices[1];
    const words: string[] = [];
    const esWords: string[] = [];
    matrix.columns.forEach((col, colIdx) => {
      const item = col.items[colIndices[colIdx]];
      words.push(item.forms?.[subjectIdx] ?? item.word);
      esWords.push(item.es);
    });

    const deckId = `${subjectIdx}-${modalIdx}`;
    if (!deckMap.has(deckId)) {
      const subjItem = matrix.columns[0].items[subjectIdx];
      const modalItem = matrix.columns[1].items[modalIdx];
      const modalWord = modalItem.forms?.[subjectIdx] ?? modalItem.word;
      deckMap.set(deckId, {
        id: deckId,
        title: assemble([subjItem.word, modalWord]),
        glossEs: `${subjItem.es} ${modalItem.es}`,
        phrases: [],
      });
    }
    deckMap.get(deckId)!.phrases.push({
      text: assemble(words),
      es: esWords.join(' · '),
      comboKey: colIndices.join('-'),
    });
  }

  return [...deckMap.values()];
}

const { lang } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];
const matrixConfig = MATRIX_DATA[lang as keyof typeof MATRIX_DATA];
const matrix = matrixConfig.matrices[0];
const totalCombinations = matrix.columns.reduce((acc, col) => acc * col.items.length, 1);
const decks = buildDecks(matrix, matrixConfig.assemble);
---

<BaseLayout
  title={`Generador de frases en ${languageMeta?.name}`}
  description={`Genera cientos de frases en ${languageMeta?.name?.toLowerCase()} combinando sujetos, verbos y objetos. Método Janulus para crear memoria automática.`}
  path={`/idiomas/${lang}/generador-frases`}
  noindex
>
  <section class="container gen-head">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/idiomas">Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/idiomas/${lang}`}>{languageMeta?.flag} {languageMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <span>Generador de frases</span>
    </nav>
    <span class="emoji" aria-hidden="true">🧩</span>
    <h1>Generador de frases en {languageMeta?.name}</h1>
    <p class="desc">Elegí una tanda chica y estudiala de a una frase, a tu ritmo.</p>
  </section>

  <section class="container gen-body" data-gen-root data-lang-id={lang} data-bcp47={languageMeta?.bcp47} data-matrix-id={matrix.id} data-total={totalCombinations}>
    <div data-deck-picker>
      <p class="gen-overall-progress" data-gen-overall-progress></p>
      <div class="deck-grid">
        {
          decks.map((deck) => (
            <button type="button" class="card deck-card" data-deck-id={deck.id}>
              <span class="deck-title">{deck.title}</span>
              <span class="deck-gloss">{deck.glossEs}</span>
              <span class="deck-count">{deck.phrases.length} frases</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="card flash-panel" data-flash-panel hidden>
      <button type="button" class="btn btn-ghost flash-back" data-flash-back>
        <span aria-hidden="true">←</span> Elegir otra tanda
      </button>

      <p class="flash-deck-title" data-flash-deck-title></p>

      <div class="flash-card">
        <p class="flash-text" data-flash-text aria-live="polite"></p>
        <p class="flash-es" data-flash-es></p>
        <button type="button" class="flash-speak" data-flash-speak aria-label="Escuchar">
          🔊
        </button>
      </div>

      <div class="flash-nav">
        <button type="button" class="btn btn-ghost" data-flash-prev>
          <span aria-hidden="true">←</span> Anterior
        </button>
        <span class="flash-progress" data-flash-progress></span>
        <button type="button" class="btn btn-primary" data-flash-next>
          Siguiente <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <script type="application/json" data-decks-json set:html={JSON.stringify(decks)} />
  </section>
</BaseLayout>

<style>
  .gen-head {
    text-align: center;
    padding-top: 2rem;
  }

  .gen-head .emoji {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .gen-head h1 {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
  }

  .gen-head .desc {
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto;
  }

  .gen-body {
    padding-bottom: calc(2rem + var(--bottom-nav-h));
  }

  .gen-overall-progress {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  .deck-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
  }

  .deck-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 1rem 0.75rem;
    cursor: pointer;
    text-align: center;
    border: 1.5px solid var(--border);
    background: var(--bg-elevated, var(--bg));
    color: var(--text);
  }

  .deck-card:hover {
    border-color: var(--accent);
  }

  .deck-title {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .deck-gloss {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .deck-count {
    color: var(--accent-text, var(--accent));
    font-size: 0.75rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .flash-panel {
    padding: 1.5rem;
    text-align: center;
  }

  .flash-back {
    align-self: flex-start;
    margin-bottom: 1rem;
  }

  .flash-deck-title {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  .flash-card {
    padding: 2rem 1.25rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1.5px solid var(--border);
    margin-bottom: 1.25rem;
    min-height: 8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .flash-text {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0;
    line-height: 1.3;
  }

  .flash-es {
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
  }

  .flash-speak {
    margin-top: 0.5rem;
    min-width: 48px;
    min-height: 48px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated, var(--bg));
    color: var(--text);
    font-size: 1.2rem;
    cursor: pointer;
  }

  .flash-speak:hover {
    border-color: var(--accent);
  }

  .flash-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .flash-progress {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .flash-text {
      font-size: 1.25rem;
    }

    .flash-nav {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>

<script>
  import { read, write } from '../../../lib/storage';
  import { speak } from '../../../lib/sound';

  interface DeckPhrase {
    text: string;
    es: string;
    comboKey: string;
  }

  interface Deck {
    id: string;
    title: string;
    glossEs: string;
    phrases: DeckPhrase[];
  }

  function initGeneradorFrases(): void {
    const root = document.querySelector<HTMLElement>('[data-gen-root]');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const langId = root.dataset.langId ?? '';
    const bcp47 = root.dataset.bcp47 ?? '';
    const matrixId = root.dataset.matrixId ?? '';
    const total = parseInt(root.dataset.total ?? '0', 10);

    const decksJsonEl = root.querySelector<HTMLScriptElement>('[data-decks-json]')!;
    const decks: Deck[] = JSON.parse(decksJsonEl.textContent ?? '[]');

    const deckPicker = root.querySelector<HTMLElement>('[data-deck-picker]')!;
    const overallProgress = root.querySelector<HTMLElement>('[data-gen-overall-progress]')!;
    const flashPanel = root.querySelector<HTMLElement>('[data-flash-panel]')!;
    const flashBack = root.querySelector<HTMLButtonElement>('[data-flash-back]')!;
    const flashDeckTitle = root.querySelector<HTMLElement>('[data-flash-deck-title]')!;
    const flashText = root.querySelector<HTMLElement>('[data-flash-text]')!;
    const flashEs = root.querySelector<HTMLElement>('[data-flash-es]')!;
    const flashSpeak = root.querySelector<HTMLButtonElement>('[data-flash-speak]')!;
    const flashPrev = root.querySelector<HTMLButtonElement>('[data-flash-prev]')!;
    const flashNext = root.querySelector<HTMLButtonElement>('[data-flash-next]')!;
    const flashProgress = root.querySelector<HTMLElement>('[data-flash-progress]')!;

    let practiced = loadProgress(langId, matrixId);
    let currentDeck: Deck | null = null;
    let currentIndex = 0;

    updateOverallProgress();

    root.querySelectorAll<HTMLButtonElement>('[data-deck-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const deck = decks.find((d) => d.id === btn.dataset.deckId);
        if (!deck) return;
        openDeck(deck);
      });
    });

    flashBack.addEventListener('click', () => {
      flashPanel.hidden = true;
      deckPicker.hidden = false;
      updateOverallProgress();
    });

    flashPrev.addEventListener('click', () => {
      if (!currentDeck) return;
      currentIndex = (currentIndex - 1 + currentDeck.phrases.length) % currentDeck.phrases.length;
      showCard();
    });

    flashNext.addEventListener('click', () => {
      if (!currentDeck) return;
      currentIndex = (currentIndex + 1) % currentDeck.phrases.length;
      showCard();
    });

    flashSpeak.addEventListener('click', () => {
      const text = flashText.textContent ?? '';
      if (text) speak(text, bcp47);
    });

    function openDeck(deck: Deck): void {
      currentDeck = deck;
      currentIndex = 0;
      deckPicker.hidden = true;
      flashPanel.hidden = false;
      flashDeckTitle.textContent = `${deck.title} · ${deck.glossEs}`;
      showCard();
    }

    function showCard(): void {
      if (!currentDeck) return;
      const phrase = currentDeck.phrases[currentIndex];
      flashText.textContent = phrase.text;
      flashEs.textContent = phrase.es;
      flashProgress.textContent = `${currentIndex + 1} / ${currentDeck.phrases.length}`;

      if (!practiced.has(phrase.comboKey)) {
        practiced.add(phrase.comboKey);
        saveProgress(langId, matrixId, practiced);
      }
    }

    function updateOverallProgress(): void {
      const count = practiced.size;
      const pct = total > 0 ? Math.round((count / total) * 100) : 0;
      overallProgress.textContent = `${count} / ${total} frases vistas (${pct}%)`;
    }
  }

  function loadProgress(lang: string, matrixId: string): Set<string> {
    const raw = read(`polylingua-gen-${lang}-${matrixId}`);
    if (!raw) return new Set();
    try {
      const arr = JSON.parse(raw);
      return Array.isArray(arr) ? new Set<string>(arr) : new Set<string>();
    } catch {
      return new Set();
    }
  }

  function saveProgress(lang: string, matrixId: string, practiced: Set<string>): void {
    write(`polylingua-gen-${lang}-${matrixId}`, JSON.stringify([...practiced]));
  }

  initGeneradorFrases();
  document.addEventListener('astro:page-load', initGeneradorFrases);
</script>
