---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGUAGES, LANGUAGE_MAP } from '../../../data/languages';
import { ACTIVE_USER_LANGUAGES } from '../../../data/userLanguages';

export async function getStaticPaths() {
  return LANGUAGES.map((language) => ({ params: { lang: language.id } }));
}

const { lang } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];
const userLang = ACTIVE_USER_LANGUAGES[0].id;

const lessonsForLang = await getCollection('lessons', (entry) => entry.data.language === lang);

interface TopicInfo {
  topic: string;
  lessonIds: string[];
  exerciseCount: number;
}

const topicMap = new Map<string, TopicInfo>();
for (const lesson of lessonsForLang) {
  const topic = lesson.data.grammarTopic;
  if (!topic) continue;
  const existing = topicMap.get(topic);
  const exerciseCount = lesson.data.quiz.length + lesson.data.exercises.length;
  if (existing) {
    existing.lessonIds.push(lesson.id);
    existing.exerciseCount += exerciseCount;
  } else {
    topicMap.set(topic, { topic, lessonIds: [lesson.id], exerciseCount });
  }
}

const topics = [...topicMap.values()].sort((a, b) => a.topic.localeCompare(b.topic, 'es'));
const topicManifest = Object.fromEntries(topics.map((t) => [t.topic, t.lessonIds]));
---

<BaseLayout
  title={`Gramática — ${languageMeta?.name}`}
  description={`Repasa los temas gramaticales de ${languageMeta?.name}: mira tu nivel de dominio y practica los que más necesites.`}
  path={`/idiomas/${lang}/gramatica`}
  noindex
>
  <section class="container grammar-head">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href={`/${userLang}`}>Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/${userLang}/${lang}`}>{languageMeta?.flag} {languageMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <span>Gramática</span>
    </nav>
    <span class="emoji" aria-hidden="true">📖</span>
    <h1>Gramática de {languageMeta?.name}</h1>
    <p class="desc">Tu dominio por tema gramatical.</p>
  </section>

  <section class="container grammar-grid" data-grammar-grid>
    {
      topics.map((t) => (
        <div class="grammar-card card" data-grammar-card data-topic={t.topic}>
          <h2 class="grammar-topic">{t.topic}</h2>
          <div class="grammar-meta">
            <span class="grammar-exercises">
              {t.exerciseCount} ejercicio{t.exerciseCount === 1 ? '' : 's'}
            </span>
            <span class="grammar-mastery" data-mastery>
              Sin datos
            </span>
          </div>
          <div class="grammar-bar-wrap">
            <div class="grammar-bar">
              <div class="grammar-bar-fill" data-mastery-fill />
            </div>
          </div>
          <a
            class="btn btn-ghost grammar-cta"
            href={`/idiomas/${lang}/repasar?tema=${encodeURIComponent(t.topic)}`}
          >
            Practicar
          </a>
        </div>
      ))
    }
  </section>

  <div hidden data-topic-manifest={JSON.stringify(topicManifest)}></div>
</BaseLayout>

<script>
  import { read } from '../../../lib/storage';
  import { MASTERY_LABELS, MAX_BOX } from '../../../lib/srs';

  interface SrsEntry {
    id: string;
    box: number;
    lang: string;
  }

  function readPool(): Record<string, SrsEntry> {
    try {
      return JSON.parse(read('polylingua-srs-pool') ?? '{}');
    } catch {
      return {};
    }
  }

  function readTopicManifest(): Record<string, string[]> {
    const el = document.querySelector<HTMLElement>('[data-topic-manifest]');
    if (!el) return {};
    try {
      return JSON.parse(el.dataset.topicManifest ?? '{}');
    } catch {
      return {};
    }
  }

  function initGrammar() {
    const grid = document.querySelector<HTMLElement>('[data-grammar-grid]');
    if (!grid) return;
    if (grid.dataset.built) return;
    grid.dataset.built = 'true';

    const lang = window.location.pathname.split('/')[2] ?? '';
    const pool = readPool();
    const topicManifest = readTopicManifest();

    const cards = grid.querySelectorAll<HTMLElement>('[data-grammar-card]');
    cards.forEach((card) => {
      const topic = card.dataset.topic ?? '';
      const lessonIds = topicManifest[topic] ?? [];

      const entries: SrsEntry[] = [];
      for (const entry of Object.values(pool)) {
        if (entry.lang !== lang) continue;
        const lessonId = (entry as any).id?.split('#')[0] ?? '';
        if (lessonIds.includes(lessonId)) entries.push(entry);
      }

      const masteryEl = card.querySelector<HTMLElement>('[data-mastery]');
      const fillEl = card.querySelector<HTMLElement>('[data-mastery-fill]');

      if (entries.length === 0) {
        if (masteryEl) {
          masteryEl.textContent = 'Sin datos';
          masteryEl.classList.add('no-data');
        }
        return;
      }

      const avgBox = Math.round(entries.reduce((s, e) => s + e.box, 0) / entries.length);
      const clampedBox = Math.min(avgBox, MAX_BOX - 1);
      const pct = Math.round((clampedBox / (MAX_BOX - 1)) * 100);

      if (masteryEl) {
        masteryEl.textContent = MASTERY_LABELS[clampedBox] ?? `Caja ${clampedBox}`;
        masteryEl.classList.remove('no-data');
      }
      if (fillEl) fillEl.style.width = `${pct}%`;
    });
  }

  initGrammar();
  document.addEventListener('astro:page-load', initGrammar);
</script>

<style>
  .grammar-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .grammar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    padding-block: 0 4rem;
    max-width: 900px;
  }

  .grammar-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .grammar-topic {
    font-size: 1.05rem;
    margin: 0;
  }

  .grammar-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }

  .grammar-exercises {
    color: var(--text-muted);
    font-weight: 600;
  }

  .grammar-mastery {
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-text);
  }

  .grammar-mastery:global(.no-data) {
    background: var(--bg-elevated);
    color: var(--text-muted);
  }

  .grammar-bar-wrap {
    width: 100%;
  }

  .grammar-bar {
    height: 6px;
    border-radius: 3px;
    background: var(--border, #e5e7eb);
    overflow: hidden;
  }

  .grammar-bar-fill {
    height: 100%;
    border-radius: 3px;
    background: var(--accent);
    transition: width 0.4s ease;
    width: 0%;
  }

  .grammar-cta {
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    align-self: flex-start;
    text-decoration: none;
  }

  @media (max-width: 560px) {
    .grammar-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
