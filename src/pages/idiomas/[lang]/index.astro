---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LEVELS } from '../../../data/levels';
import { LANGUAGES, LANGUAGE_MAP } from '../../../data/languages';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return LANGUAGES.map((language) => ({ params: { lang: language.id } }));
}

const { lang } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];

const allLessons = await getCollection('lessons');
const lessonCounts = Object.fromEntries(
  LEVELS.map((lvl) => [
    lvl.id,
    allLessons.filter((l) => l.data.language === lang && l.data.level === lvl.id).length,
  ])
);

const levelLessonSlugs: Record<string, string[]> = {};
for (const lvl of LEVELS) {
  levelLessonSlugs[lvl.id] = allLessons
    .filter((l) => l.data.language === lang && l.data.level === lvl.id)
    .sort((a, b) => a.data.order - b.data.order)
    .map((l) => l.id.split('/').pop()!);
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${languageMeta.name} — PolyLingua`,
  description: languageMeta.description,
  inLanguage: lang,
};
---

<BaseLayout
  title={`Aprende ${languageMeta.name}`}
  description={languageMeta.description}
  path={`/idiomas/${lang}`}
  structuredData={structuredData}
>
  <section class="container lang-head" style={`--accent-c:${languageMeta.color}`}>
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/idiomas">Idiomas</a>
      <span aria-hidden="true">/</span>
      <span>{languageMeta.name}</span>
    </nav>
    <span class="flag" aria-hidden="true">{languageMeta.flag}</span>
    <h1>{languageMeta.name} <span class="native">· {languageMeta.nativeName}</span></h1>
    <p class="tagline">{languageMeta.tagline}</p>
    <p class="desc">{languageMeta.description}</p>
  </section>

  <section class="container dashboard" hidden data-dashboard>
    <div class="dash-hero card">
      <div class="dash-main">
        <span class="dash-level" data-dash-level></span>
        <div class="dash-progress-wrap">
          <div class="dash-progress-bar">
            <div class="dash-progress-fill" data-dash-fill></div>
          </div>
          <span class="dash-progress-text" data-dash-progress></span>
        </div>
        <a class="btn btn-primary dash-continue" data-dash-continue href="#">Continuar</a>
      </div>
      <div class="dash-stats">
        <div class="dash-stat">
          <span class="dash-stat-num" data-dash-review>0</span>
          <span class="dash-stat-label">Repaso</span>
        </div>
        <a class="dash-stat dash-stat-link" href={`/idiomas/${lang}/mis-errores`}>
          <span class="dash-stat-num" data-dash-errors>0</span>
          <span class="dash-stat-label">Errores</span>
        </a>
        <div class="dash-stat">
          <span class="dash-stat-num" data-dash-streak>0</span>
          <span class="dash-stat-label">Racha</span>
        </div>
      </div>
    </div>
  </section>

  <section class="container levels-grid">
    {LEVELS.map((level) => (
      <a
        class="level-item card"
        data-level-item
        data-level-id={level.id}
        href={`/idiomas/${lang}/${level.id}`}
        style={`border-top-color:${level.color}`}
      >
        <div class="top">
          <span class="emoji" aria-hidden="true">{level.emoji}</span>
          <span class="badge" data-level-badge>{lessonCounts[level.id] ?? 0} lección{(lessonCounts[level.id] ?? 0) === 1 ? '' : 'es'}</span>
        </div>
        <h2>{level.name}</h2>
        <p class="lvl-tagline" style={`color:${level.color}`}>{level.tagline}</p>
        <p class="lvl-desc">{level.description}</p>
      </a>
    ))}
  </section>

  <section class="container explore-more">
    <span class="eyebrow">🧭 Explorá más</span>
    <div class="explore-grid">
      <a class="explore-item card" href={`/idiomas/${lang}/situaciones`}>
        <span aria-hidden="true">🗺️</span>
        <span>Situaciones</span>
      </a>
      <a class="explore-item card" href={`/idiomas/${lang}/pronunciacion`}>
        <span aria-hidden="true">🗣️</span>
        <span>Escuchar y repetir</span>
      </a>
      <a class="explore-item card" href={`/idiomas/${lang}/recursos`}>
        <span aria-hidden="true">📻</span>
        <span>Recursos</span>
      </a>
      <a class="explore-item card" href="/logros">
        <span aria-hidden="true">🎯</span>
        <span>Sprint semanal</span>
      </a>
      <a class="explore-item card" href={`/idiomas/${lang}/diario`}>
        <span aria-hidden="true">✍️</span>
        <span>Diario</span>
      </a>
      <a class="explore-item card" href={`/idiomas/${lang}/mis-errores`}>
        <span aria-hidden="true">🔴</span>
        <span>Mis errores</span>
      </a>
      <a class="explore-item card" href={`/idiomas/${lang}/gramatica`}>
        <span aria-hidden="true">📖</span>
        <span>Gramática</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ lang, levelIds: LEVELS.map((l) => l.id), levelLessonSlugs }}>
  function read(key) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function isLevelPassed(levelId) {
    return read('polylingua-level-passed-' + lang + '-' + levelId) === 'true';
  }

  function isLessonDone(lvl, slug) {
    return !!read('polylingua-lesson-done-' + lang + '-' + lvl + '-' + slug);
  }

  function todayStr() {
    var d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }

  function initLangIndex() {
    document.querySelectorAll('[data-level-item]').forEach(function (el, i) {
      var lvl = levelIds[i];
      var lvlSlugs = levelLessonSlugs[lvl] || [];
      var done = 0;
      for (var s = 0; s < lvlSlugs.length; s++) {
        if (isLessonDone(lvl, lvlSlugs[s])) done++;
      }
      var badge = el.querySelector('[data-level-badge]');
      if (isLevelPassed(lvl) && badge) {
        badge.textContent = '✓ Completado';
        el.classList.add('level-passed');
      } else if (done > 0 && lvlSlugs.length > 0 && badge) {
        var pct = Math.round((done / lvlSlugs.length) * 100);
        badge.textContent = pct + '% · ' + done + '/' + lvlSlugs.length;
      }

      if (i === 0) return;
      var prevLevel = levelIds[i - 1];
      if (!isLevelPassed(prevLevel)) {
        el.classList.add('locked');
        el.setAttribute('aria-disabled', 'true');
        el.setAttribute('data-astro-prefetch', 'false');
        if (badge) badge.textContent = '🔒 Bloqueado';
        el.addEventListener('click', function (e) { e.preventDefault(); });
      }
    });

    initDashboard();
  }

  function initDashboard() {
    var dashboard = document.querySelector('[data-dashboard]');
    if (!dashboard) return;

    var currentLevel = null;
    for (var i = 0; i < levelIds.length; i++) {
      if (!isLevelPassed(levelIds[i])) { currentLevel = levelIds[i]; break; }
    }
    if (!currentLevel) currentLevel = levelIds[levelIds.length - 1];

    var slugs = levelLessonSlugs[currentLevel] || [];
    if (slugs.length === 0) return;

    var doneCount = 0;
    var firstUndone = null;
    for (var j = 0; j < slugs.length; j++) {
      if (isLessonDone(currentLevel, slugs[j])) { doneCount++; }
      else if (!firstUndone) { firstUndone = slugs[j]; }
    }

    var pct = Math.round((doneCount / slugs.length) * 100);

    var levelEl = dashboard.querySelector('[data-dash-level]');
    if (levelEl) levelEl.textContent = currentLevel.toUpperCase() + ' — ' + pct + '% completado';

    var fill = dashboard.querySelector('[data-dash-fill]');
    if (fill) fill.style.width = pct + '%';
    var progressText = dashboard.querySelector('[data-dash-progress]');
    if (progressText) progressText.textContent = doneCount + '/' + slugs.length + ' lecciones';

    var continueBtn = dashboard.querySelector('[data-dash-continue]');
    if (continueBtn && firstUndone) {
      continueBtn.href = '/idiomas/' + lang + '/' + currentLevel + '/' + firstUndone;
    } else if (continueBtn) {
      continueBtn.href = '/idiomas/' + lang + '/' + currentLevel + '/examen';
      continueBtn.textContent = 'Ir al examen →';
    }

    var reviewCount = 0;
    try {
      var pool = JSON.parse(read('polylingua-srs-pool') || '{}');
      var td = todayStr();
      for (var key in pool) {
        if (pool[key].lang === lang && pool[key].due <= td) reviewCount++;
      }
    } catch (e) {}
    var reviewEl = dashboard.querySelector('[data-dash-review]');
    if (reviewEl) reviewEl.textContent = String(reviewCount);

    var errorCount = 0;
    try {
      var log = JSON.parse(read('polylingua-error-log') || '[]');
      for (var e2 = 0; e2 < log.length; e2++) {
        if (log[e2].lang === lang) errorCount++;
      }
    } catch (e) {}
    var errorEl = dashboard.querySelector('[data-dash-errors]');
    if (errorEl) errorEl.textContent = String(errorCount);

    var streak = Number(read('polylingua-streak-count') || '0');
    var streakEl = dashboard.querySelector('[data-dash-streak]');
    if (streakEl) streakEl.textContent = String(streak);

    if (doneCount > 0 || reviewCount > 0 || errorCount > 0 || streak > 0) {
      dashboard.hidden = false;
    }
  }

  initLangIndex();
  document.addEventListener('astro:page-load', initLangIndex);
</script>

<style>
  .lang-head {
    padding-block: 2.5rem 2rem;
    max-width: 680px;
  }

  .flag {
    font-size: 2.2rem;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0.4rem 0 0.4rem;
  }

  .native {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.6em;
  }

  .tagline {
    color: var(--accent-c);
    font-weight: 700;
    margin: 0 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .levels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding-block: 1rem 4rem;
  }

  .level-item {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--text);
    border-top: 3px solid;
    transition: transform 0.15s ease;
  }

  .level-item:hover {
    transform: translateY(-3px);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .emoji {
    font-size: 1.75rem;
  }

  .level-item h2 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .lvl-tagline {
    font-weight: 700;
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  .lvl-desc {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .levels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .levels-grid {
      grid-template-columns: 1fr;
    }
  }

  .dashboard {
    padding-block: 0 1.5rem;
  }

  .dash-hero {
    padding: 1.5rem;
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .dash-main {
    flex: 1;
    min-width: 0;
  }

  .dash-level {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .dash-progress-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .dash-progress-bar {
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: var(--border, #e5e7eb);
    overflow: hidden;
  }

  .dash-progress-fill {
    height: 100%;
    border-radius: 4px;
    background: var(--accent-c, var(--accent));
    transition: width 0.4s ease;
    width: 0%;
  }

  .dash-progress-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .dash-continue {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    padding: 0.6rem 1.5rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }

  .dash-stats {
    display: flex;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .dash-stat {
    text-align: center;
  }

  .dash-stat-link {
    text-decoration: none;
    color: var(--text);
    transition: opacity 0.15s ease;
  }

  .dash-stat-link:hover {
    opacity: 0.7;
  }

  .dash-stat-num {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .dash-stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  @media (max-width: 560px) {
    .dash-hero {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }
    .dash-stats {
      justify-content: space-around;
    }
  }

  .level-passed {
    border-top-color: #22c55e !important;
  }

  .level-passed [data-level-badge] {
    color: #22c55e;
    font-weight: 700;
  }

  .locked {
    opacity: 0.5;
    cursor: default;
  }

  .locked:hover {
    transform: none;
  }

  .explore-more {
    padding-block: 0 4rem;
  }

  .eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 0.9rem;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.85rem;
  }

  .explore-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    transition: transform 0.15s ease;
  }

  .explore-item:hover {
    transform: translateY(-2px);
  }

  .explore-item span:first-child {
    font-size: 1.2rem;
  }

  @media (max-width: 560px) {
    .explore-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
