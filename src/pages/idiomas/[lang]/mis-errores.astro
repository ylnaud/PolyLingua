---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Practice from '../../../components/Practice.astro';
import { LANGUAGES, LANGUAGE_MAP } from '../../../data/languages';

export async function getStaticPaths() {
  return LANGUAGES.map((language) => ({ params: { lang: language.id } }));
}

const { lang } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];

const lessonsForLang = await getCollection('lessons', (entry) => entry.data.language === lang);
const exerciseManifest = Object.fromEntries(
  lessonsForLang.map((l) => [
    l.id,
    [
      ...l.data.quiz.map((data) => ({ kind: 'choice', data })),
      ...l.data.exercises.map((data) => ({ kind: data.type, data })),
    ],
  ]),
);
const topicManifest = Object.fromEntries(lessonsForLang.map((l) => [l.id, l.data.grammarTopic]));
---

<BaseLayout
  title={`Mis errores — ${languageMeta?.name}`}
  description={`Revisa y practica los ejercicios de ${languageMeta?.name} que más te cuestan.`}
  path={`/idiomas/${lang}/mis-errores`}
  noindex
>
  <section class="container errors-head">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/es">Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/es/${lang}`}>{languageMeta?.flag} {languageMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <span>Mis errores</span>
    </nav>
    <span class="emoji" aria-hidden="true">🔴</span>
    <h1>Mis errores</h1>
    <p class="desc" data-errors-desc>Cargando tus errores…</p>
    <div class="topic-filters" data-topic-filters hidden></div>
  </section>

  <section class="container errors-body">
    <div class="card empty-state" data-empty-state hidden>
      <p class="empty-emoji">🎉</p>
      <h2>No tienes errores registrados</h2>
      <p>Cuando falles un ejercicio, aparecerá aquí para que puedas repasarlo.</p>
      <a class="btn btn-primary" href={`/es/${lang}`}>Ver lecciones</a>
    </div>

    <div class="error-list" data-error-list hidden></div>

    <button type="button" class="btn btn-primary practice-errors-btn" data-practice-btn hidden
      >Practicar mis errores</button
    >

    <div data-practice-section hidden>
      <Practice
        quiz={[]}
        exercises={[]}
        dynamic={true}
        sessionType="errors"
        lessonId="errors"
        minutes={1}
        lang={languageMeta?.bcp47}
      />
    </div>
  </section>

  <div hidden data-exercise-manifest={JSON.stringify(exerciseManifest)}></div>
  <div hidden data-topic-manifest={JSON.stringify(topicManifest)}></div>
</BaseLayout>

<script>
  import {
    buildItemFieldset,
    primePracticeCounters,
    type SrsEntry,
  } from '../../../lib/practiceItemMarkup';
  import { read } from '../../../lib/storage';
  import { MASTERY_LABELS } from '../../../lib/srs';

  interface ErrorLogEntry {
    id: string;
    lang: string;
    level: string;
    kind: string;
    date: string;
    userAnswer?: string;
    correctAnswer?: string;
  }

  interface ManifestItem {
    kind: string;
    data: unknown;
  }

  interface GroupedError {
    id: string;
    kind: string;
    count: number;
    lastDate: string;
    lastUserAnswer: string;
    lastCorrectAnswer: string;
    topic: string;
    srsBox: number;
  }

  function readErrorLog(): ErrorLogEntry[] {
    try {
      return JSON.parse(read('polylingua-error-log') ?? '[]');
    } catch {
      return [];
    }
  }

  function readSrsPool(): Record<string, SrsEntry> {
    try {
      return JSON.parse(read('polylingua-srs-pool') ?? '{}');
    } catch {
      return {};
    }
  }

  function readExerciseManifest(): Record<string, ManifestItem[]> {
    const el = document.querySelector<HTMLElement>('[data-exercise-manifest]');
    if (!el) return {};
    try {
      return JSON.parse(el.dataset.exerciseManifest ?? '{}');
    } catch {
      return {};
    }
  }

  function readTopicManifest(): Record<string, string> {
    const el = document.querySelector<HTMLElement>('[data-topic-manifest]');
    if (!el) return {};
    try {
      return JSON.parse(el.dataset.topicManifest ?? '{}');
    } catch {
      return {};
    }
  }

  const KIND_LABELS: Record<string, string> = {
    choice: 'Opción múltiple',
    'fill-blank': 'Completa el hueco',
    match: 'Empareja',
    write: 'Escribe',
    order: 'Ordena',
  };

  function renderTopicFilters(grouped: GroupedError[], selectedTopic: string | null) {
    const container = document.querySelector<HTMLElement>('[data-topic-filters]');
    if (!container) return;

    const counts = new Map<string, number>();
    for (const g of grouped) {
      if (!g.topic) continue;
      counts.set(g.topic, (counts.get(g.topic) ?? 0) + 1);
    }

    if (counts.size < 2) {
      container.hidden = true;
      return;
    }

    container.innerHTML = '';
    container.hidden = false;

    const basePath = window.location.pathname;

    const allChip = document.createElement('a');
    allChip.className = selectedTopic ? 'topic-chip' : 'topic-chip is-active';
    allChip.href = basePath;
    allChip.dataset.astroReload = 'true';
    allChip.textContent = `Todos (${grouped.length})`;
    container.appendChild(allChip);

    const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1]);
    for (const [topic, count] of sorted) {
      const chip = document.createElement('a');
      chip.className = topic === selectedTopic ? 'topic-chip is-active' : 'topic-chip';
      chip.href = `${basePath}?tema=${encodeURIComponent(topic)}`;
      chip.dataset.astroReload = 'true';
      chip.textContent = `${topic} (${count})`;
      container.appendChild(chip);
    }
  }

  function initErrors() {
    const practiceSection = document.querySelector<HTMLElement>('[data-practice-section]');
    const practiceRoot = practiceSection?.querySelector<HTMLElement>(
      '[data-practice][data-session-type="errors"]',
    );
    const container = practiceRoot?.querySelector<HTMLElement>('[data-items-container]');
    const errorList = document.querySelector<HTMLElement>('[data-error-list]');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
    const desc = document.querySelector<HTMLElement>('[data-errors-desc]');
    const practiceBtn = document.querySelector<HTMLButtonElement>('[data-practice-btn]');
    if (!errorList || !practiceRoot || !container) return;
    if (errorList.dataset.built) return;
    errorList.dataset.built = 'true';

    const lang = window.location.pathname.split('/')[2] ?? '';
    const log = readErrorLog().filter((e) => e.lang === lang);
    const srsPool = readSrsPool();
    const topicManifest = readTopicManifest();
    const selectedTopic = new URLSearchParams(window.location.search).get('tema');

    if (log.length === 0) {
      if (emptyState) emptyState.hidden = false;
      errorList.hidden = true;
      if (desc) desc.hidden = true;
      if (practiceBtn) practiceBtn.hidden = true;
      return;
    }

    const groupMap = new Map<string, GroupedError>();
    for (const entry of log) {
      const existing = groupMap.get(entry.id);
      if (existing) {
        existing.count += 1;
        if (entry.date > existing.lastDate) {
          existing.lastDate = entry.date;
          if (entry.userAnswer) existing.lastUserAnswer = entry.userAnswer;
          if (entry.correctAnswer) existing.lastCorrectAnswer = entry.correctAnswer;
        }
      } else {
        const lessonId = entry.id.split('#')[0];
        groupMap.set(entry.id, {
          id: entry.id,
          kind: entry.kind,
          count: 1,
          lastDate: entry.date,
          lastUserAnswer: entry.userAnswer ?? '',
          lastCorrectAnswer: entry.correctAnswer ?? '',
          topic: topicManifest[lessonId] ?? '',
          srsBox: srsPool[entry.id]?.box ?? 0,
        });
      }
    }

    let grouped = [...groupMap.values()].sort((a, b) => b.count - a.count);

    renderTopicFilters(grouped, selectedTopic);

    if (selectedTopic) {
      grouped = grouped.filter((g) => g.topic === selectedTopic);
    }

    if (grouped.length === 0) {
      if (emptyState) emptyState.hidden = false;
      errorList.hidden = true;
      if (desc) desc.hidden = true;
      if (practiceBtn) practiceBtn.hidden = true;
      return;
    }

    if (desc) {
      desc.textContent = `Tienes ${grouped.length} ejercicio${grouped.length === 1 ? '' : 's'} con errores.`;
    }

    errorList.hidden = false;
    errorList.innerHTML = '';

    for (const g of grouped) {
      const card = document.createElement('div');
      card.className = 'error-card card';

      const header = document.createElement('div');
      header.className = 'error-card-header';

      const kindSpan = document.createElement('span');
      kindSpan.className = 'error-kind';
      kindSpan.textContent = KIND_LABELS[g.kind] ?? g.kind;

      const countSpan = document.createElement('span');
      countSpan.className = 'error-count';
      countSpan.textContent = `${g.count}× fallado`;

      header.append(kindSpan, countSpan);
      card.appendChild(header);

      if (g.lastUserAnswer || g.lastCorrectAnswer) {
        const comparison = document.createElement('div');
        comparison.className = 'error-comparison';

        if (g.lastUserAnswer) {
          const userLine = document.createElement('div');
          userLine.className = 'error-user';
          userLine.innerHTML = `<span class="error-label">Tu respuesta:</span> <span class="error-value wrong">${escapeHtml(g.lastUserAnswer)}</span>`;
          comparison.appendChild(userLine);
        }

        if (g.lastCorrectAnswer) {
          const correctLine = document.createElement('div');
          correctLine.className = 'error-correct';
          correctLine.innerHTML = `<span class="error-label">Correcta:</span> <span class="error-value right">${escapeHtml(g.lastCorrectAnswer)}</span>`;
          comparison.appendChild(correctLine);
        }

        card.appendChild(comparison);
      }

      const footer = document.createElement('div');
      footer.className = 'error-card-footer';

      if (g.topic) {
        const topicSpan = document.createElement('span');
        topicSpan.className = 'error-topic';
        topicSpan.textContent = g.topic;
        footer.appendChild(topicSpan);
      }

      const masterySpan = document.createElement('span');
      masterySpan.className = 'error-mastery';
      masterySpan.textContent = MASTERY_LABELS[g.srsBox] ?? `Caja ${g.srsBox}`;
      footer.appendChild(masterySpan);

      const dateSpan = document.createElement('span');
      dateSpan.className = 'error-date';
      dateSpan.textContent = g.lastDate;
      footer.appendChild(dateSpan);

      card.appendChild(footer);
      errorList.appendChild(card);
    }

    if (practiceBtn) {
      practiceBtn.hidden = false;
      practiceBtn.addEventListener('click', () => {
        practiceBtn.hidden = true;
        errorList.hidden = true;
        if (practiceSection) practiceSection.hidden = false;

        const manifest = readExerciseManifest();
        const itemsToAdd = grouped.slice(0, 20);

        itemsToAdd.forEach((g, i) => {
          const srsEntry = srsPool[g.id];
          if (!srsEntry) return;
          const lessonId = g.id.split('#')[0];
          const pool = manifest[lessonId] ?? [];
          const alternatives = pool.filter(
            (item) =>
              item.kind !== srsEntry.kind ||
              JSON.stringify(item.data) !== JSON.stringify(srsEntry.data),
          );
          const chosen =
            alternatives.length > 0
              ? alternatives[Math.floor(Math.random() * alternatives.length)]
              : null;
          const entry: SrsEntry = chosen
            ? { ...srsEntry, kind: chosen.kind, data: chosen.data }
            : srsEntry;
          const fieldset = buildItemFieldset(entry, i);
          container.appendChild(fieldset);
        });

        primePracticeCounters(practiceRoot, itemsToAdd.length);
        document.dispatchEvent(new Event('astro:page-load'));
      });
    }
  }

  function escapeHtml(s: string): string {
    const div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }

  initErrors();
  document.addEventListener('astro:page-load', initErrors);
</script>

<style>
  .errors-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .topic-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .topic-filters :global(.topic-chip) {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .topic-filters :global(.topic-chip:hover) {
    border-color: var(--accent);
    color: var(--text);
  }

  .topic-filters :global(.topic-chip.is-active) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent-text);
  }

  .errors-body {
    max-width: 680px;
    padding-block: 0 4rem;
  }

  .errors-body :global(.error-list) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .errors-body :global(.error-card) {
    padding: 1rem 1.25rem;
  }

  .errors-body :global(.error-card-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .errors-body :global(.error-kind) {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .errors-body :global(.error-count) {
    font-size: 0.78rem;
    font-weight: 700;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .errors-body :global(.error-comparison) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 0.6rem;
    font-size: 0.9rem;
  }

  .errors-body :global(.error-label) {
    font-weight: 600;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .errors-body :global(.error-value.wrong) {
    color: #ef4444;
    text-decoration: line-through;
  }

  .errors-body :global(.error-value.right) {
    color: #22c55e;
    font-weight: 700;
  }

  .errors-body :global(.error-card-footer) {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .errors-body :global(.error-topic) {
    font-weight: 700;
    color: var(--accent-text);
  }

  .errors-body :global(.error-mastery) {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.72rem;
  }

  .practice-errors-btn {
    margin-top: 1.5rem;
    width: 100%;
    font-size: 1rem;
    padding: 0.85rem 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .empty-state :global(.empty-emoji) {
    font-size: 2.5rem;
    margin: 0 0 0.75rem;
  }

  .empty-state h2 {
    margin: 0 0 0.5rem;
  }

  .empty-state p {
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }
</style>
