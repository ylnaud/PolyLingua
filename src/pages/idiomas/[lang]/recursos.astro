---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGUAGES, LANGUAGE_MAP } from '../../../data/languages';
import { RESOURCES, CATEGORY_LABELS, type ResourceItem } from '../../../data/resources';

export async function getStaticPaths() {
  return LANGUAGES.map((language) => ({ params: { lang: language.id } }));
}

const { lang } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];
const items = RESOURCES[lang as keyof typeof RESOURCES] ?? [];

const categories = (Object.keys(CATEGORY_LABELS) as ResourceItem['category'][]).map((category) => ({
  category,
  label: CATEGORY_LABELS[category],
  items: items.filter((item) => item.category === category),
}));
---

<BaseLayout
  title={`Recursos de ${languageMeta?.name} para practicar fuera de la app`}
  description={`Podcasts, series, películas y libros reales para seguir practicando ${languageMeta?.name} fuera de PolyLingua, elegidos por nivel.`}
  path={`/idiomas/${lang}/recursos`}
  noindex
>
  <section class="container resources-head">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/es">Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/es/${lang}`}>{languageMeta?.flag} {languageMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <span>Recursos</span>
    </nav>
    <span class="emoji" aria-hidden="true">📻</span>
    <h1>Recursos de {languageMeta?.name}</h1>
    <p class="desc">
      Aprender de verdad requiere contacto diario con el idioma, no solo lecciones. Estos son
      recursos reales para seguir practicando por tu cuenta.
    </p>
  </section>

  <section class="container resources-body">
    {
      items.length === 0 ? (
        <div class="card empty-state">
          <p class="empty-emoji">🚧</p>
          <h2>Todavía no hay recursos para {languageMeta?.name}</h2>
          <p>Estamos sumando recomendaciones para este idioma — volvé pronto.</p>
        </div>
      ) : (
        categories
          .filter((c) => c.items.length > 0)
          .map((c) => (
            <div class="card resource-group">
              <span class="eyebrow">{c.label}</span>
              <ul class="resource-list">
                {c.items.map((item) => (
                  <li class="resource-item">
                    <span class="resource-title">{item.title}</span>
                    {item.level && <span class="resource-level">{item.level}</span>}
                    <p class="resource-note">{item.note}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
      )
    }
  </section>
</BaseLayout>

<style>
  .resources-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .resources-body {
    max-width: 680px;
    padding-block: 0 4rem;
    display: grid;
    gap: 1.25rem;
  }

  .resource-group {
    padding: 1.5rem;
  }

  .resource-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .resource-item {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .resource-item:first-child {
    padding-top: 0;
    border-top: none;
  }

  .resource-title {
    font-weight: 700;
  }

  .resource-level {
    margin-left: 0.5rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .resource-note {
    color: var(--text-muted);
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
  }
</style>
