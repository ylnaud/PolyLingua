---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Practice from '../../../components/Practice.astro';
import { LANGUAGES, LANGUAGE_MAP } from '../../../data/languages';

export async function getStaticPaths() {
  return LANGUAGES.map((language) => ({ params: { lang: language.id } }));
}

const { lang } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];
---

<BaseLayout
  title={`Repasar ${languageMeta?.name}`}
  description={`Repasa las palabras y ejercicios de ${languageMeta?.name} que fallaste, con repetición espaciada, hasta que los aprendas de verdad.`}
  path={`/idiomas/${lang}/repasar`}
  noindex
>
  <section class="container review-head">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/idiomas">Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/idiomas/${lang}`}>{languageMeta?.flag} {languageMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <span>Repasar</span>
    </nav>
    <span class="emoji" aria-hidden="true">📚</span>
    <h1>Repasar {languageMeta?.name}</h1>
    <p class="desc" data-review-desc>Cargando tu repaso…</p>
  </section>

  <section class="container review-body">
    <div class="card empty-state" data-empty-state hidden>
      <p class="empty-emoji">🎉</p>
      <h2>No te queda nada por repasar hoy</h2>
      <p>Vuelve mañana, o sigue avanzando con lecciones nuevas mientras tanto.</p>
      <a class="btn btn-primary" href={`/idiomas/${lang}`}>Ver lecciones</a>
    </div>

    <Practice quiz={[]} exercises={[]} dynamic={true} sessionType="review" lessonId="review" minutes={1} lang={languageMeta?.bcp47} />
  </section>
</BaseLayout>

<script>
  import { buildItemFieldset, type SrsEntry } from '../../../lib/practiceItemMarkup';

  function today(): string {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  function readPool(): Record<string, SrsEntry> {
    try {
      return JSON.parse(localStorage.getItem('polylingua-srs-pool') ?? '{}');
    } catch {
      return {};
    }
  }

  function initReview() {
    const practiceRoot = document.querySelector<HTMLElement>('[data-practice]');
    const container = document.querySelector<HTMLElement>('[data-items-container]');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
    const desc = document.querySelector<HTMLElement>('[data-review-desc]');
    if (!practiceRoot || !container) return;
    if (practiceRoot.dataset.reviewBuilt) return;
    practiceRoot.dataset.reviewBuilt = 'true';

    const lang = window.location.pathname.split('/')[2] ?? '';
    const pool = readPool();
    const due = Object.values(pool)
      .filter((entry) => entry.lang === lang && entry.due <= today())
      .slice(0, 20);

    if (due.length === 0) {
      if (emptyState) emptyState.hidden = false;
      practiceRoot.hidden = true;
      if (desc) desc.hidden = true;
      return;
    }

    if (desc) {
      desc.textContent = `Tienes ${due.length} ${due.length === 1 ? 'ítem' : 'ítems'} por repasar.`;
    }

    due.forEach((entry, i) => {
      container.appendChild(buildItemFieldset(entry, i));
    });

    const progressEl = practiceRoot.querySelector<HTMLElement>('[data-practice-progress]');
    if (progressEl) progressEl.textContent = `1 / ${due.length}`;
    const scoreText = practiceRoot.querySelector<HTMLElement>('[data-score-text]');
    if (scoreText) scoreText.textContent = `Acertaste 0 / ${due.length}`;
    practiceRoot.dataset.lessonMinutes = String(Math.max(1, Math.round(due.length * 0.5)));

    document.dispatchEvent(new Event('astro:page-load'));
  }

  initReview();
  document.addEventListener('astro:page-load', initReview);
</script>

<style>
  .review-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .breadcrumbs a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .breadcrumbs a:hover {
    color: var(--accent-text);
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .review-body {
    max-width: 680px;
    padding-block: 0 4rem;
  }

  .empty-state {
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .empty-emoji {
    font-size: 2.5rem;
    margin: 0;
  }

  .empty-state .btn {
    margin-top: 1.25rem;
  }
</style>
