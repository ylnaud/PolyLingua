---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Practice from '../../../components/Practice.astro';
import { LANGUAGES, LANGUAGE_MAP } from '../../../data/languages';

export async function getStaticPaths() {
  return LANGUAGES.map((language) => ({ params: { lang: language.id } }));
}

const { lang } = Astro.params;
const languageMeta = LANGUAGE_MAP[lang as keyof typeof LANGUAGE_MAP];
---

<BaseLayout
  title={`Vocabulario de ${languageMeta?.name}`}
  description={`Todas las palabras de ${languageMeta?.name} que aprendiste en tus lecciones, en un solo lugar para verlas y repasarlas.`}
  path={`/idiomas/${lang}/vocabulario`}
  noindex
>
  <section class="container vocab-head">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/idiomas">Idiomas</a>
      <span aria-hidden="true">/</span>
      <a href={`/idiomas/${lang}`}>{languageMeta?.flag} {languageMeta?.name}</a>
      <span aria-hidden="true">/</span>
      <span>Vocabulario</span>
    </nav>
    <span class="emoji" aria-hidden="true">📖</span>
    <h1>Tu vocabulario de {languageMeta?.name}</h1>
    <p class="desc" data-vocab-desc>Cargando tu vocabulario…</p>
  </section>

  <section class="container vocab-body">
    <div class="card empty-state" data-empty-state hidden>
      <p class="empty-emoji">✏️</p>
      <h2>Todavía no aprendiste vocabulario en {languageMeta?.name}</h2>
      <p>Completa una lección para que sus palabras nuevas empiecen a aparecer acá.</p>
      <a class="btn btn-primary" href={`/idiomas/${lang}`}>Ver lecciones</a>
    </div>

    <div class="card word-list-card" data-word-list-card hidden>
      <span class="eyebrow">📚 Palabras aprendidas</span>
      <dl class="word-list" data-word-list></dl>
    </div>

    <div class="review-card" data-review-card hidden>
      <span class="eyebrow">🎯 Ponte a prueba</span>
      <Practice quiz={[]} exercises={[]} dynamic={true} sessionType="vocab" lessonId="vocab" minutes={1} lang={languageMeta?.bcp47} />
    </div>
  </section>
</BaseLayout>

<script>
  import { buildItemFieldset, type SrsEntry } from '../../../lib/practiceItemMarkup';
  import { shuffle } from '../../../lib/shuffle';

  const REVIEW_SIZE = 20;

  interface VocabEntry {
    term: string;
    translation: string;
    lang: string;
    lessonId: string;
    learnedAt: string;
  }

  function readLearned(): Record<string, VocabEntry> {
    try {
      return JSON.parse(localStorage.getItem('polylingua-vocab-learned') ?? '{}');
    } catch {
      return {};
    }
  }

  function initVocabPage() {
    // Igual que repasar.astro: el data-session-type="vocab" solo existe en esta
    // página, así que sirve de guard natural contra el listener de
    // astro:page-load (que queda vivo el resto de la navegación SPA) tocando
    // markup de otra página.
    const desc = document.querySelector<HTMLElement>('[data-vocab-desc]');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
    const wordListCard = document.querySelector<HTMLElement>('[data-word-list-card]');
    const wordList = document.querySelector<HTMLElement>('[data-word-list]');
    const reviewCard = document.querySelector<HTMLElement>('[data-review-card]');
    const practiceRoot = document.querySelector<HTMLElement>('[data-practice][data-session-type="vocab"]');
    if (!desc || !emptyState || !wordListCard || !wordList || !reviewCard || !practiceRoot) return;
    if (practiceRoot.dataset.vocabBuilt) return;
    practiceRoot.dataset.vocabBuilt = 'true';

    const lang = window.location.pathname.split('/')[2] ?? '';
    const learned = Object.values(readLearned())
      .filter((entry) => entry.lang === lang)
      .sort((a, b) => (a.learnedAt < b.learnedAt ? 1 : -1));

    if (learned.length === 0) {
      emptyState.hidden = false;
      desc.hidden = true;
      return;
    }

    desc.textContent = `${learned.length} ${learned.length === 1 ? 'palabra aprendida' : 'palabras aprendidas'}.`;

    wordListCard.hidden = false;
    for (const entry of learned) {
      const dt = document.createElement('dt');
      dt.textContent = entry.term;
      const dd = document.createElement('dd');
      dd.textContent = entry.translation;
      const item = document.createElement('div');
      item.className = 'word-item';
      item.append(dt, dd);
      wordList.appendChild(item);
    }

    reviewCard.hidden = false;
    const container = practiceRoot.querySelector<HTMLElement>('[data-items-container]');
    if (!container) return;

    const items = shuffle(learned).slice(0, REVIEW_SIZE);
    items.forEach((entry, i) => {
      const syntheticEntry: SrsEntry = {
        id: `vocab/${lang}#write-${i}`,
        kind: 'write',
        data: { type: 'write', prompt: `¿Cómo se dice "${entry.translation}"?`, answer: entry.term },
        box: 0,
        due: '',
        lang: 'vocab',
        level: lang,
      };
      container.appendChild(buildItemFieldset(syntheticEntry, i));
    });

    const progressEl = practiceRoot.querySelector<HTMLElement>('[data-practice-progress]');
    if (progressEl) progressEl.textContent = `1 / ${items.length}`;
    const scoreText = practiceRoot.querySelector<HTMLElement>('[data-score-text]');
    if (scoreText) scoreText.textContent = `Acertaste 0 / ${items.length}`;
    practiceRoot.dataset.lessonMinutes = String(Math.max(1, Math.round(items.length * 0.5)));

    document.dispatchEvent(new Event('astro:page-load'));
  }

  initVocabPage();
  document.addEventListener('astro:page-load', initVocabPage);
</script>

<style>
  .vocab-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .breadcrumbs a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .breadcrumbs a:hover {
    color: var(--accent-text);
  }

  .emoji {
    font-size: 2rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0.4rem 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .vocab-body {
    max-width: 680px;
    padding-block: 0 4rem;
  }

  .empty-state {
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .empty-emoji {
    font-size: 2.5rem;
    margin: 0;
  }

  .empty-state .btn {
    margin-top: 1.25rem;
  }

  .word-list-card {
    margin-bottom: 1.75rem;
  }

  .eyebrow {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-text);
    margin-bottom: 0.75rem;
  }

  .word-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    max-height: 420px;
    overflow-y: auto;
  }

  .word-list :global(.word-item) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .word-list :global(dt) {
    font-weight: 700;
  }

  .word-list :global(dd) {
    margin: 0;
    color: var(--text-muted);
  }

  .word-list :global(dd::before) {
    content: '— ';
  }
</style>
