---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageCard from '../components/LanguageCard.astro';
import { LANGUAGES } from '../data/languages';
import { getCollection } from 'astro:content';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { parseLessonId } from '../lib/lessonPath';
import { getTargetLangsFor } from '../lib/courses';

const defaultUserLang = ACTIVE_USER_LANGUAGES[0].id;

// Los idiomas que se pueden estudiar DESDE esta interfaz, no los 6 del
// catálogo: nadie estudia su propio idioma, así que no existe el curso es-es.
// Listarlo igual daba una tarjeta con 0 lecciones enlazando a /es/es, que no
// se genera — un 404 en la portada.
const catalogLanguages = LANGUAGES.filter((l) => getTargetLangsFor(defaultUserLang).includes(l.id));
const lessons = (await getCollection('lessons')).filter(
  (l) => parseLessonId(l.id).userLang === defaultUserLang,
);
const lessonCounts = Object.fromEntries(
  LANGUAGES.map((l) => [l.id, lessons.filter((les) => les.data.language === l.id).length]),
);

const siteURL = Astro.site!.origin;
const defaultUserLangHref = `/${defaultUserLang}`;

const faqs = [
  {
    q: '¿PolyLingua es realmente gratis?',
    a: 'Sí. Todo el contenido está disponible gratis mientras construimos la comunidad. En el futuro podríamos añadir funciones premium opcionales, pero el curso base seguirá siendo accesible.',
  },
  {
    q: '¿Puedo aprender más de un idioma a la vez?',
    a: 'Claro. Cada idioma tiene su propia ruta independiente de A1 a C2, así que puedes avanzar en alemán y en francés al mismo tiempo si quieres, sin que se mezclen.',
  },
  {
    q: '¿Necesito conocimientos previos para empezar?',
    a: 'No. El nivel A1 de cada idioma empieza desde cero: lo básico, pronunciación y las primeras frases del día a día.',
  },
  {
    q: '¿Cómo está organizado el contenido?',
    a: 'Seguimos el Marco Común Europeo de Referencia (MCER): A1, A2, B1, B2, C1 y C2, con lecciones cortas de gramática explicada de forma visual y quizzes interactivos para practicar al instante.',
  },
  {
    q: '¿Puedo usar PolyLingua sin conexión a internet?',
    a: 'Sí. PolyLingua se puede instalar como aplicación desde el navegador (el botón "Instalar app") y funciona incluso con conexión limitada gracias a su diseño ultra ligero.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      name: 'Cursos de idiomas gratis — PolyLingua',
      description:
        'Aprende alemán, inglés, francés, italiano o portugués gratis de A1 a C2, con gramática gamificada, quizzes interactivos y explicaciones que no aburren.',
      itemListElement: catalogLanguages.map((lang, i) => ({
        '@type': 'Course',
        position: i + 1,
        name: `${lang.name} — PolyLingua`,
        description: lang.description,
        inLanguage: lang.id,
        provider: {
          '@type': 'Organization',
          name: 'PolyLingua',
          sameAs: 'https://github.com/ylnaud/polylingua',
        },
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
    {
      '@type': 'WebSite',
      name: 'PolyLingua',
      url: siteURL,
      inLanguage: 'es',
    },
  ],
};
---

<BaseLayout
  title="Aprender idiomas gratis online | PolyLingua"
  description="5 idiomas, A1 a C2, 100% gratis y sin registro. Gramática con trucos fáciles de recordar, ejercicios interactivos y funciona sin internet."
  structuredData={structuredData}
>
  <section class="hero texture-noise">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">🌐 5 idiomas · Gratis · MCER A1–C2</span>
        <h1>Aprende idiomas de verdad, sin morir de aburrimiento en la gramática.</h1>
        <p class="hero-lede">
          PolyLingua convierte cada regla gramatical en un mini-juego: mnemotecnias, quizzes
          interactivos y ejemplos reales, desde tu primera palabra hasta matices que solo dominan
          los nativos. Alemán, inglés, francés, italiano y portugués, en un solo lugar.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={defaultUserLangHref}>Elegir idioma →</a>
          <a class="btn btn-ghost" href="/es/de">Empezar con alemán</a>
        </div>
        <p class="hero-note">100% gratis · sin registro · funciona en cualquier dispositivo</p>
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-num" data-count-to={LANGUAGES.length}>{LANGUAGES.length}</span>
            <span class="hero-stat-label">idiomas</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-num" data-count-to={lessons.length}>{lessons.length}</span>
            <span class="hero-stat-label">lecciones</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-num" data-count-to={6}>6</span>
            <span class="hero-stat-label">niveles MCER</span>
          </div>
        </div>
      </div>
      <div class="hero-card card" aria-hidden="true">
        <p class="hero-card-label">Vista previa de una lección</p>
        <p class="hero-card-q">¿Cuál es el artículo correcto para "Tisch"?</p>
        <div class="hero-card-options">
          <span class="opt correct">der Tisch ✓</span>
          <span class="opt">die Tisch</span>
          <span class="opt">das Tisch</span>
        </div>
      </div>
    </div>
  </section>

  <section class="languages container" id="idiomas">
    <div class="section-head">
      <h2>Elige tu idioma</h2>
      <p>
        Cinco idiomas, seis niveles cada uno. Avanza a tu ritmo desde tu primera palabra hasta la
        maestría.
      </p>
    </div>
    <div class="languages-grid">
      {
        catalogLanguages.map((language) => (
          <LanguageCard
            language={language}
            lessonCount={lessonCounts[language.id] ?? 0}
            basePath={defaultUserLangHref}
          />
        ))
      }
    </div>
  </section>

  <section class="why container" id="por-que">
    <div class="section-head">
      <h2>¿Por qué PolyLingua y no otra app?</h2>
    </div>
    <div class="why-grid">
      <div class="card why-item">
        <span class="why-emoji">🎮</span>
        <h3>Gramática gamificada</h3>
        <p>
          Cada regla viene con una mnemotecnia visual y un quiz interactivo — aprendes haciendo, no
          memorizando tablas aburridas.
        </p>
      </div>
      <div class="card why-item">
        <span class="why-emoji">⚡</span>
        <h3>Ultra ligera</h3>
        <p>
          Construida para cargar al instante, sin JavaScript innecesario. Aprende idiomas, no
          esperes a que cargue una app.
        </p>
      </div>
      <div class="card why-item">
        <span class="why-emoji">🗺️</span>
        <h3>Ruta clara MCER</h3>
        <p>
          De A1 a C2 en cada idioma, siguiendo el estándar europeo, para que sepas exactamente en
          qué nivel estás y qué sigue.
        </p>
      </div>
      <div class="card why-item">
        <span class="why-emoji">🌍</span>
        <h3>Gratis y de código abierto</h3>
        <p>
          Todo el curso es gratis mientras crecemos juntos. El código está abierto en GitHub para
          quien quiera contribuir.
        </p>
      </div>
    </div>
  </section>

  <section class="faq container" id="faq">
    <div class="section-head">
      <h2>Preguntas frecuentes</h2>
    </div>
    <div class="faq-list">
      {
        faqs.map((item) => (
          <details class="card faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="final-cta container">
    <div class="card final-cta-card texture-noise">
      <h2>Tu primera lección te espera</h2>
      <p>Sin registros, sin tarjetas de crédito. Solo tú, el idioma que elijas y cinco minutos.</p>
      <a class="btn btn-primary" href={defaultUserLangHref}>Elegir idioma y empezar →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 3.5rem 4rem;
    background: radial-gradient(
      circle at 20% 0%,
      color-mix(in srgb, var(--accent) 8%, transparent),
      transparent 55%
    );
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3rem;
    align-items: center;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.75rem 0 1rem;
  }

  .hero-lede {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    margin: 1.5rem 0 0.75rem;
    flex-wrap: wrap;
  }

  .hero-note {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .hero-stats {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero-stat-num {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent-text);
    line-height: 1;
  }

  .hero-stat-label {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .hero-card {
    padding: 1.75rem;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
    transform-style: preserve-3d;
  }

  .hero-card:hover,
  .hero-card:focus-within {
    transform: perspective(1000px) rotateX(-6deg) rotateY(6deg);
    box-shadow: var(--shadow-card-hover);
  }

  .hero-card-label {
    color: var(--text-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.75rem;
    font-weight: 700;
  }

  .hero-card-q {
    font-weight: 700;
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  .hero-card-options {
    display: grid;
    gap: 0.6rem;
  }

  .opt {
    padding: 0.7rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    font-size: 0.95rem;
  }

  .opt.correct {
    border-color: #2f9e6e;
    background: rgba(47, 158, 110, 0.15);
    color: #4fd493;
    font-weight: 700;
  }

  .section-head {
    text-align: center;
    max-width: 46ch;
    margin: 0 auto 2.25rem;
  }

  .section-head h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin: 0 0 0.5rem;
  }

  .section-head p {
    color: var(--text-muted);
    margin: 0;
  }

  .languages {
    padding-block: 2rem;
  }

  .languages-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .why {
    padding-block: 3rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .why-item {
    padding: 1.5rem;
  }

  .why-emoji {
    font-size: 1.75rem;
  }

  .why-item h3 {
    margin: 0.6rem 0 0.4rem;
    font-size: 1.05rem;
  }

  .why-item p {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.92rem;
  }

  .faq {
    padding-block: 3rem;
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
    max-width: 720px;
    margin-inline: auto;
  }

  .faq-item {
    padding: 1.1rem 1.4rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .faq-item p {
    color: var(--text-muted);
    margin: 0.75rem 0 0;
  }

  .final-cta {
    padding-block: 2rem 4rem;
  }

  .final-cta-card {
    text-align: center;
    padding: 3rem 2rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 10%, transparent),
      transparent
    );
  }

  .final-cta-card h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .final-cta-card p {
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .languages-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .languages-grid,
    .why-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-stats {
      gap: 1.1rem;
    }

    .hero-stat-num {
      font-size: 1.35rem;
    }
  }
</style>

<script>
  // Cuenta ascendente de 0 al valor real (idiomas/lecciones/niveles) al
  // entrar en viewport — usa datos ya calculados server-side en el
  // frontmatter (data-count-to), sin fetch ni librerías.
  //
  // El HTML ya trae el número REAL escrito, no un 0: la animación lo pisa
  // desde el primer frame, así que no se ve distinto, pero quien no ejecute
  // JS —un rastreador que no renderice, un navegador con JS bloqueado— lee el
  // dato correcto. Antes leía «0 idiomas, 0 lecciones, 0 niveles MCER», que es
  // lo contrario de lo que la portada quiere decir.
  //
  // Guard por
  // dataset.initialized + astro:page-load, mismo patrón que
  // BottomNav.astro/ProgressTracker.astro para sobrevivir la navegación SPA.
  function initHeroStats() {
    const nums = document.querySelectorAll<HTMLElement>('.hero-stat-num');
    if (nums.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const animate = (el: HTMLElement) => {
      if (el.dataset.animated) return;
      el.dataset.animated = 'true';
      const target = Number(el.dataset.countTo ?? '0');

      if (prefersReducedMotion || target === 0) {
        el.textContent = String(target);
        return;
      }

      const duration = 800;
      const start = performance.now();

      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = String(Math.round(target * eased));
        if (progress < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    };

    if (!('IntersectionObserver' in window)) {
      nums.forEach(animate);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          animate(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );

    nums.forEach((el) => observer.observe(el));
  }

  initHeroStats();
  document.addEventListener('astro:page-load', initHeroStats);
</script>
