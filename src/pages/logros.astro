---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
import { LEVELS } from '../data/levels';
import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';
import { parseLessonId } from '../lib/lessonPath';

interface Badge {
  id: string;
  emoji: string;
  name: string;
  hint: string;
}

const coreBadges: Badge[] = [
  {
    id: 'first-lesson',
    emoji: '🎯',
    name: 'Primera lección',
    hint: 'Completa tu primera lección.',
  },
  { id: 'streak-3', emoji: '🔥', name: 'Racha de 3 días', hint: 'Practica 3 días seguidos.' },
  { id: 'streak-7', emoji: '🔥', name: 'Racha de 7 días', hint: 'Practica 7 días seguidos.' },
  { id: 'streak-30', emoji: '🔥', name: 'Racha de 30 días', hint: 'Practica 30 días seguidos.' },
  {
    id: 'perfect',
    emoji: '💯',
    name: 'Perfeccionista',
    hint: 'Acierta todos los ítems de una lección.',
  },
  { id: 'marathon', emoji: '⚡', name: 'Maratón', hint: 'Completa 3 lecciones en un mismo día.' },
  {
    id: 'srs-master',
    emoji: '🧠',
    name: 'Maestro del repaso',
    hint: 'Domina 5 ítems en el repaso espaciado.',
  },
  {
    id: 'combo',
    emoji: '💥',
    name: 'Racha de combo',
    hint: 'Encadena 5 respuestas correctas seguidas en una misma sesión.',
  },
  {
    id: 'practice-libre',
    emoji: '🎲',
    name: 'Explorador libre',
    hint: 'Completa 5 sesiones de práctica libre.',
  },
  {
    id: 'hangman-10',
    emoji: '🔤',
    name: 'Diez ahorcados ganados',
    hint: 'Gana 10 partidas de ahorcado.',
  },
  {
    id: 'levels-1',
    emoji: '🏆',
    name: 'Primer nivel superado',
    hint: 'Aprueba tu primer examen de nivel.',
  },
  {
    id: 'levels-5',
    emoji: '🏆',
    name: '5 niveles superados',
    hint: 'Aprueba 5 exámenes de nivel.',
  },
  {
    id: 'levels-15',
    emoji: '🏆',
    name: '15 niveles superados',
    hint: 'Aprueba 15 exámenes de nivel.',
  },
];

const courseBadges: Badge[] = LANGUAGES.map((language) => ({
  id: `course-${language.id}`,
  emoji: language.flag,
  name: `Curso de ${language.name} completo`,
  hint: `Aprueba los 6 niveles de ${language.name}.`,
}));

const allBadges = [...coreBadges, ...courseBadges];
const levelIds = LEVELS.map((l) => l.id);
const languageIds = LANGUAGES.map((l) => l.id);

// Manifest lección→tema gramatical, todos los idiomas (esta página no está
// scopeada a un [lang] como vocabulario.astro), para poder mostrar el
// nombre real del tema junto a cada entrada del pool de repetición
// espaciada — l.id ya es "{lang}/{level}/{slug}", el mismo prefijo que
// llevan los ids del pool antes del "#{kind}-{index}".
const allLessons = await getCollection('lessons');
const topicManifest = Object.fromEntries(allLessons.map((l) => [l.id, l.data.grammarTopic]));

// Total de lecciones por idioma, para el panel "Tu progreso por idioma" —
// mismo cálculo que usa index.astro para las tarjetas de idioma en la home,
// scopeado al userLang activo (con más de un userLang enseñando el mismo
// idioma objetivo, contar sin filtrar duplicaría el total).
const defaultUserLang = ACTIVE_USER_LANGUAGES[0].id;
const lessonCounts = Object.fromEntries(
  LANGUAGES.map((l) => [
    l.id,
    allLessons.filter(
      (les) => les.data.language === l.id && parseLessonId(les.id).userLang === defaultUserLang,
    ).length,
  ]),
);
---

<BaseLayout
  title="Mis logros"
  description="Tus insignias de progreso en PolyLingua: rachas, niveles superados, cursos completos y más."
  path="/logros"
  noindex
>
  <section class="container achievements-head">
    <h1>🏆 Mis logros</h1>
    <p class="desc" data-progress-summary>Cargando tu progreso…</p>
  </section>

  <section class="container lang-progress-head">
    <div class="lang-progress-grid" data-lang-progress-grid></div>
  </section>

  <div hidden data-lesson-counts={JSON.stringify(lessonCounts)}></div>

  <section class="container pending-head">
    <div class="card empty-state" data-pending-empty hidden>
      <p class="empty-emoji">🎉</p>
      <h2>No tenés temas pendientes</h2>
      <p>Cuando falles un ejercicio, el tema va a aparecer acá para que lo repases con contexto.</p>
    </div>

    <div class="card pending-card" data-pending-card hidden>
      <span class="eyebrow">🎯 Tus temas pendientes</span>
      <div class="pending-list" data-pending-list></div>
    </div>
  </section>

  <section class="container sprint-head">
    <div class="card sprint-card" data-sprint-card hidden>
      <span class="eyebrow">🏃 Sprint activo</span>
      <p class="sprint-topic" data-sprint-topic></p>
      <div class="sprint-days" data-sprint-days aria-hidden="true"></div>
      <p class="sprint-status" data-sprint-status></p>
      <div class="sprint-actions">
        <a class="btn btn-primary" data-sprint-go href={`/${defaultUserLang}/repasar`}
          >Ir a repasar este tema</a
        >
        <button type="button" class="btn btn-ghost" data-sprint-end>Terminar sprint</button>
      </div>
    </div>
  </section>

  <div hidden data-topic-manifest={JSON.stringify(topicManifest)}></div>

  <section class="container badges-grid">
    {
      allBadges.map((badge) => (
        <div class="badge-item card locked" data-badge={badge.id}>
          <span class="badge-emoji" aria-hidden="true">
            {badge.emoji}
          </span>
          <h2>{badge.name}</h2>
          <p>{badge.hint}</p>
          <span class="badge-status" data-badge-status>
            🔒 Bloqueado
          </span>
        </div>
      ))
    }
  </section>

  <section class="container backup-head" id="backup">
    <div class="card backup-card">
      <span class="eyebrow">💾 Copia de seguridad</span>
      <p class="backup-desc">
        Tu progreso vive solo en este navegador. Exportalo para no perderlo si cambiás de
        dispositivo, reinstalás la app o borrás el caché.
      </p>
      <div class="backup-actions">
        <button type="button" class="btn btn-ghost" data-export-progress
          >⬇️ Exportar progreso</button
        >
        <button type="button" class="btn btn-ghost" data-import-progress
          >⬆️ Importar progreso</button
        >
        <input type="file" accept="application/json" hidden data-import-input />
      </div>
      <p class="backup-status" data-backup-status role="status" aria-live="polite"></p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ levelIds, languageIds }}>
  function read(key) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function hasAnyKeyStartingWith(prefix) {
    try {
      return Object.keys(localStorage).some((k) => k.startsWith(prefix));
    } catch {
      return false;
    }
  }

  function countKeysStartingWith(prefix) {
    try {
      return Object.keys(localStorage).filter((k) => k.startsWith(prefix)).length;
    } catch {
      return 0;
    }
  }

  // Sin envolver en initX()+astro:page-load, este código solo corría una
  // vez por carga completa — bajo navegación sin recarga (Astro
  // <ClientRouter />) revisitar /logros en la misma sesión SPA dejaría las
  // insignias congeladas en el estado de la primera visita. No hace falta
  // ningún guard: no registra listeners persistentes, solo lee localStorage
  // y vuelve a pintar el DOM, así que reejecutarlo en cada navegación es
  // exactamente lo que se quiere.
  function initLogros() {
    const streak = Number(read('polylingua-streak-count') ?? '0');
    const streakMax = Math.max(Number(read('polylingua-streak-max') ?? '0'), streak);
    const srsMastered = Number(read('polylingua-srs-mastered-count') ?? '0');
    const levelsPassed = countKeysStartingWith('polylingua-level-passed-');
    const hasFirstLesson = hasAnyKeyStartingWith('polylingua-lesson-done-');
    const hasPerfect = hasAnyKeyStartingWith('polylingua-lesson-perfect-');
    const hasMarathon = read('polylingua-achievement-marathon') === 'true';
    const hasCombo = read('polylingua-achievement-combo') === 'true';
    const hasPracticeLibre = read('polylingua-achievement-practice-libre') === 'true';
    const hangmanWins = Number(read('polylingua-hangman-wins') ?? '0');

    const earned = {
      'first-lesson': hasFirstLesson,
      'streak-3': streakMax >= 3,
      'streak-7': streakMax >= 7,
      'streak-30': streakMax >= 30,
      perfect: hasPerfect,
      marathon: hasMarathon,
      combo: hasCombo,
      'practice-libre': hasPracticeLibre,
      'hangman-10': hangmanWins >= 10,
      'srs-master': srsMastered >= 5,
      'levels-1': levelsPassed >= 1,
      'levels-5': levelsPassed >= 5,
      'levels-15': levelsPassed >= 15,
    };

    languageIds.forEach((lang) => {
      earned[`course-${lang}`] = levelIds.every(
        (level) => read(`polylingua-level-passed-${lang}-${level}`) === 'true',
      );
    });

    document.querySelectorAll('[data-badge]').forEach((el) => {
      el.classList.add('locked');
      const status = el.querySelector('[data-badge-status]');
      if (status) status.textContent = '🔒 Bloqueado';
      const id = el.getAttribute('data-badge');
      if (id && earned[id]) {
        el.classList.remove('locked');
        if (status) status.textContent = '✅ Conseguido';
      }
    });

    const summary = document.querySelector('[data-progress-summary]');
    if (summary) {
      const earnedCount = Object.values(earned).filter(Boolean).length;
      summary.textContent = `Tienes ${earnedCount} de ${Object.keys(earned).length} logros, una racha de ${streak} día${streak === 1 ? '' : 's'}, y ${levelsPassed} nivel${levelsPassed === 1 ? '' : 'es'} superado${levelsPassed === 1 ? '' : 's'}.`;
    }
  }

  initLogros();
  document.addEventListener('astro:page-load', initLogros);
</script>

<script>
  import { exportAll } from '../lib/storage';
  import { LANGUAGES } from '../data/languages';
  import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';

  // /logros vive en la raíz (es progreso global, no de un curso), así que sus
  // enlaces al silo usan el idioma de interfaz principal.
  const defaultUserLang = ACTIVE_USER_LANGUAGES[0].id;

  function initLanguageProgress() {
    const grid = document.querySelector<HTMLElement>('[data-lang-progress-grid]');
    const countsEl = document.querySelector<HTMLElement>('[data-lesson-counts]');
    if (!grid || !countsEl) return;

    let lessonCounts: Record<string, number> = {};
    try {
      lessonCounts = JSON.parse(countsEl.dataset.lessonCounts ?? '{}');
    } catch {
      /* manifest inválido, se trata como vacío */
    }

    const all = exportAll();
    let vocabLearned: Record<string, { lang: string }> = {};
    try {
      vocabLearned = JSON.parse(all['polylingua-vocab-learned'] ?? '{}');
    } catch {
      /* dato corrupto, se trata como vacío */
    }

    grid.innerHTML = '';
    for (const lang of LANGUAGES) {
      const lessonsDone = Object.keys(all).filter((k) =>
        k.startsWith(`polylingua-lesson-done-${lang.id}-`),
      ).length;
      const levelsPassed = Object.keys(all).filter((k) =>
        k.startsWith(`polylingua-level-passed-${lang.id}-`),
      ).length;
      const wordsLearned = Object.values(vocabLearned).filter((v) => v.lang === lang.id).length;

      const card = document.createElement('a');
      card.className = 'lang-progress-card';
      card.href = `/${defaultUserLang}/${lang.id}`;

      const head = document.createElement('span');
      head.className = 'lang-progress-head-row';
      const flag = document.createElement('span');
      flag.setAttribute('aria-hidden', 'true');
      flag.textContent = lang.flag;
      const name = document.createElement('span');
      name.className = 'lang-progress-name';
      name.textContent = lang.name;
      head.append(flag, name);

      const stats = document.createElement('span');
      stats.className = 'lang-progress-stats';
      stats.textContent = `${lessonsDone}/${lessonCounts[lang.id] ?? 0} lecciones · ${levelsPassed}/6 niveles · ${wordsLearned} palabras`;

      card.append(head, stats);
      grid.appendChild(card);
    }
  }

  initLanguageProgress();
  document.addEventListener('astro:page-load', initLanguageProgress);
</script>

<script>
  import {
    read,
    today,
    getActiveSprint,
    startSprint,
    clearSprint,
    SPRINT_LENGTH_DAYS,
  } from '../lib/storage';
  import { ACTIVE_USER_LANGUAGES } from '../data/userLanguages';

  // /logros vive en la raíz (es progreso global, no de un curso), así que sus
  // enlaces a las herramientas del silo usan el idioma de interfaz principal.
  const defaultUserLang = ACTIVE_USER_LANGUAGES[0].id;

  interface SrsEntry {
    id: string;
    kind: string;
    data: unknown;
    box: number;
    due: string;
    lang: string;
    level: string;
    firstFailedAt?: string;
  }

  const LEVEL_LABELS: Record<string, string> = {
    a1: 'A1',
    a2: 'A2',
    b1: 'B1',
    b2: 'B2',
    c1: 'C1',
    c2: 'C2',
  };
  const MAX_TOPICS = 5;

  function readPool(): Record<string, SrsEntry> {
    try {
      return JSON.parse(read('polylingua-srs-pool') ?? '{}');
    } catch {
      return {};
    }
  }

  function initPendingTopics() {
    const emptyState = document.querySelector<HTMLElement>('[data-pending-empty]');
    const card = document.querySelector<HTMLElement>('[data-pending-card]');
    const list = document.querySelector<HTMLElement>('[data-pending-list]');
    const manifestEl = document.querySelector<HTMLElement>('[data-topic-manifest]');
    if (!emptyState || !card || !list || !manifestEl) return;

    let manifest: Record<string, string> = {};
    try {
      manifest = JSON.parse(manifestEl.dataset.topicManifest ?? '{}');
    } catch {
      /* manifest inválido, se trata como vacío */
    }

    const pool = readPool();
    const byLesson: Record<
      string,
      { lang: string; level: string; count: number; earliest: string }
    > = {};
    for (const entry of Object.values(pool)) {
      const lessonId = entry.id.split('#')[0];
      const seenAt = entry.firstFailedAt ?? entry.due;
      const existing = byLesson[lessonId];
      if (existing) {
        existing.count += 1;
        if (seenAt < existing.earliest) existing.earliest = seenAt;
      } else {
        byLesson[lessonId] = { lang: entry.lang, level: entry.level, count: 1, earliest: seenAt };
      }
    }

    const todayStr = today();
    const rows = Object.entries(byLesson)
      .map(([lessonId, info]) => ({
        lessonId,
        topic: manifest[lessonId] ?? lessonId,
        ...info,
        days: Math.max(
          0,
          Math.floor((Date.parse(todayStr) - Date.parse(info.earliest)) / 86400000),
        ),
      }))
      .sort((a, b) => b.days - a.days)
      .slice(0, MAX_TOPICS);

    list.innerHTML = '';
    if (rows.length === 0) {
      emptyState.hidden = false;
      card.hidden = true;
      return;
    }
    emptyState.hidden = true;
    card.hidden = false;

    for (const row of rows) {
      const item = document.createElement('div');
      item.className = 'pending-item';

      const a = document.createElement('a');
      a.className = 'pending-link';
      a.href = `/${defaultUserLang}/${row.lang}/repasar?tema=${encodeURIComponent(row.topic)}`;
      a.dataset.astroReload = 'true';

      const info = document.createElement('span');
      info.className = 'pending-info';
      const topic = document.createElement('span');
      topic.className = 'pending-topic';
      topic.textContent = `${LEVEL_LABELS[row.level] ?? row.level.toUpperCase()} · ${row.topic}`;
      const meta = document.createElement('span');
      meta.className = 'pending-meta';
      meta.textContent = `${row.count} ítem${row.count === 1 ? '' : 's'} · ${
        row.days === 0
          ? 'fallando desde hoy'
          : `fallando hace ${row.days} día${row.days === 1 ? '' : 's'}`
      }`;
      info.append(topic, meta);

      const arrow = document.createElement('span');
      arrow.className = 'pending-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';

      a.append(info, arrow);

      const sprintBtn = document.createElement('button');
      sprintBtn.type = 'button';
      sprintBtn.className = 'pending-sprint-btn';
      sprintBtn.title = `Iniciar un sprint de ${SPRINT_LENGTH_DAYS} días en este tema`;
      sprintBtn.setAttribute('aria-label', `Iniciar sprint de ${row.topic}`);
      sprintBtn.textContent = '🏃';
      sprintBtn.addEventListener('click', () => {
        startSprint(row.lang, row.topic, row.lessonId);
        renderSprintCard();
        sprintCardEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      item.append(a, sprintBtn);
      list.appendChild(item);
    }
  }

  // El sprint es, en esencia, "repasá este tema en N días distintos" — reusa
  // el filtro por tema de /[userLang]/[targetLang]/repasar (ver ?tema= más arriba),
  // solo cuenta en qué fechas se visitó. Vive en el mismo script que el
  // panel de temas pendientes porque el botón "Iniciar sprint" de cada fila
  // necesita poder refrescar esta tarjeta al instante.
  let sprintCardEl: HTMLElement | null = null;

  function renderSprintCard() {
    const card = document.querySelector<HTMLElement>('[data-sprint-card]');
    const topicEl = document.querySelector<HTMLElement>('[data-sprint-topic]');
    const daysEl = document.querySelector<HTMLElement>('[data-sprint-days]');
    const statusEl = document.querySelector<HTMLElement>('[data-sprint-status]');
    const goLink = document.querySelector<HTMLAnchorElement>('[data-sprint-go]');
    if (!card || !topicEl || !daysEl || !statusEl || !goLink) return;
    sprintCardEl = card;

    const sprint = getActiveSprint();
    if (!sprint) {
      card.hidden = true;
      return;
    }
    card.hidden = false;
    topicEl.textContent = sprint.topic;

    daysEl.innerHTML = '';
    for (let i = 0; i < SPRINT_LENGTH_DAYS; i++) {
      const dot = document.createElement('span');
      dot.className = i < sprint.days.length ? 'sprint-dot is-done' : 'sprint-dot';
      daysEl.appendChild(dot);
    }

    const done = sprint.days.length;
    statusEl.textContent =
      done >= SPRINT_LENGTH_DAYS
        ? `¡Sprint completado! Practicaste ${done} de ${SPRINT_LENGTH_DAYS} días.`
        : `Practicaste ${done} de ${SPRINT_LENGTH_DAYS} días.`;
    goLink.href = `/${defaultUserLang}/${sprint.lang}/repasar?tema=${encodeURIComponent(sprint.topic)}`;
  }

  function initSprintCard() {
    const endBtn = document.querySelector<HTMLButtonElement>('[data-sprint-end]');
    if (!endBtn) return;
    if (!endBtn.dataset.initialized) {
      endBtn.dataset.initialized = 'true';
      endBtn.addEventListener('click', () => {
        clearSprint();
        renderSprintCard();
      });
    }
    renderSprintCard();
  }

  initPendingTopics();
  initSprintCard();
  document.addEventListener('astro:page-load', () => {
    initPendingTopics();
    initSprintCard();
  });
</script>

<script>
  import { exportAll, importAll, today, write } from '../lib/storage';

  function initBackup() {
    const exportBtn = document.querySelector<HTMLButtonElement>('[data-export-progress]');
    const importBtn = document.querySelector<HTMLButtonElement>('[data-import-progress]');
    const importInput = document.querySelector<HTMLInputElement>('[data-import-input]');
    const status = document.querySelector<HTMLElement>('[data-backup-status]');
    if (!exportBtn || !importBtn || !importInput || !status) return;
    if (exportBtn.dataset.initialized) return;
    exportBtn.dataset.initialized = 'true';

    exportBtn.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(exportAll(), null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `polylingua-progreso-${today()}.json`;
      a.click();
      URL.revokeObjectURL(url);
      write('polylingua-backup-exported-at', today());
      status.textContent = '✅ Progreso exportado.';
    });

    importBtn.addEventListener('click', () => importInput.click());

    importInput.addEventListener('change', async () => {
      const file = importInput.files?.[0];
      importInput.value = '';
      if (!file) return;
      try {
        const parsed: unknown = JSON.parse(await file.text());
        if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
          throw new Error('formato inválido');
        }
        if (
          !window.confirm('Esto va a reemplazar tu progreso actual con el importado. ¿Continuar?')
        )
          return;
        importAll(parsed as Record<string, unknown>);
        status.textContent = '✅ Progreso importado. Recargando…';
        window.setTimeout(() => window.location.reload(), 600);
      } catch {
        status.textContent = '❌ El archivo no es un backup válido de PolyLingua.';
      }
    });
  }

  initBackup();
  document.addEventListener('astro:page-load', initBackup);
</script>

<style>
  .achievements-head {
    padding-block: 2.5rem 1.5rem;
    max-width: 680px;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0;
  }

  .lang-progress-head {
    max-width: 680px;
    padding-block: 0 1.5rem;
  }

  .lang-progress-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
  }

  /* Las tarjetas se crean con document.createElement en JS a partir de
     localStorage — nunca reciben el atributo de scoping de Astro, así que
     hace falta :global() para que este CSS las alcance (mismo patrón que
     .pending-list más abajo). */
  .lang-progress-grid :global(.lang-progress-card) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease;
  }

  .lang-progress-grid :global(.lang-progress-card:hover) {
    border-color: var(--accent);
  }

  .lang-progress-grid :global(.lang-progress-head-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
  }

  .lang-progress-grid :global(.lang-progress-name) {
    font-weight: 700;
  }

  .lang-progress-grid :global(.lang-progress-stats) {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .pending-head {
    max-width: 680px;
    padding-block: 0 1.5rem;
  }

  .pending-card {
