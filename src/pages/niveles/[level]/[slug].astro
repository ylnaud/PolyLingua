---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => data.language === 'de');
  return lessons.map((lesson) => {
    const [, level, slug] = lesson.id.split('/');
    return { params: { level, slug } };
  });
}

const { level, slug } = Astro.params;
return Astro.redirect(`/idiomas/de/${level}/${slug}`, 301);
---
