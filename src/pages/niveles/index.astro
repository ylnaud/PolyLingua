---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LevelCard from '../../components/LevelCard.astro';
import { LEVELS } from '../../data/levels';
import { getCollection } from 'astro:content';

const lessons = await getCollection('lessons');
const lessonCounts = Object.fromEntries(
  LEVELS.map((l) => [l.id, lessons.filter((les) => les.data.level === l.id).length])
);
---

<BaseLayout
  title="Niveles de alemán A1 a C2"
  description="Explora los seis niveles de alemán del MCER: A1, A2, B1, B2, C1 y C2. Elige el tuyo y empieza a aprender gratis con lecciones gamificadas."
  path="/niveles"
>
  <section class="container page-head">
    <span class="eyebrow">Ruta de aprendizaje</span>
    <h1>Seis niveles, un solo idioma</h1>
    <p>
      Seguimos el Marco Común Europeo de Referencia (MCER). Empieza donde estés y avanza a
      tu propio ritmo — sin exámenes, sin presión, solo práctica constante.
    </p>
  </section>

  <section class="container levels-grid">
    {LEVELS.map((level) => (
      <LevelCard level={level} lessonCount={lessonCounts[level.id] ?? 0} />
    ))}
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: 3rem 2rem;
    max-width: 640px;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0.6rem 0 0.75rem;
  }

  .page-head p {
    color: var(--text-muted);
  }

  .levels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding-block: 1rem 4rem;
  }

  @media (max-width: 900px) {
    .levels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .levels-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
