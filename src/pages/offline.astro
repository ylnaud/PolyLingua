---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sin conexión"
  description="Estás sin conexión. Las páginas que ya visitaste siguen disponibles."
  path="/offline"
  noindex
>
  <section class="container offline-page">
    <span class="offline-icon" aria-hidden="true">📡</span>
    <h1>Sin conexión</h1>
    <p class="offline-desc">
      No hay conexión a internet. Las lecciones y páginas que ya visitaste siguen disponibles — tu
      progreso se guarda en este dispositivo.
    </p>
    <div class="offline-actions">
      <a class="btn btn-primary" href="/">Ir al inicio</a>
      <a class="btn btn-ghost" href="/idiomas">Mis idiomas</a>
      <a class="btn btn-ghost" href="/repasar">Repasar</a>
    </div>
    <p class="offline-tip">
      Consejo: visita las lecciones mientras tengas conexión para que queden disponibles sin
      internet.
    </p>
  </section>
</BaseLayout>

<style>
  .offline-page {
    max-width: 480px;
    text-align: center;
    padding-block: 4rem 6rem;
  }

  .offline-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 1.6rem;
    margin: 0 0 0.75rem;
  }

  .offline-desc {
    color: var(--text-muted);
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }

  .offline-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .offline-tip {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }
</style>
