---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
---

<BaseLayout
  title="Práctica libre"
  description="Practica con una sesión aleatoria de preguntas y ejercicios de todas tus lecciones, distinta cada vez."
  path="/practica-libre"
  noindex
>
  <section class="container picker">
    <h1>¿Qué idioma quieres practicar?</h1>
    <p class="desc">Elige un idioma para una sesión de práctica libre.</p>
    <div class="lang-grid">
      {
        LANGUAGES.map((language) => (
          <a class="lang-item card" href={`/idiomas/${language.id}/practica-libre`}>
            <span class="flag" aria-hidden="true">
              {language.flag}
            </span>
            <span>{language.name}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { mostRecentLangWithPrefix } from '../lib/storage';

  const latestLang = mostRecentLangWithPrefix('polylingua-lesson-done-');
  if (latestLang) {
    window.location.replace(`/idiomas/${latestLang}/practica-libre`);
  }
</script>
