---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
---

<BaseLayout
  title="Escuchar y repetir"
  description="Escuchá palabras en alemán, inglés, francés, italiano o portugués con voz nativa y repetilas en voz alta para practicar tu pronunciación."
  path="/pronunciacion"
  noindex
>
  <section class="container picker">
    <h1>¿En qué idioma quieres practicar?</h1>
    <p class="desc">Elige un idioma para escuchar palabras y repetirlas en voz alta.</p>
    <div class="lang-grid">
      {
        LANGUAGES.map((language) => (
          <a class="lang-item card" href={`/idiomas/${language.id}/pronunciacion`}>
            <span class="flag" aria-hidden="true">
              {language.flag}
            </span>
            <span>{language.name}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { mostRecentLangWithPrefix } from '../lib/storage';

  const latestLang = mostRecentLangWithPrefix('polylingua-lesson-done-');
  if (latestLang) {
    window.location.replace(`/idiomas/${latestLang}/pronunciacion`);
  }
</script>
