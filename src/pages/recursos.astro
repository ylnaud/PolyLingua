---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
---

<BaseLayout
  title="Recursos para practicar fuera de la app"
  description="Podcasts, series, películas y libros reales recomendados para practicar alemán, inglés, francés, italiano o portugués fuera de PolyLingua."
  path="/recursos"
  noindex
>
  <section class="container picker">
    <h1>¿En qué idioma quieres ver recursos?</h1>
    <p class="desc">
      Podcasts, series, películas y libros para seguir practicando fuera de la app.
    </p>
    <div class="lang-grid">
      {
        LANGUAGES.map((language) => (
          <a class="lang-item card" href={`/idiomas/${language.id}/recursos`}>
            <span class="flag" aria-hidden="true">
              {language.flag}
            </span>
            <span>{language.name}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
