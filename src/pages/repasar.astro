---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
---

<BaseLayout
  title="Repasar"
  description="Repasa las palabras y ejercicios que fallaste, con repetición espaciada, hasta que los aprendas de verdad."
  path="/repasar"
  noindex
>
  <section class="container picker">
    <h1>¿Qué idioma quieres repasar?</h1>
    <p class="desc">Elige un idioma para ver tu repaso pendiente.</p>
    <div class="lang-grid">
      {
        LANGUAGES.map((language) => (
          <a
            class="lang-item card card-glow"
            href={`/idiomas/${language.id}/repasar`}
            style={`--accent-c: ${language.color}`}
          >
            <span class="flag" aria-hidden="true">
              {language.flag}
            </span>
            <span class="underline-draw">{language.name}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { mostRecentLangWithPrefix } from '../lib/storage';

  const latestLang = mostRecentLangWithPrefix('polylingua-lesson-done-');
  if (latestLang) {
    window.location.replace(`/idiomas/${latestLang}/repasar`);
  }
</script>
