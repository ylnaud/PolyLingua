---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
---

<BaseLayout
  title="Situaciones cotidianas"
  description="Aprendé idiomas por situaciones reales — trabajo, casa, compras — con las frases que de verdad se usan todos los días."
  path="/situaciones"
  noindex
>
  <section class="container picker">
    <h1>¿En qué idioma quieres practicar situaciones?</h1>
    <p class="desc">Elige un idioma para aprender con frases reales, no con reglas sueltas.</p>
    <div class="lang-grid">
      {LANGUAGES.map((language) => (
        <a class="lang-item card" href={`/idiomas/${language.id}/situaciones`}>
          <span class="flag" aria-hidden="true">{language.flag}</span>
          <span>{language.name}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { mostRecentLangWithPrefix } from '../lib/storage';

  const latestLang = mostRecentLangWithPrefix('polylingua-lesson-done-');
  if (latestLang) {
    window.location.replace(`/idiomas/${latestLang}/situaciones`);
  }
</script>
