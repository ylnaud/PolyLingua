---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
---

<BaseLayout
  title="Vocabulario"
  description="Todas las palabras nuevas que aprendiste en tus lecciones, en un solo lugar para verlas y repasarlas."
  path="/vocabulario"
  noindex
>
  <section class="container picker">
    <h1>¿Vocabulario de qué idioma quieres ver?</h1>
    <p class="desc">Elige un idioma para ver las palabras que ya aprendiste.</p>
    <div class="lang-grid">
      {LANGUAGES.map((language) => (
        <a class="lang-item card" href={`/idiomas/${language.id}/vocabulario`}>
          <span class="flag" aria-hidden="true">{language.flag}</span>
          <span>{language.name}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  interface VocabEntry {
    term: string;
    translation: string;
    lang: string;
    lessonId: string;
    learnedAt: string;
  }

  let latestLang = '';
  let latestDate = '';
  try {
    const learned: Record<string, VocabEntry> = JSON.parse(
      localStorage.getItem('polylingua-vocab-learned') ?? '{}'
    );
    for (const entry of Object.values(learned)) {
      if (entry.learnedAt > latestDate) {
        latestDate = entry.learnedAt;
        latestLang = entry.lang;
      }
    }
  } catch {
    /* localStorage unavailable */
  }
  if (latestLang) {
    window.location.replace(`/idiomas/${latestLang}/vocabulario`);
  }
</script>

<style>
  .picker {
    padding-block: 2.5rem 4rem;
    max-width: 680px;
  }

  h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0 0 0.6rem;
  }

  .desc {
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  .lang-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
  }

  .lang-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    transition: transform 0.15s ease;
  }

  .lang-item:hover {
    transform: translateY(-2px);
  }

  .flag {
    font-size: 1.5rem;
  }
</style>
