---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGUAGES } from '../data/languages';
---

<BaseLayout
  title="Vocabulario"
  description="Todas las palabras nuevas que aprendiste en tus lecciones, en un solo lugar para verlas y repasarlas."
  path="/vocabulario"
  noindex
>
  <section class="container picker">
    <h1>¿Vocabulario de qué idioma quieres ver?</h1>
    <p class="desc">Elige un idioma para ver las palabras que ya aprendiste.</p>
    <div class="lang-grid">
      {
        LANGUAGES.map((language) => (
          <a
            class="lang-item card card-glow"
            href={`/idiomas/${language.id}/vocabulario`}
            style={`--accent-c: ${language.color}`}
          >
            <span class="flag" aria-hidden="true">
              {language.flag}
            </span>
            <span class="underline-draw">{language.name}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
